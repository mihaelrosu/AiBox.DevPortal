@page "/coder"
@rendermode InteractiveServer
<PageTitle>Local Coder</PageTitle>
<RadzenText Text="Local Coder" TextStyle="TextStyle.H4" />
<RadzenTabs>
    <Tabs>
        <RadzenTabsItem Text="Work">
            <RadzenStack Gap="1rem">
                <CoderProjectSelector ProjectPath="@request.ProjectPath"
                                      ProjectPathChanged="@OnProjectPathChanged"
                                      WorkspaceRoots="@workspaceRoots"
                                      IsLoading="@isLoading"
                                      OnRefresh="@LoadAsync">
                    <CoderPromptPanel Models="@models"
                                      Model="@request.Model"
                                      ModelChanged="@(value => request.Model = value)"
                                      Task="@request.Task"
                                      TaskChanged="@(value => request.Task = value)"
                                      IsLoading="@isLoading"
                                      IsPlanning="@isPlanning"
                                      IsGeneratingPatch="@isGeneratingPatch"
                                      CanVerifyProject="@(!isRunningCommand && !isVerifying && !string.IsNullOrWhiteSpace(request.ProjectPath))"
                                      CanReviewDiff="@CanReviewSelectedPatch()"
                                      OnCreatePlan="@CreatePlanAsync"
                                      OnGeneratePatchPreview="@GeneratePatchPreviewAsync"
                                      OnVerifyProject="@VerifyProjectAsync"
                                      OnReviewDiff="@ReviewSelectedPatchAsync">
                        <ContextContent>
                            <RadzenCard>
                                <RadzenStack Gap="0.75rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                                 JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                                        <div>
                                            <RadzenText Text="File Context" TextStyle="TextStyle.H5" />
                                            <RadzenText Text="@GetProjectFilesStatusText()" TextStyle="TextStyle.Body2" />
                                        </div>
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                            <RadzenButton Text="Preview Context" Icon="description" ButtonStyle="ButtonStyle.Primary"
                                                          Click="@PreviewContextAsync"
                                                          Disabled="@(isLoading || string.IsNullOrWhiteSpace(request.ProjectPath) || !selectedFilePaths.Any())" />
                                            <RadzenButton Text="Clear Selected" Icon="remove_circle_outline"
                                                          ButtonStyle="ButtonStyle.Light" Click="@ClearSelectedFilesAsync"
                                                          Disabled="@(isLoading || !selectedFilePaths.Any())" />
                                            <RadzenButton Text="Clear Context" Icon="clear" ButtonStyle="ButtonStyle.Light"
                                                          Click="@ClearContextAsync" Disabled="@(isLoading || fileContexts.Count == 0)" />
                                        </RadzenStack>
                                    </RadzenStack>
                                    <RadzenText Text="@($"Loaded context files: {fileContexts.Count}")" TextStyle="TextStyle.Body2" />
                                    <FileAutoComplete RootDirectory="@request.ProjectPath"
                                                      Placeholder="Search by relative path or file name, e.g. Coder.razor, service, Program.cs"
                                                      ShowSelectedInfo="true" SelectedFiles="@selectedFiles"
                                                      SelectedFilesChanged="@OnSelectedFilesChanged" FileSelected="@OnFileSelected" />
                                </RadzenStack>
                            </RadzenCard>
                        </ContextContent>
                    </CoderPromptPanel>
                </CoderProjectSelector>

                @if (currentTask is not null)
                {
                    <RadzenCard>
                        <RadzenText Text="Plan" TextStyle="TextStyle.H5" />
                        <pre class="coder-output">@currentTask.Plan</pre>
                    </RadzenCard>
                }

                @if (fileContexts.Count > 0)
                {
                    <RadzenCard>
                        <RadzenText Text="Loaded File Context" TextStyle="TextStyle.H5" />
                        @foreach (var fileContext in fileContexts)
                        {
                            <details style="margin-bottom: 0.75rem;">
                                <summary>@fileContext.RelativePath (@fileContext.CharacterCount chars)</summary>
                                <pre class="coder-output">@fileContext.Content</pre>
                            </details>
                        }
                    </RadzenCard>
                }
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Agent Mode Profiles">
            <RadzenStack Gap="1rem">
                <CoderAgentProfilesPanel ProfileRows="@GetProfileRows()" />
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Patch Preview">
            <RadzenStack Gap="1rem">
                <CoderDiffViewer Error="@error"
                                 ValidationErrors="@LastPatchValidationErrors"
                                 RawResponse="@LastPatchRawResponse"
                                 NormalizedDiff="@LastPatchNormalizedDiff"
                                 PatchPreview="@patchPreview"
                                 ApplyResult="@applyResult"
                                 RollbackResult="@rollbackResult"
                                 CanApplyPatch="@CanApplyPatchPreview()"
                                 CanRollbackPatch="@CanRollbackPatch()"
                                 IsRollingBack="@isRollingBack"
                                 OnApplyPatch="@ApplyPatchAsync"
                                 OnRollbackPatch="@RollbackPatchAsync" />
                <CoderPatchQueuePanel PatchPackages="@patchPackages"
                                      SelectedPatchPackage="@selectedPatchPackage"
                                      CanReview="@CanReviewSelectedPatch()"
                                      CanApprove="@CanApproveSelectedPatch()"
                                      CanApply="@CanApplySelectedPatch()"
                                      CanVerify="@CanVerifySelectedPatch()"
                                      CanRollback="@CanRollbackSelectedPatch()"
                                      OnPatchSelected="@OnPatchPackageSelected"
                                      OnReview="@ReviewSelectedPatchAsync"
                                      OnApprove="@ApproveSelectedPatchAsync"
                                      OnApply="@ApplySelectedPatchAsync"
                                      OnVerify="@VerifySelectedPatchAsync"
                                      OnRollback="@RollbackSelectedPatchAsync" />
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Verify & Output">
            <RadzenStack Gap="1rem">
                <CoderExecutionPanel IsRunningCommand="@isRunningCommand"
                                     CanVerifyProject="@(!isRunningCommand && !isVerifying && !string.IsNullOrWhiteSpace(request.ProjectPath))"
                                     CanCommitChanges="@CanCommitChanges()"
                                     CanBuildDeploy="@CanBuildDeploy()"
                                     CommitMessage="@commitMessage"
                                     CommitMessageChanged="@(value => commitMessage = value)"
                                     CommitResults="@commitResults"
                                     BuildDeployResults="@buildDeployResults"
                                     VerifyResults="@verifyResults"
                                     LastCommand="@lastCommand"
                                     OnRunCommand="@RunCommandAsync"
                                     OnVerifyProject="@VerifyProjectAsync"
                                     OnCommitChanges="@CommitChangesAsync"
                                     OnBuildDeploy="@BuildDeployAsync" />
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="History">
            <RadzenStack Gap="1rem">
                <CoderHistoryPanel ShowAgentRunHistory="true"
                                   AgentRunHistory="@agentRunHistory"
                                   SelectedAgentRun="@selectedAgentRun"
                                   OnAgentRunSelected="@OnAgentRunSelected" />
                <CoderHistoryPanel ShowTaskHistory="true"
                                   HistoryEntries="@historyEntries"
                                   SelectedHistoryEntry="@selectedHistoryEntry"
                                   IsLoadingHistory="@isLoadingHistory"
                                   IsClearingHistory="@isClearingHistory"
                                   OnClearHistory="@ClearHistoryAsync"
                                   OnViewHistoryEntry="@ViewHistoryEntryAsync"
                                   OnUseHistoryEntryAsContext="@UseHistoryEntryAsContextAsync" />
            </RadzenStack>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {
    #region Injected services

    [Inject] private ICoderConsoleService CoderConsoleService { get; set; } = default!;
    [Inject] private IAgentModeRunner AgentModeRunner { get; set; } = default!;
    [Inject] private IAgentModeProfileService AgentModeProfiles { get; set; } = default!;
    [Inject] private IAgentRunHistoryService AgentRunHistoryService { get; set; } = default!;
    [Inject] private IPatchPackageService PatchPackageService { get; set; } = default!;
    [Inject] private IPatchApplyService PatchApplyService { get; set; } = default!;
    [Inject] private IPatchRollbackService PatchRollbackService { get; set; } = default!;
    [Inject] private AiBox.DevPortal.Services.ILocalCoderHistoryService LocalCoderHistoryService { get; set; } = default!;
    [Inject] private Radzen.DialogService DialogService { get; set; } = default!;
    [Inject] private Radzen.NotificationService NotificationService { get; set; } = default!;

    #endregion

    #region Page state

    private readonly LocalCoderRequest request = new();

    private IReadOnlyList<string> workspaceRoots = [];
    private IReadOnlyList<string> models = [];
    private IReadOnlyList<CommandRunResult> verifyResults = [];
    private IReadOnlyList<CommandRunResult> commitResults = [];
    private IReadOnlyList<CommandRunResult> buildDeployResults = [];
    private IReadOnlyList<AgentModeProfile> agentModeProfiles = [];
    private IReadOnlyList<AgentRunRecord> agentRunHistory = [];
    private IReadOnlyList<PatchPackage> patchPackages = [];
    private IReadOnlyList<LocalCoderHistoryEntry> historyEntries = [];
    private List<LocalCoderFileContext> fileContexts = [];
    private List<string> selectedFilePaths = [];
    private List<FileSearchItem> selectedFiles = [];

    private AiBox.DevPortal.Models.LocalCoderTask? currentTask;
    private LocalCoderPatchPreview? patchPreview;
    private LocalCoderPatchApplyResult? applyResult;
    private LocalCoderPatchRollbackResult? rollbackResult;
    private CommandRunResult? lastCommand;
    private LocalCoderHistoryEntry? selectedHistoryEntry;
    private AgentRunRecord? selectedAgentRun;
    private PatchPackage? selectedPatchPackage;
    private string commitMessage = string.Empty;
    private string LastPatchRawResponse { get; set; } = string.Empty;
    private string LastPatchNormalizedDiff { get; set; } = string.Empty;
    private IReadOnlyList<string> LastPatchValidationErrors { get; set; } = [];

    private bool isLoading;
    private bool isPlanning;
    private bool isGeneratingPatch;
    private bool isApplyingPatch;
    private bool isRollingBack;
    private bool isRunningCommand;
    private bool isVerifying;
    private bool isCommitRunning;
    private bool isBuildDeployRunning;
    private bool isLoadingHistory;
    private bool isClearingHistory;

    private string? error;

    #endregion

    #region Lifecycle methods

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            workspaceRoots = await CoderConsoleService.GetWorkspaceRootsAsync();
            models = await CoderConsoleService.GetOllamaModelsAsync();

            if (string.IsNullOrWhiteSpace(request.ProjectPath))
            {
                request.ProjectPath = workspaceRoots.FirstOrDefault(IsDevPortalProjectRoot)
                    ?? workspaceRoots.FirstOrDefault()
                    ?? string.Empty;
            }

            if (string.IsNullOrWhiteSpace(request.Model) || !models.Contains(request.Model, StringComparer.OrdinalIgnoreCase))
            {
                request.Model = models.Contains("qwen2.5-coder:7b", StringComparer.OrdinalIgnoreCase)
                    ? "qwen2.5-coder:7b"
                    : models.FirstOrDefault() ?? request.Model;
            }

            agentModeProfiles = await AgentModeProfiles.GetAllAsync();
            await LoadAgentRunHistoryAsync();
            await LoadPatchQueueAsync();
            await LoadHistoryAsync();
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static bool IsDevPortalProjectRoot(string path)
    {
        return !string.IsNullOrWhiteSpace(path) &&
               File.Exists(Path.Combine(path, "AiBox.DevPortal.csproj"));
    }

    #endregion

    #region Project actions

    private Task OnProjectPathChanged(object? value)
    {
        request.ProjectPath = value?.ToString() ?? string.Empty;
        ClearSelectedFiles();
        currentTask = null;
        patchPreview = null;
        ClearPatchDebug();
        lastCommand = null;
        verifyResults = [];
        commitResults = [];
        buildDeployResults = [];
        rollbackResult = null;
        selectedHistoryEntry = null;
        selectedAgentRun = null;
        selectedPatchPackage = null;

        error = null;
        return Task.CompletedTask;
    }

    private async Task PreviewContextAsync()
    {
        error = null;

        try
        {
            if (!await EnsureFileContextLoadedAsync())
            {
                return;
            }
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Preview context failed",
                exception.Message);
        }
    }

    private Task ClearSelectedFilesAsync()
    {
        ClearSelectedFiles();

        NotificationService.Notify(
            NotificationSeverity.Info,
            "Selected files cleared",
            "The file selection list was cleared.");

        return Task.CompletedTask;
    }

    private Task ClearContextAsync()
    {
        ClearLoadedContext();

        NotificationService.Notify(
            NotificationSeverity.Info,
            "Context cleared",
            "Loaded file context was cleared.");

        return Task.CompletedTask;
    }

    private void ClearSelectedFiles()
    {
        selectedFilePaths = [];
        selectedFiles = [];
        ClearLoadedContext();
        patchPreview = null;
        ClearPatchDebug();
    }

    private void ClearLoadedContext()
    {
        fileContexts = [];
        request.FileContexts = [];
        patchPreview = null;
        applyResult = null;
        rollbackResult = null;
        ClearPatchDebug();
    }

    #endregion

    #region Agent actions

    private async Task CreatePlanAsync()
    {
        isPlanning = true;
        error = null;
        currentTask = null;
        lastCommand = null;

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForCreatePlan());
            if (!await EnsureFileContextLoadedAsync())
            {
                await SaveHistoryEntryAsync(
                    LocalCoderHistoryActionType.CreatePlan,
                    success: false,
                    "Select files before creating a plan.");
                return;
            }

            currentTask = await AgentModeRunner.CreatePlanAsync(request, profile);
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.CreatePlan,
                success: true,
                "Plan created.",
                planText: currentTask!.Plan,
                model: profile.Model);

            NotificationService.Notify(
                NotificationSeverity.Success,
                "Plan created",
                $"Local coder generated a plan with {request.FileContexts.Count} file context(s).");
        }
        catch (Exception exception)
        {
            error = exception.Message;
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.CreatePlan,
                success: false,
                exception.Message);

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Local coder failed",
                exception.Message);
        }
        finally
        {
            isPlanning = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private async Task GeneratePatchPreviewAsync()
    {
        isGeneratingPatch = true;
        error = null;
        currentTask = null;
        patchPreview = null;
        applyResult = null;
        rollbackResult = null;
        ClearPatchDebug();

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForGeneratePatchPreview());
            if (!await EnsureFileContextLoadedAsync())
            {
                await SaveHistoryEntryAsync(
                    LocalCoderHistoryActionType.GeneratePatchPreview,
                    success: false,
                    "Select files before generating a patch preview.");
                return;
            }

            patchPreview = await AgentModeRunner.GeneratePatchPreviewAsync(request, profile);
            ClearPatchDebug();
            try
            {
                selectedPatchPackage = await PatchPackageService.CreateFromPreviewAsync(patchPreview!, request.Task);
                await LoadPatchQueueAsync();
            }
            catch (Exception packageException)
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Patch queue save failed",
                    packageException.Message);
            }
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.GeneratePatchPreview,
                success: true,
                "Patch preview created.",
                patchPreviewText: patchPreview!.PatchText,
                model: profile.Model);
            NotificationService.Notify(
                NotificationSeverity.Success,
                "Patch preview created",
                "Local coder generated a patch preview for the selected context.");
        }
        catch (PatchPreviewValidationException exception)
        {
            error = exception.Message;
            LastPatchRawResponse = exception.RawModelResponse;
            LastPatchNormalizedDiff = exception.NormalizedDiff;
            LastPatchValidationErrors = exception.ValidationErrors.ToArray();

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.GeneratePatchPreview,
                success: false,
                exception.Message);

            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Patch preview rejected",
                exception.Message);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
            ClearPatchDebug();
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.GeneratePatchPreview,
                success: false,
                exception.Message);

            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Patch preview rejected",
                exception.Message);
        }
        catch (Exception exception)
        {
            error = exception.Message;
            ClearPatchDebug();
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.GeneratePatchPreview,
                success: false,
                exception.Message);

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Patch preview failed",
                exception.Message);
        }
        finally
        {
            isGeneratingPatch = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private void ClearPatchDebug()
    {
        LastPatchRawResponse = string.Empty;
        LastPatchNormalizedDiff = string.Empty;
        LastPatchValidationErrors = [];
    }

    #endregion

    #region Patch actions

    private async Task ApplyPatchAsync()
    {
        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForApplyPatch());
            NotificationService.Notify(
                NotificationSeverity.Info,
                "Apply Patch clicked",
                "Starting patch apply...");
            StateHasChanged();
            Console.WriteLine("Apply Patch clicked. Starting patch apply...");
            if (!CanApplyPatchPreview() || patchPreview is null)
            {
                throw new InvalidOperationException("Generate and review an applicable patch preview before applying it.");
            }
            Console.WriteLine("APPLY STEP 1: handler reached.");
            var confirmed = await DialogService.Confirm(
                "Apply this patch to selected files? Backups will be created first.",
                "Apply Patch",
                new ConfirmOptions { OkButtonText = "Apply Patch", CancelButtonText = "Cancel" });

            if (confirmed != true)
            {
                return;
            }

            isApplyingPatch = true;
            error = null;
            applyResult = null;
            rollbackResult = null;

            Console.WriteLine("APPLY STEP 2: calling ApplyPatchPreviewAsync.");

            applyResult = await AgentModeRunner.ApplyPatchPreviewAsync(patchPreview, profile);
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.ApplyPatch,
                success: applyResult.Applied && applyResult.VerificationPassed,
                applyResult.Message,
                applyResult: applyResult,
                model: profile.Model);

            Console.WriteLine("APPLY STEP 3: service returned.");
            Console.WriteLine($"APPLIED: {applyResult.Applied}");
            Console.WriteLine($"VERIFICATION PASSED: {applyResult.VerificationPassed}");
            Console.WriteLine($"MESSAGE: {applyResult.Message}");

            Console.WriteLine($"GIT APPLY EXIT: {applyResult.GitApplyResult?.ExitCode}");
            Console.WriteLine($"GIT APPLY COMMAND: {applyResult.GitApplyResult?.Command}");
            Console.WriteLine($"GIT APPLY STDOUT: {applyResult.GitApplyResult?.Output}");
            Console.WriteLine($"GIT APPLY STDERR: {applyResult.GitApplyResult?.Error}");

            Console.WriteLine($"GIT DIFF STAT EXIT: {applyResult.GitDiffStatResult?.ExitCode}");
            Console.WriteLine($"GIT DIFF STAT STDOUT: {applyResult.GitDiffStatResult?.Output}");
            Console.WriteLine($"GIT DIFF STAT STDERR: {applyResult.GitDiffStatResult?.Error}");

            Console.WriteLine($"CHANGED FILES DIFF EXIT: {applyResult.ChangedFilesDiffResult?.ExitCode}");
            Console.WriteLine($"CHANGED FILES DIFF STDOUT: {applyResult.ChangedFilesDiffResult?.Output}");
            Console.WriteLine($"CHANGED FILES DIFF STDERR: {applyResult.ChangedFilesDiffResult?.Error}");
            if (applyResult.Applied && applyResult.VerificationPassed)
            {
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Patch applied",
                    applyResult.Message);
            }
            else
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    applyResult.Applied ? "Verification failed" : "Patch apply failed",
                    applyResult.Message);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("APPLY STEP 3: handler reached.");
            error = ex.Message;
            var failedAt = DateTimeOffset.UtcNow;
            applyResult = new LocalCoderPatchApplyResult
            {
                Applied = false,
                VerificationPassed = false,
                Message = ex.ToString(),
                GitApplyResult = new CommandRunResult
                {
                    Command = "git apply --whitespace=fix <patchfile> (not completed)",
                    ExitCode = -1,
                    Error = ex.ToString(),
                    Started = failedAt,
                    Finished = failedAt
                }
            };

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.ApplyPatch,
                success: false,
                ex.Message,
                applyResult: applyResult);

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Patch apply failed",
                ex.Message);
        }
        finally
        {
            isApplyingPatch = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private bool CanApplyPatchPreview()
    {
        return !isApplyingPatch &&
               patchPreview is not null &&
               !patchPreview.PatchText.Contains("PATCH_NOT_POSSIBLE", StringComparison.Ordinal);
    }

    private bool CanRollbackPatch()
    {
        return applyResult is not null &&
               applyResult.BackupFiles.Count > 0 &&
               !isRollingBack;
    }

    private async Task RollbackPatchAsync()
    {
        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForRollbackPatch());
            var confirmed = await DialogService.Confirm(
                "Restore files from backup and undo this patch?",
                "Rollback Patch",
                new ConfirmOptions { OkButtonText = "Rollback Patch", CancelButtonText = "Cancel" });

            if (confirmed != true || applyResult is null)
            {
                return;
            }

            isRollingBack = true;
            error = null;
            rollbackResult = null;

            rollbackResult = await AgentModeRunner.RollbackPatchAsync(applyResult, request.ProjectPath, profile);
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.RollbackPatch,
                success: rollbackResult.RolledBack && rollbackResult.VerificationPassed,
                rollbackResult.Message,
                applyResult: applyResult,
                rollbackResult: rollbackResult,
                model: profile.Model);

            if (rollbackResult.RolledBack && rollbackResult.VerificationPassed)
            {
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Rollback completed",
                    rollbackResult.Message);
            }
            else
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Rollback completed with issues",
                    rollbackResult.Message);
            }
        }
        catch (Exception exception)
        {
            error = exception.Message;
            rollbackResult = new LocalCoderPatchRollbackResult
            {
                RolledBack = false,
                VerificationPassed = false,
                Message = exception.ToString(),
                RestoredFiles = [],
                VerificationResults = []
            };

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.RollbackPatch,
                success: false,
                exception.Message,
                applyResult: applyResult,
                rollbackResult: rollbackResult);

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Rollback failed",
                exception.Message);
        }
        finally
        {
            isRollingBack = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    #endregion

    #region Verification actions

    private async Task RunCommandAsync(string command)
    {
        isRunningCommand = true;
        error = null;

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForRunCommand());
            lastCommand = await AgentModeRunner.RunCommandAsync(
                request.ProjectPath,
                command,
                profile);

            var severity = lastCommand.ExitCode == 0
                ? NotificationSeverity.Success
                : NotificationSeverity.Warning;

            NotificationService.Notify(
                severity,
                "Command finished",
                $"{command}: exit {lastCommand.ExitCode}");
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Command failed",
                exception.Message);
        }
        finally
        {
            isRunningCommand = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private async Task VerifyProjectAsync()
    {
        isVerifying = true;
        error = null;
        verifyResults = [];

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForVerifyProject());
            verifyResults = await AgentModeRunner.VerifyProjectAsync(request.ProjectPath, profile);

            var failed = verifyResults.FirstOrDefault(x => x.ExitCode != 0);

            if (failed is null)
            {
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Verification passed",
                    "git status, dotnet build, and dotnet test completed.");
            }
            else
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Verification failed",
                    $"{failed.Command}: exit {failed.ExitCode}");
            }

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.VerifyProject,
                success: failed is null,
                failed is null ? "Verification passed." : $"{failed.Command}: exit {failed.ExitCode}",
                verificationResults: verifyResults,
                model: profile.Model);
        }
        catch (Exception exception)
        {
            error = exception.Message;
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.VerifyProject,
                success: false,
                exception.Message,
                verificationResults: verifyResults);

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Verification failed",
                exception.Message);
        }
        finally
        {
            isVerifying = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private bool CanCommitChanges()
    {
        return !isRunningCommand &&
               !isVerifying &&
               !isCommitRunning &&
               !string.IsNullOrWhiteSpace(request.ProjectPath);
    }

    private bool CanBuildDeploy()
    {
        return !isRunningCommand &&
               !isVerifying &&
               !isBuildDeployRunning &&
               !string.IsNullOrWhiteSpace(request.ProjectPath);
    }

    private async Task CommitChangesAsync()
    {
        isCommitRunning = true;
        error = null;
        commitResults = [];

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForCommitChanges());
            var results = await AgentModeRunner.CommitChangesAsync(
                request.ProjectPath,
                commitMessage.Trim(),
                profile);

            commitResults = results;

            var statusResult = results.FirstOrDefault(result => result.Command == "git status --short");
            var noChanges = statusResult is not null &&
                            statusResult.ExitCode == 0 &&
                            string.IsNullOrEmpty(statusResult.Output);
            var failed = results.FirstOrDefault(result => result.ExitCode != 0);
            var success = !noChanges && failed is null;

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.CommitChanges,
                success: success,
                noChanges
                    ? "No changes to commit."
                    : success ? "Commit and deploy completed." : "Commit or deploy failed.",
                verificationResults: results,
                model: profile.Model);

            if (noChanges)
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "No changes to commit",
                    "No changes to commit.");
                return;
            }

            if (failed is null)
            {
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Commit and deploy completed",
                    "Commit and deploy completed.");
            }
            else
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Commit or deploy failed",
                    $"{failed.Command}: exit {failed.ExitCode}");
            }
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Commit failed",
                exception.Message);
        }
        finally
        {
            isCommitRunning = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private async Task BuildDeployAsync()
    {
        isBuildDeployRunning = true;
        error = null;
        buildDeployResults = [];

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForBuildDeploy());
            var results = await AgentModeRunner.BuildDeployAsync(request.ProjectPath, profile);

            buildDeployResults = results;

            var success = results.Count > 0 && results.All(result => result.ExitCode == 0);

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.BuildDeploy,
                success: success,
                success ? "Build and deploy completed." : "Build or deploy failed.",
                verificationResults: results,
                model: profile.Model);

            var failed = results.FirstOrDefault(result => result.ExitCode != 0);
            if (failed is null)
            {
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Build and deploy completed",
                    "dotnet build and docker compose completed successfully.");
            }
            else
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Build or deploy failed",
                    $"{failed.Command}: exit {failed.ExitCode}");
            }
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Build and deploy failed",
                exception.Message);
        }
        finally
        {
            isBuildDeployRunning = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    #endregion

    #region Project actions

    private Task OnSelectedFilesChanged(IReadOnlyList<FileSearchItem> files)
    {
        selectedFiles = files.ToList();
        selectedFilePaths = selectedFiles
            .Select(file => file.RelativePath)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        ClearLoadedContext();
        error = null;
        return Task.CompletedTask;
    }

    private Task OnFileSelected(FileSearchItem? file)
    {
        if (file is not null && !selectedFilePaths.Contains(file.RelativePath, StringComparer.OrdinalIgnoreCase))
        {
            selectedFilePaths.Add(file.RelativePath);
            ClearLoadedContext();
        }

        return Task.CompletedTask;
    }

    private async Task<bool> EnsureFileContextLoadedAsync()
    {
        if (fileContexts.Count > 0)
        {
            request.FileContexts = fileContexts.ToList();
            return true;
        }

        if (selectedFilePaths.Count == 0)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "No files selected",
                "Select files before creating a plan or patch preview.");

            return false;
        }

        fileContexts = (await CoderConsoleService.ReadFileContextsAsync(
                request.ProjectPath,
                selectedFilePaths.ToArray()))
            .ToList();

        request.FileContexts = fileContexts.ToList();

        NotificationService.Notify(
            NotificationSeverity.Info,
            "Context auto-loaded",
            $"{fileContexts.Count} file(s) loaded into context.");

        return true;
    }

    private string GetProjectFilesStatusText()
    {
        if (string.IsNullOrWhiteSpace(request.ProjectPath))
        {
            return "Select a project path to search for files.";
        }

        if (isLoading)
        {
            return "Loading project settings...";
        }

        return $"Selected files: {selectedFilePaths.Count}. Use the file picker to add more files.";
    }

    #endregion

    #region History actions

    private async Task LoadHistoryAsync()
    {
        isLoadingHistory = true;

        try
        {
            historyEntries = await LocalCoderHistoryService.GetHistoryAsync(20);

            if (selectedHistoryEntry is not null)
            {
                selectedHistoryEntry = historyEntries.FirstOrDefault(entry => entry.Id == selectedHistoryEntry.Id)
                    ?? await LocalCoderHistoryService.GetEntryAsync(selectedHistoryEntry.Id);
            }
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            isLoadingHistory = false;
        }
    }

    private async Task LoadAgentRunHistoryAsync()
    {
        try
        {
            agentRunHistory = await AgentRunHistoryService.GetAllAsync();

            if (selectedAgentRun is not null)
            {
                selectedAgentRun = agentRunHistory.FirstOrDefault(run => run.Id == selectedAgentRun.Id)
                    ?? selectedAgentRun;
            }
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
    }

    private Task OnAgentRunSelected(AgentRunRecord run)
    {
        selectedAgentRun = run;
        return Task.CompletedTask;
    }

    #endregion

    #region Patch actions

    private async Task LoadPatchQueueAsync()
    {
        try
        {
            patchPackages = await PatchPackageService.GetAllAsync();

            if (selectedPatchPackage is not null)
            {
                selectedPatchPackage = patchPackages.FirstOrDefault(package => package.Id == selectedPatchPackage.Id)
                    ?? selectedPatchPackage;
            }
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
    }

    private Task OnPatchPackageSelected(PatchPackage package)
    {
        selectedPatchPackage = package;
        return Task.CompletedTask;
    }

    private bool CanReviewSelectedPatch()
    {
        return selectedPatchPackage is not null && !isCommitRunning && !isBuildDeployRunning && !isApplyingPatch;
    }

    private bool CanApproveSelectedPatch()
    {
        return selectedPatchPackage is not null &&
               selectedPatchPackage.Status is PatchPackageStatus.Draft or PatchPackageStatus.Reviewed &&
               !isCommitRunning &&
               !isBuildDeployRunning &&
               !isApplyingPatch;
    }

    private bool CanApplySelectedPatch()
    {
        return selectedPatchPackage is not null &&
               selectedPatchPackage.Status == PatchPackageStatus.Approved &&
               selectedPatchPackage.ApprovalGatesPassed &&
               !isApplyingPatch &&
               !isRollingBack;
    }

    private bool CanRollbackSelectedPatch()
    {
        return selectedPatchPackage is not null &&
               selectedPatchPackage.Status == PatchPackageStatus.Applied &&
               !selectedPatchPackage.RolledBack &&
               !isApplyingPatch &&
               !isRollingBack &&
               !isCommitRunning &&
               !isBuildDeployRunning;
    }

    private bool CanVerifySelectedPatch()
    {
        return selectedPatchPackage is not null &&
               !isVerifying &&
               !isRunningCommand;
    }

    private async Task ReviewSelectedPatchAsync()
    {
        if (selectedPatchPackage is null)
        {
            return;
        }

        try
        {
            selectedPatchPackage = await PatchPackageService.UpdateStatusAsync(
                selectedPatchPackage.Id,
                PatchPackageStatus.Reviewed,
                "Patch reviewed.");
            await LoadPatchQueueAsync();
            NotificationService.Notify(
                NotificationSeverity.Success,
                "Patch reviewed",
                selectedPatchPackage?.Id ?? string.Empty);
        }
        catch (Exception exception)
        {
            error = exception.Message;
            NotificationService.Notify(NotificationSeverity.Error, "Patch review failed", exception.Message);
        }
    }

    private async Task ApproveSelectedPatchAsync()
    {
        if (selectedPatchPackage is null)
        {
            return;
        }

        try
        {
            selectedPatchPackage = await PatchPackageService.ApproveAsync(selectedPatchPackage.Id);
            await LoadPatchQueueAsync();
            NotificationService.Notify(
                NotificationSeverity.Success,
                "Patch approved",
                selectedPatchPackage?.Id ?? string.Empty);
        }
        catch (Exception exception)
        {
            error = exception.Message;
            NotificationService.Notify(NotificationSeverity.Error, "Patch approval failed", exception.Message);
        }
    }

    private async Task ApplySelectedPatchAsync()
    {
        if (selectedPatchPackage is null)
        {
            return;
        }

        try
        {
            selectedPatchPackage = await PatchApplyService.ApplyAsync(selectedPatchPackage.Id);
            await LoadPatchQueueAsync();
            NotificationService.Notify(
                NotificationSeverity.Success,
                "Patch applied",
                selectedPatchPackage?.StatusMessage ?? "Applied.");
        }
        catch (Exception exception)
        {
            error = exception.Message;
            await PatchPackageService.UpdateStatusAsync(
                selectedPatchPackage.Id,
                PatchPackageStatus.Failed,
                exception.Message);
            await LoadPatchQueueAsync();
            NotificationService.Notify(NotificationSeverity.Error, "Patch apply failed", exception.Message);
        }
    }

    private async Task RollbackSelectedPatchAsync()
    {
        if (selectedPatchPackage is null)
        {
            return;
        }

        try
        {
            isRollingBack = true;
            selectedPatchPackage = await PatchRollbackService.RollbackAsync(selectedPatchPackage.Id);
            await LoadPatchQueueAsync();
            NotificationService.Notify(
                NotificationSeverity.Success,
                "Patch rolled back",
                selectedPatchPackage?.RollbackResult ?? "Rollback completed.");
        }
        catch (Exception exception)
        {
            error = exception.Message;
            await LoadPatchQueueAsync();
            NotificationService.Notify(NotificationSeverity.Error, "Patch rollback failed", exception.Message);
        }
        finally
        {
            isRollingBack = false;
        }
    }

    private async Task VerifySelectedPatchAsync()
    {
        if (selectedPatchPackage is null)
        {
            return;
        }

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForVerifyProject());
            var results = await AgentModeRunner.VerifyProjectAsync(selectedPatchPackage.ProjectPath, profile);
            var failed = results.FirstOrDefault(result => result.ExitCode != 0);
            var status = failed is null ? PatchPackageStatus.Verified : PatchPackageStatus.Failed;
            var statusMessage = failed is null
                ? "Patch verification passed."
                : $"{failed.Command} exited {failed.ExitCode}";

            selectedPatchPackage = await PatchPackageService.UpdateStatusAsync(
                selectedPatchPackage.Id,
                status,
                statusMessage);
            await LoadPatchQueueAsync();

            NotificationService.Notify(
                failed is null ? NotificationSeverity.Success : NotificationSeverity.Warning,
                failed is null ? "Patch verified" : "Patch verification failed",
                statusMessage);
        }
        catch (Exception exception)
        {
            error = exception.Message;
            NotificationService.Notify(NotificationSeverity.Error, "Patch verification failed", exception.Message);
        }
    }

    #endregion

    #region History actions

    private async Task ViewHistoryEntryAsync(string id)
    {
        selectedHistoryEntry = await LocalCoderHistoryService.GetEntryAsync(id);
    }

    private async Task UseHistoryEntryAsContextAsync()
    {
        if (selectedHistoryEntry is null)
        {
            return;
        }

        request.ProjectPath = selectedHistoryEntry.ProjectPath;
        if (!string.IsNullOrWhiteSpace(selectedHistoryEntry.Model))
        {
            request.Model = selectedHistoryEntry.Model;
        }

        selectedFilePaths = selectedHistoryEntry.SelectedFiles.ToList();
        selectedFiles = [];
        ClearLoadedContext();

        await EnsureFileContextLoadedAsync();

        var summary = BuildHistoryContextSummary(selectedHistoryEntry);
        request.Task = string.IsNullOrWhiteSpace(request.Task)
            ? summary
            : $"{request.Task.TrimEnd()}{Environment.NewLine}{Environment.NewLine}{summary}";

        NotificationService.Notify(
            NotificationSeverity.Success,
            "History context loaded",
            "The history entry was loaded into the current task context.");
    }

    private async Task ClearHistoryAsync()
    {
        var confirmed = await DialogService.Confirm(
            "Clear all Local Coder history entries?",
            "Clear History",
            new ConfirmOptions { OkButtonText = "Clear History", CancelButtonText = "Cancel" });

        if (confirmed != true)
        {
            return;
        }

        isClearingHistory = true;

        try
        {
            await LocalCoderHistoryService.ClearHistoryAsync();
            historyEntries = [];
            selectedHistoryEntry = null;

            NotificationService.Notify(
                NotificationSeverity.Success,
                "History cleared",
                "Local Coder history was cleared.");
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "History clear failed",
                exception.Message);
        }
        finally
        {
            isClearingHistory = false;
        }
    }

    private async Task SaveHistoryEntryAsync(
        LocalCoderHistoryActionType actionType,
        bool success,
        string message,
        string? planText = null,
        string? patchPreviewText = null,
        LocalCoderPatchApplyResult? applyResult = null,
        LocalCoderPatchRollbackResult? rollbackResult = null,
        IReadOnlyList<CommandRunResult>? verificationResults = null,
        string? model = null)
    {
        try
        {
            await LocalCoderHistoryService.AddEntryAsync(new LocalCoderHistoryEntry
            {
                ActionType = actionType,
                CreatedAt = DateTimeOffset.UtcNow,
                ProjectPath = request.ProjectPath,
                Model = model ?? request.Model,
                Task = request.Task,
                SelectedFiles = selectedFilePaths.ToArray(),
                LoadedContextFiles = request.FileContexts
                    .Select(fileContext => new LocalCoderHistoryFileSummary
                    {
                        RelativePath = fileContext.RelativePath,
                        CharacterCount = fileContext.CharacterCount
                    })
                    .ToArray(),
                PlanText = planText ?? string.Empty,
                PatchPreviewText = patchPreviewText ?? string.Empty,
                ApplyResult = applyResult,
                RollbackResult = rollbackResult,
                VerificationResults = verificationResults?.ToArray() ?? [],
                Success = success,
                Message = message
            });

            await LoadHistoryAsync();
        }
        catch (Exception exception)
        {
            Console.WriteLine($"History save failed: {exception}");
        }
    }

    #endregion

    #region UI helper methods

    private static string BuildHistoryContextSummary(LocalCoderHistoryEntry entry)
    {
        var selectedFiles = entry.SelectedFiles.Count == 0
            ? "none"
            : string.Join(", ", entry.SelectedFiles);

        var resultStatus = entry.ActionType switch
        {
            LocalCoderHistoryActionType.ApplyPatch => entry.ApplyResult is null
                ? "n/a"
                : $"{entry.ApplyResult.Applied}, verification {entry.ApplyResult.VerificationPassed}",
            LocalCoderHistoryActionType.RollbackPatch => entry.RollbackResult is null
                ? "n/a"
                : $"{entry.RollbackResult.RolledBack}, verification {entry.RollbackResult.VerificationPassed}",
            LocalCoderHistoryActionType.VerifyProject => entry.VerificationResults.Count == 0
                ? "n/a"
                : entry.Success.ToString(),
            _ => entry.Success.ToString()
        };

        return string.Join(Environment.NewLine, new[]
        {
            "Previous Local Coder history context:",
            $"- Previous action: {entry.ActionType}",
            $"- Previous task: {entry.Task}",
            $"- Previous selected files: {selectedFiles}",
            $"- Previous result message: {entry.Message}",
            $"- Apply/rollback/verify passed: {resultStatus}"
        });
    }

    private AgentModeProfile GetRequiredProfile(AgentMode mode)
    {
        var profile = agentModeProfiles.FirstOrDefault(item => item.Mode == mode);

        if (profile is null)
        {
            throw new InvalidOperationException($"Agent mode profile is not configured for {mode}.");
        }

        return profile;
    }

    private IReadOnlyList<(string ActionLabel, AgentModeProfile Profile)> GetProfileRows()
    {
        var actions = new (string ActionLabel, AgentMode Mode)[]
        {
            ("Create Plan", AgentActionProfiles.ForCreatePlan()),
            ("Generate Patch Preview", AgentActionProfiles.ForGeneratePatchPreview()),
            ("Apply Patch", AgentActionProfiles.ForApplyPatch()),
            ("Rollback Patch", AgentActionProfiles.ForRollbackPatch()),
            ("Run Command", AgentActionProfiles.ForRunCommand()),
            ("Verify Project", AgentActionProfiles.ForVerifyProject()),
            ("Commit Changes", AgentActionProfiles.ForCommitChanges()),
            ("Build & Deploy", AgentActionProfiles.ForBuildDeploy()),
            ("Reviewer", AgentActionProfiles.ForReviewDiff())
        };

        return actions
            .Select(action => (
                action.ActionLabel,
                Profile: agentModeProfiles.FirstOrDefault(profile => profile.Mode == action.Mode)))
            .Where(row => row.Profile is not null)
            .Select(row => (row.ActionLabel, row.Profile!))
            .ToArray();
    }

    #endregion
