@page "/coder"
@rendermode InteractiveServer
@using AiBox.DevPortal.Models
@using AiBox.DevPortal.Components.Common
@using AiBox.DevPortal.Services
@using Radzen.Blazor
@using AiBox.DevPortal.Components

<PageTitle>Local Coder</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn>
            <RadzenText Text="Local Coder" TextStyle="TextStyle.H4" />
            <RadzenText
            Text="Use a local Ollama model to plan code changes, generate patch previews, apply patches, rollback patches, and run safe verification commands."
            TextStyle="TextStyle.Body2" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="3">
            <RadzenButton Text="Refresh" Icon="refresh" Click="@LoadAsync" Disabled="@isLoading" Style="width: 100%;" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenFormField Text="Project path">
                <RadzenDropDown TValue="string" @bind-Value="request.ProjectPath" Data="@workspaceRoots"
                                Change="@OnProjectPathChanged" Style="width: 100%;" Placeholder="Select project folder" />
            </RadzenFormField>

            <RadzenCard>
                <RadzenStack Gap="0.75rem">
                    <RadzenText Text="Agent Mode Profiles" TextStyle="TextStyle.H5" />
                    <RadzenText Text="Each action below routes through a fixed profile before it runs."
                                TextStyle="TextStyle.Body2" />

                    @if (agentModeProfiles.Count == 0)
                    {
                        <RadzenText Text="Loading profiles..." TextStyle="TextStyle.Body2" />
                    }
                    else
                    {
                        @foreach (var profileRow in GetProfileRows())
                        {
                            <RadzenCard Style="margin: 0;">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="@profileRow.ActionLabel" TextStyle="TextStyle.Body1" />
                                    <RadzenText Text="@($"{profileRow.Profile.Name} | Model: {profileRow.Profile.Model}")"
                                                TextStyle="TextStyle.Body2" />
                                    <RadzenText Text="@profileRow.Profile.RulesSummary" TextStyle="TextStyle.Caption" />
                                </RadzenStack>
                            </RadzenCard>
                        }
                    }
                </RadzenStack>
            </RadzenCard>

            <RadzenCard>
                <RadzenStack Gap="0.75rem">
                    <RadzenText Text="Agent Run History" TextStyle="TextStyle.H5" />
                    <RadzenText Text="Newest runs appear first. Select a row to inspect the prompt and result text."
                                TextStyle="TextStyle.Body2" />

                    <AppDataGrid @ref="grid1" Data="@agentRunHistory" TItem="AgentRunRecord" PageSize="10"
                                    EmptyText="No agent runs recorded yet."
                                    RowSelect="@OnAgentRunSelected">
                        <Columns>
                            <RadzenDataGridColumn TItem="AgentRunRecord" Title="Timestamp">
                                <Template Context="run">
                                    @run.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="AgentRunRecord" Property="ActionKey" Title="Action" />
                            <RadzenDataGridColumn TItem="AgentRunRecord" Property="ProfileMode" Title="Profile" />
                            <RadzenDataGridColumn TItem="AgentRunRecord" Property="Model" Title="Model" />
                            <RadzenDataGridColumn TItem="AgentRunRecord" Title="Success">
                                <Template Context="run">
                                    <RadzenBadge Text="@(run.Success ? "Success" : "Failed")"
                                                 BadgeStyle="@(run.Success ? BadgeStyle.Success : BadgeStyle.Warning)" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="AgentRunRecord" Property="ErrorMessage" Title="Error" />
                        </Columns>
                    </AppDataGrid>

                    @if (selectedAgentRun is not null)
                    {
                        <RadzenCard>
                            <RadzenStack Gap="0.5rem">
                                <RadzenText Text="Selected Run" TextStyle="TextStyle.H6" />
                                <RadzenText Text="@($"Action: {selectedAgentRun.ActionKey}")" TextStyle="TextStyle.Body1" />
                                <RadzenText Text="@($"Profile mode: {selectedAgentRun.ProfileMode}")" TextStyle="TextStyle.Body1" />
                                <RadzenText Text="@($"Model: {selectedAgentRun.Model}")" TextStyle="TextStyle.Body1" />
                                <RadzenText Text="@($"Timestamp: {selectedAgentRun.Timestamp:O}")" TextStyle="TextStyle.Body1" />
                                <RadzenText Text="@($"Success: {selectedAgentRun.Success}")" TextStyle="TextStyle.Body1" />
                                <RadzenText Text="@($"Error: {selectedAgentRun.ErrorMessage}")" TextStyle="TextStyle.Body1" />

                                <RadzenText Text="User Request" TextStyle="TextStyle.H6" />
                                <pre class="coder-output">@selectedAgentRun.UserRequest</pre>

                                <RadzenText Text="Prompt Sent" TextStyle="TextStyle.H6" />
                                <pre class="coder-output">@selectedAgentRun.PromptSent</pre>

                                <RadzenText Text="Result Text" TextStyle="TextStyle.H6" />
                                <pre class="coder-output">@selectedAgentRun.ResultText</pre>
                            </RadzenStack>
                        </RadzenCard>
                    }
                </RadzenStack>
            </RadzenCard>

            <RadzenCard>
                <RadzenStack Gap="0.75rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                 JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                        <div>
                            <RadzenText Text="File Context" TextStyle="TextStyle.H5" />
                            <RadzenText Text="@GetProjectFilesStatusText()" TextStyle="TextStyle.Body2" />
                        </div>

                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                            <RadzenButton Text="Preview Context" Icon="description" ButtonStyle="ButtonStyle.Primary"
                                          Click="@PreviewContextAsync"
                                          Disabled="@(isLoading || string.IsNullOrWhiteSpace(request.ProjectPath) || !selectedFilePaths.Any())" />

                            <RadzenButton Text="Clear Selected" Icon="remove_circle_outline"
                                          ButtonStyle="ButtonStyle.Light" Click="@ClearSelectedFilesAsync"
                                          Disabled="@(isLoading || !selectedFilePaths.Any())" />

                            <RadzenButton Text="Clear Context" Icon="clear" ButtonStyle="ButtonStyle.Light"
                                          Click="@ClearContextAsync" Disabled="@(isLoading || fileContexts.Count == 0)" />
                        </RadzenStack>
                    </RadzenStack>

                    <RadzenText Text="@($"Loaded context files: {fileContexts.Count}")" TextStyle="TextStyle.Body2" />

                    <FileAutoComplete RootDirectory="@request.ProjectPath"
                                      Placeholder="Search by relative path or file name, e.g. Coder.razor, service, Program.cs"
                                      ShowSelectedInfo="true" SelectedFiles="@selectedFiles"
                                      SelectedFilesChanged="@OnSelectedFilesChanged" FileSelected="@OnFileSelected" />
                </RadzenStack>
            </RadzenCard>

            <RadzenFormField Text="Model">
                <RadzenDropDown TValue="string" @bind-Value="request.Model" Data="@models" Style="width: 100%;"
                                Placeholder="Select Ollama model" />
            </RadzenFormField>

            <RadzenFormField Text="Task">
                <RadzenTextArea @bind-Value="request.Task" Rows="6" Style="width: 100%;"
                                Placeholder="Example: review AiBox.DevPortal and suggest the next safe Local Coder improvement" />
            </RadzenFormField>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="Create Plan" Icon="psychology" ButtonStyle="ButtonStyle.Primary"
                              Click="@CreatePlanAsync"
                              Disabled="@(isLoading || isPlanning || string.IsNullOrWhiteSpace(request.Task))" />

                <RadzenButton Text="Generate Patch Preview" Icon="difference" ButtonStyle="ButtonStyle.Warning"
                              Click="@GeneratePatchPreviewAsync"
                              Disabled="@(isLoading || isGeneratingPatch || string.IsNullOrWhiteSpace(request.Task))" />
            </RadzenStack>

            <RadzenText Text="Preview only. No files are modified automatically." TextStyle="TextStyle.Caption" />
        </RadzenStack>
    </RadzenCard>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true">
            @error
        </RadzenAlert>
    }

    @if (LastPatchValidationErrors.Count > 0)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText Text="Patch Debug" TextStyle="TextStyle.H5" />

                <div>
                    <RadzenText Text="Validation Errors" TextStyle="TextStyle.H6" />
                    <pre class="coder-error">@string.Join(Environment.NewLine, LastPatchValidationErrors.Select(errorText => $"- {errorText}"))</pre>
                </div>

                <div>
                    <RadzenText Text="Raw Model Response" TextStyle="TextStyle.H6" />
                    <pre class="coder-output">@LastPatchRawResponse</pre>
                </div>

                <div>
                    <RadzenText Text="Normalized Diff" TextStyle="TextStyle.H6" />
                    <pre class="coder-output">@LastPatchNormalizedDiff</pre>
                </div>
            </RadzenStack>
        </RadzenCard>
    }

    @if (patchPreview is not null)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                    <RadzenText Text="Patch Preview" TextStyle="TextStyle.H5" />

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        <CopyToClipboardButton Text="Copy Patch" Value="@patchPreview.PatchText" SuccessTitle="Patch copied"
                                               SuccessMessage="The patch preview was copied to the clipboard." />

                        <RadzenButton Text="Apply Patch" Icon="publish" ButtonStyle="ButtonStyle.Danger"
                                      Click="@ApplyPatchAsync" Disabled="@(!CanApplyPatchPreview())" />

                    </RadzenStack>

                    <RadzenText Text="Preview only. No files are modified automatically." TextStyle="TextStyle.Caption" />
                    <pre class="coder-output">@patchPreview.PatchText</pre>

                    @if (applyResult is not null)
                    {
                        <RadzenText Text="Apply Patch Message" TextStyle="TextStyle.H6" />
                        <pre class="coder-output">@applyResult.Message</pre>
                    }
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }

    @if (applyResult is not null)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText Text="Patch Apply Result" TextStyle="TextStyle.H5" />

                <RadzenAlert
                    AlertStyle="@(applyResult.Applied && applyResult.VerificationPassed ? AlertStyle.Success : AlertStyle.Warning)"
                    ShowIcon="true">
                    @applyResult.Message
                </RadzenAlert>

                @if (CanRollbackPatch())
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        <RadzenButton Text="Rollback Patch" Icon="undo" ButtonStyle="ButtonStyle.Warning"
                                      Click="@RollbackPatchAsync" Disabled="@isRollingBack" />
                    </RadzenStack>
                }

                <RadzenText Text="@($"Project path: {patchPreview?.ProjectPath}")" TextStyle="TextStyle.Body1" />
                <RadzenText Text="@($"Applied: {applyResult.Applied}")" TextStyle="TextStyle.Body1" />
                <RadzenText Text="@($"Verification passed: {applyResult.VerificationPassed}")"
                            TextStyle="TextStyle.Body1" />
                <RadzenText Text="@($"Message: {applyResult.Message}")" TextStyle="TextStyle.Body1" />

                <RadzenText Text="Git Apply Result" TextStyle="TextStyle.H6" />
                <RadzenCard>
                    <RadzenText Text="@($"Exit code: {applyResult.GitApplyResult.ExitCode}")" TextStyle="TextStyle.Body1" />

                    <h4>Stdout</h4>
                    <pre class="coder-output">@applyResult.GitApplyResult.Output</pre>

                    <h4>Stderr</h4>
                    <pre class="coder-error">@applyResult.GitApplyResult.Error</pre>
                </RadzenCard>

                <RadzenText Text="Git Diff Stat" TextStyle="TextStyle.H6" />
                <RadzenCard>
                    <RadzenText Text="@($"Exit code: {applyResult.GitDiffStatResult.ExitCode}")"
                                TextStyle="TextStyle.Body1" />
                    <pre class="coder-output">@applyResult.GitDiffStatResult.Output</pre>
                    <pre class="coder-error">@applyResult.GitDiffStatResult.Error</pre>
                </RadzenCard>

                <RadzenText Text="Changed Files Diff" TextStyle="TextStyle.H6" />
                <RadzenCard>
                    <RadzenText Text="@($"Exit code: {applyResult.ChangedFilesDiffResult.ExitCode}")"
                                TextStyle="TextStyle.Body1" />
                    <pre class="coder-output">@applyResult.ChangedFilesDiffResult.Output</pre>
                    <pre class="coder-error">@applyResult.ChangedFilesDiffResult.Error</pre>
                </RadzenCard>

                @if (applyResult.ChangedFiles.Count > 0)
                {
                    <RadzenText Text="Changed Files" TextStyle="TextStyle.H6" />
                    @foreach (var changedFile in applyResult.ChangedFiles)
                    {
                        <RadzenText Text="@changedFile" TextStyle="TextStyle.Body2" />
                    }
                }

                @if (applyResult.BackupFiles.Count > 0)
                {
                    <RadzenText Text="Backup Files" TextStyle="TextStyle.H6" />
                    @foreach (var backupFile in applyResult.BackupFiles)
                    {
                        <RadzenText Text="@backupFile" TextStyle="TextStyle.Body2" />
                    }
                }

                @if (applyResult.VerificationResults.Count > 0)
                {
                    <RadzenText Text="Verification Results" TextStyle="TextStyle.H6" />

                    @foreach (var result in applyResult.VerificationResults)
                    {
                        <RadzenCard>
                            <RadzenText Text="@($"{result.Command} — exit {result.ExitCode}")" TextStyle="TextStyle.Body1" />

                            @if (!string.IsNullOrWhiteSpace(result.Output))
                            {
                                <pre class="coder-output">@result.Output</pre>
                            }

                            @if (!string.IsNullOrWhiteSpace(result.Error))
                            {
                                <pre class="coder-error">@result.Error</pre>
                            }
                        </RadzenCard>
                    }
                }
            </RadzenStack>
        </RadzenCard>
    }

    @if (rollbackResult is not null)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText Text="Patch Rollback Result" TextStyle="TextStyle.H5" />

                <RadzenAlert
                    AlertStyle="@(rollbackResult.RolledBack && rollbackResult.VerificationPassed ? AlertStyle.Success : AlertStyle.Warning)"
                    ShowIcon="true">
                    @rollbackResult.Message
                </RadzenAlert>

                <RadzenText Text="@($"Rolled back: {rollbackResult.RolledBack}")" TextStyle="TextStyle.Body1" />
                <RadzenText Text="@($"Verification passed: {rollbackResult.VerificationPassed}")"
                            TextStyle="TextStyle.Body1" />

                <RadzenText Text="Restored Files" TextStyle="TextStyle.H6" />
                @foreach (var restoredFile in rollbackResult.RestoredFiles)
                {
                    <RadzenText Text="@restoredFile" TextStyle="TextStyle.Body2" />
                }

                @if (rollbackResult.VerificationResults.Count > 0)
                {
                    <RadzenText Text="Verification Results" TextStyle="TextStyle.H6" />

                    @foreach (var result in rollbackResult.VerificationResults)
                    {
                        <RadzenCard>
                            <RadzenText Text="@($"{result.Command} — exit {result.ExitCode}")" TextStyle="TextStyle.Body1" />

                            @if (!string.IsNullOrWhiteSpace(result.Output))
                            {
                                <pre class="coder-output">@result.Output</pre>
                            }

                            @if (!string.IsNullOrWhiteSpace(result.Error))
                            {
                                <pre class="coder-error">@result.Error</pre>
                            }
                        </RadzenCard>
                    }
                }
            </RadzenStack>
        </RadzenCard>
    }

    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                <div>
                    <RadzenText Text="Patch Queue" TextStyle="TextStyle.H5" />
                    <RadzenText Text="Generated patches are saved here as draft packages. Review, approve, apply, and verify from this queue."
                                TextStyle="TextStyle.Body2" />
                </div>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenButton Text="Review" Icon="rate_review" ButtonStyle="ButtonStyle.Light"
                                  Click="@ReviewSelectedPatchAsync" Disabled="@(!CanReviewSelectedPatch())" />
                    <RadzenButton Text="Approve" Icon="check_circle" ButtonStyle="ButtonStyle.Success"
                                  Click="@ApproveSelectedPatchAsync" Disabled="@(!CanApproveSelectedPatch())" />
                    <RadzenButton Text="Apply" Icon="publish" ButtonStyle="ButtonStyle.Danger"
                                  Click="@ApplySelectedPatchAsync" Disabled="@(!CanApplySelectedPatch())" />
                    <RadzenButton Text="Verify" Icon="verified" ButtonStyle="ButtonStyle.Primary"
                                  Click="@VerifySelectedPatchAsync" Disabled="@(!CanVerifySelectedPatch())" />
                    <RadzenButton Text="Rollback" Icon="undo" ButtonStyle="ButtonStyle.Warning"
                                  Click="@RollbackSelectedPatchAsync" Disabled="@(!CanRollbackSelectedPatch())" />
                </RadzenStack>
            </RadzenStack>

            <AppDataGrid @ref="grid2" Data="@patchPackages" TItem="PatchPackage" PageSize="8"
                            EmptyText="No patch packages queued yet."
                            RowSelect="@OnPatchPackageSelected">
                <Columns>
                    <RadzenDataGridColumn TItem="PatchPackage" Title="Created">
                        <Template Context="package">
                            @package.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PatchPackage" Property="Status" Title="Status" />
                    <RadzenDataGridColumn TItem="PatchPackage" Property="ProjectPath" Title="Project" />
                    <RadzenDataGridColumn TItem="PatchPackage" Property="Model" Title="Model" />
                    <RadzenDataGridColumn TItem="PatchPackage" Title="Files">
                        <Template Context="package">
                            @package.FileChanges.Count
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PatchPackage" Property="StatusMessage" Title="Message" />
                </Columns>
            </AppDataGrid>

            @if (selectedPatchPackage is not null)
            {
                <RadzenCard>
                    <RadzenStack Gap="0.75rem">
                        <RadzenText Text="Selected Patch" TextStyle="TextStyle.H6" />
                        <RadzenText Text="@($"Package ID: {selectedPatchPackage.Id}")" TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Status: {selectedPatchPackage.Status}")" TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Project path: {selectedPatchPackage.ProjectPath}")" TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Model: {selectedPatchPackage.Model}")" TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Request: {selectedPatchPackage.UserRequest}")" TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Status message: {selectedPatchPackage.StatusMessage}")" TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Approval gates passed: {selectedPatchPackage.ApprovalGatesPassed}")"
                                    TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Backup folder: {selectedPatchPackage.BackupFolder}")" TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Applied at: {(selectedPatchPackage.AppliedAt?.ToString("O") ?? "n/a")}")" TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Rolled back: {selectedPatchPackage.RolledBack}")" TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Rolled back at: {(selectedPatchPackage.RolledBackAt?.ToString("O") ?? "n/a")}")" TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Rollback result: {selectedPatchPackage.RollbackResult}")" TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Rollback error: {selectedPatchPackage.RollbackError}")" TextStyle="TextStyle.Body1" />

                        <RadzenText Text="Approval Gate Results" TextStyle="TextStyle.H6" />
                        @if (selectedPatchPackage.ApprovalGateResults.Count == 0)
                        {
                            <RadzenText Text="No approval gates have been run yet." TextStyle="TextStyle.Body2" />
                        }
                        else
                        {
                            @foreach (var gateResult in selectedPatchPackage.ApprovalGateResults)
                            {
                                <RadzenCard Style="margin: 0;">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenText Text="@gateResult.GateKey" TextStyle="TextStyle.Body1" />
                                        <RadzenText Text="@($"Passed: {gateResult.Passed}")" TextStyle="TextStyle.Body2" />
                                        <RadzenText Text="@($"Blocking: {gateResult.Blocking}")" TextStyle="TextStyle.Body2" />
                                        <RadzenText Text="@($"Warning: {gateResult.Warning}")" TextStyle="TextStyle.Body2" />
                                        @if (!string.IsNullOrWhiteSpace(gateResult.FilePath))
                                        {
                                            <RadzenText Text="@($"File: {gateResult.FilePath}")" TextStyle="TextStyle.Body2" />
                                        }
                                        <RadzenText Text="@gateResult.Message" TextStyle="TextStyle.Body2" />
                                    </RadzenStack>
                                </RadzenCard>
                            }
                        }

                        <RadzenText Text="Selected Patch Files" TextStyle="TextStyle.H6" />
                        @foreach (var fileChange in selectedPatchPackage.FileChanges)
                        {
                            <RadzenText Text="@fileChange.RelativePath" TextStyle="TextStyle.Body2" />
                        }

                        <RadzenText Text="Simple Before/After Diff" TextStyle="TextStyle.H6" />
                        @foreach (var fileChange in selectedPatchPackage.FileChanges)
                        {
                            <details style="margin-bottom: 0.75rem;">
                                <summary>@fileChange.RelativePath</summary>
                                <RadzenText Text="Before" TextStyle="TextStyle.Body2" />
                                <pre class="coder-output">@fileChange.OldContent</pre>
                                <RadzenText Text="After" TextStyle="TextStyle.Body2" />
                                <pre class="coder-output">@fileChange.NewContent</pre>
                            </details>
                        }

                        @if (!string.IsNullOrWhiteSpace(selectedPatchPackage.PatchText))
                        {
                            <details>
                                <summary>Raw Patch Text</summary>
                                <pre class="coder-output">@selectedPatchPackage.PatchText</pre>
                            </details>
                        }
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                <div>
                    <RadzenText Text="Task History" TextStyle="TextStyle.H5" />
                    <RadzenText Text="@($"Latest entries: {historyEntries.Count}")" TextStyle="TextStyle.Body2" />
                </div>

                <RadzenButton Text="Clear History" Icon="delete" ButtonStyle="ButtonStyle.Light"
                              Click="@ClearHistoryAsync"
                              Disabled="@(isLoadingHistory || isClearingHistory || historyEntries.Count == 0)" />
            </RadzenStack>

            @if (historyEntries.Count == 0)
            {
                <RadzenText Text="No Local Coder history entries yet." TextStyle="TextStyle.Body2" />
            }
            else
            {
                @foreach (var entry in historyEntries)
                {
                    <RadzenCard>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                            <div>
                                <RadzenText Text="@($"{entry.CreatedAt:yyyy-MM-dd HH:mm:ss} UTC")" TextStyle="TextStyle.Body1" />
                                <RadzenText Text="@($"{entry.ActionType} | {GetHistoryStatusText(entry.Success)} | {GetHistoryMessageSummary(entry.Message)}")"
                                            TextStyle="TextStyle.Body2" />
                            </div>

                            <RadzenButton Text="View" Icon="open_in_new" ButtonStyle="ButtonStyle.Primary"
                                          Click="@(() => ViewHistoryEntryAsync(entry.Id))" />
                        </RadzenStack>
                    </RadzenCard>
                }
            }

            @if (selectedHistoryEntry is not null)
            {
                <RadzenCard>
                    <RadzenStack Gap="0.75rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                            <div>
                                <RadzenText Text="History Detail" TextStyle="TextStyle.H5" />
                                <RadzenText Text="@selectedHistoryEntry.Message" TextStyle="TextStyle.Body2" />
                            </div>

                            <RadzenButton Text="Use as Context" Icon="call_split" ButtonStyle="ButtonStyle.Primary"
                                          Click="@UseHistoryEntryAsContextAsync" />
                        </RadzenStack>

                        <RadzenText Text="@($"Action: {selectedHistoryEntry.ActionType}")" TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Created: {selectedHistoryEntry.CreatedAt:O}")" TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Project path: {selectedHistoryEntry.ProjectPath}")" TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Model: {selectedHistoryEntry.Model}")" TextStyle="TextStyle.Body1" />
                        <RadzenText Text="@($"Success: {selectedHistoryEntry.Success}")" TextStyle="TextStyle.Body1" />

                        <RadzenText Text="Task" TextStyle="TextStyle.H6" />
                        <pre class="coder-output">@selectedHistoryEntry.Task</pre>

                        <RadzenText Text="Selected Files" TextStyle="TextStyle.H6" />
                        @foreach (var selectedFile in selectedHistoryEntry.SelectedFiles)
                        {
                            <RadzenText Text="@selectedFile" TextStyle="TextStyle.Body2" />
                        }

                        <RadzenText Text="Loaded Context Files" TextStyle="TextStyle.H6" />
                        @foreach (var contextFile in selectedHistoryEntry.LoadedContextFiles)
                        {
                            <RadzenText Text="@($"{contextFile.RelativePath} ({contextFile.CharacterCount} chars)")" TextStyle="TextStyle.Body2" />
                        }

                        @if (!string.IsNullOrWhiteSpace(selectedHistoryEntry.PlanText))
                        {
                            <details>
                                <summary>Plan</summary>
                                <pre class="coder-output">@selectedHistoryEntry.PlanText</pre>
                            </details>
                        }

                        @if (!string.IsNullOrWhiteSpace(selectedHistoryEntry.PatchPreviewText))
                        {
                            <details>
                                <summary>Patch Preview</summary>
                                <pre class="coder-output">@selectedHistoryEntry.PatchPreviewText</pre>
                            </details>
                        }

                        @if (selectedHistoryEntry.ApplyResult is not null)
                        {
                            <details>
                                <summary>Apply Result</summary>
                                <RadzenText Text="@($"Applied: {selectedHistoryEntry.ApplyResult.Applied}")" TextStyle="TextStyle.Body1" />
                                <RadzenText Text="@($"Verification passed: {selectedHistoryEntry.ApplyResult.VerificationPassed}")" TextStyle="TextStyle.Body1" />
                                <RadzenText Text="@selectedHistoryEntry.ApplyResult.Message" TextStyle="TextStyle.Body2" />

                                <details>
                                    <summary>Git Apply Output</summary>
                                    <pre class="coder-output">@selectedHistoryEntry.ApplyResult.GitApplyResult.Output</pre>
                                    <pre class="coder-error">@selectedHistoryEntry.ApplyResult.GitApplyResult.Error</pre>
                                </details>

                                <details>
                                    <summary>Git Diff</summary>
                                    <pre class="coder-output">@selectedHistoryEntry.ApplyResult.GitDiffStatResult.Output</pre>
                                    <pre class="coder-error">@selectedHistoryEntry.ApplyResult.GitDiffStatResult.Error</pre>
                                    <pre class="coder-output">@selectedHistoryEntry.ApplyResult.ChangedFilesDiffResult.Output</pre>
                                    <pre class="coder-error">@selectedHistoryEntry.ApplyResult.ChangedFilesDiffResult.Error</pre>
                                </details>

                                <details>
                                    <summary>Build/Test Output</summary>
                                    @foreach (var verification in selectedHistoryEntry.ApplyResult.VerificationResults)
                                    {
                                        <RadzenCard Style="margin-top: 0.5rem;">
                                            <RadzenText Text="@($"{verification.Command} — exit {verification.ExitCode}")" TextStyle="TextStyle.Body1" />
                                            <pre class="coder-output">@verification.Output</pre>
                                            <pre class="coder-error">@verification.Error</pre>
                                        </RadzenCard>
                                    }
                                </details>
                            </details>
                        }

                @if (selectedHistoryEntry.RollbackResult is not null)
                {
                    <details>
                        <summary>Rollback Result</summary>
                                <RadzenText Text="@($"Rolled back: {selectedHistoryEntry.RollbackResult.RolledBack}")" TextStyle="TextStyle.Body1" />
                                <RadzenText Text="@($"Verification passed: {selectedHistoryEntry.RollbackResult.VerificationPassed}")" TextStyle="TextStyle.Body1" />
                                <RadzenText Text="@selectedHistoryEntry.RollbackResult.Message" TextStyle="TextStyle.Body2" />

                                <details>
                                    <summary>Build/Test Output</summary>
                                    @foreach (var verification in selectedHistoryEntry.RollbackResult.VerificationResults)
                                    {
                                        <RadzenCard Style="margin-top: 0.5rem;">
                                            <RadzenText Text="@($"{verification.Command} — exit {verification.ExitCode}")" TextStyle="TextStyle.Body1" />
                                            <pre class="coder-output">@verification.Output</pre>
                                            <pre class="coder-error">@verification.Error</pre>
                                        </RadzenCard>
                            }
                        </details>
                    </details>
                }

                @if ((selectedHistoryEntry.ActionType == LocalCoderHistoryActionType.CommitChanges ||
                      selectedHistoryEntry.ActionType == LocalCoderHistoryActionType.BuildDeploy) &&
                     selectedHistoryEntry.VerificationResults.Count > 0)
                {
                    <details>
                        <summary>@selectedHistoryEntry.ActionType</summary>
                        @foreach (var result in selectedHistoryEntry.VerificationResults)
                        {
                            <RadzenCard Style="margin-top: 0.5rem;">
                                <RadzenText Text="@($"{result.Command} — exit {result.ExitCode}")" TextStyle="TextStyle.Body1" />
                                <pre class="coder-output">@result.Output</pre>
                                <pre class="coder-error">@result.Error</pre>
                            </RadzenCard>
                        }
                    </details>
                }
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    </RadzenCard>

    @if (currentTask is not null)
    {
        <RadzenCard>
            <RadzenText Text="Plan" TextStyle="TextStyle.H5" />
            <pre class="coder-output">@currentTask.Plan</pre>
        </RadzenCard>
    }

    @if (fileContexts.Count > 0)
    {
        <RadzenCard>
            <RadzenText Text="Loaded File Context" TextStyle="TextStyle.H5" />

            @foreach (var fileContext in fileContexts)
            {
                <details style="margin-bottom: 0.75rem;">
                    <summary>@fileContext.RelativePath (@fileContext.CharacterCount chars)</summary>
                    <pre class="coder-output">@fileContext.Content</pre>
                </details>
            }
        </RadzenCard>
    }

    <RadzenCard>
        <RadzenText Text="Safe Commands" TextStyle="TextStyle.H5" />
        <RadzenText Text="Verify Project runs git status, dotnet build, and dotnet test."
                    TextStyle="TextStyle.Caption" />

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenButton Text="git status" Click="@(() => RunCommandAsync("git status"))"
                          Disabled="@isRunningCommand" />

            <RadzenButton Text="git diff" Click="@(() => RunCommandAsync("git diff"))" Disabled="@isRunningCommand" />

            <RadzenButton Text="dotnet build" ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => RunCommandAsync("dotnet build"))" Disabled="@isRunningCommand" />

            <RadzenButton Text="dotnet test" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => RunCommandAsync("dotnet test"))" Disabled="@isRunningCommand" />

            <RadzenButton Text="Verify Project" Icon="verified" ButtonStyle="ButtonStyle.Success"
                          Click="@VerifyProjectAsync"
                          Disabled="@(isRunningCommand || isVerifying || string.IsNullOrWhiteSpace(request.ProjectPath))" />
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenText Text="Commit Changes" TextStyle="TextStyle.H5" />

            <RadzenFormField Text="Commit message">
                <RadzenTextBox @bind-Value="commitMessage" Style="width: 100%;"
                               Placeholder="Enter commit message" />
            </RadzenFormField>

            <RadzenButton Text="Commit Changes" Icon="commit" ButtonStyle="ButtonStyle.Primary"
                          Click="@CommitChangesAsync"
                          Disabled="@(!CanCommitChanges())" />

            @if (commitResults.Count > 0)
            {
                <RadzenText Text="Command Results" TextStyle="TextStyle.H6" />
                @foreach (var result in commitResults)
                {
                    <RadzenCard>
                        <RadzenText Text="@($"{result.Command} — exit {result.ExitCode}")" TextStyle="TextStyle.Body1" />

                        @if (!string.IsNullOrWhiteSpace(result.Output))
                        {
                            <pre class="coder-output">@result.Output</pre>
                        }

                        @if (!string.IsNullOrWhiteSpace(result.Error))
                        {
                            <pre class="coder-error">@result.Error</pre>
                        }
                    </RadzenCard>
                }
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenText Text="Build & Deploy" TextStyle="TextStyle.H5" />

            <RadzenButton Text="Build & Deploy" Icon="rocket_launch" ButtonStyle="ButtonStyle.Primary"
                          Click="@BuildDeployAsync"
                          Disabled="@(!CanBuildDeploy())" />

            @if (buildDeployResults.Count > 0)
            {
                <RadzenText Text="Command Results" TextStyle="TextStyle.H6" />
                @foreach (var result in buildDeployResults)
                {
                    <RadzenCard>
                        <RadzenText Text="@($"{result.Command} — exit {result.ExitCode}")" TextStyle="TextStyle.Body1" />

                        @if (!string.IsNullOrWhiteSpace(result.Output))
                        {
                            <pre class="coder-output">@result.Output</pre>
                        }

                        @if (!string.IsNullOrWhiteSpace(result.Error))
                        {
                            <pre class="coder-error">@result.Error</pre>
                        }
                    </RadzenCard>
                }
            }
        </RadzenStack>
    </RadzenCard>

    @if (lastCommand is not null)
    {
        <RadzenCard>
            <RadzenText Text="@($"Command: {lastCommand.Command}")" TextStyle="TextStyle.H5" />
            <RadzenText Text="@($"Exit code: {lastCommand.ExitCode}")" TextStyle="TextStyle.Body2" />

            <h4>Output</h4>
            <pre class="coder-output">@lastCommand.Output</pre>

            @if (!string.IsNullOrWhiteSpace(lastCommand.Error))
            {
                <h4>Error</h4>
                <pre class="coder-error">@lastCommand.Error</pre>
            }
        </RadzenCard>
    }

    @if (verifyResults.Count > 0)
    {
        <RadzenCard>
            <RadzenText Text="Verification Result" TextStyle="TextStyle.H5" />

            @foreach (var item in verifyResults)
            {
                <RadzenCard Style="margin-top: 1rem;">
                    <RadzenText Text="@($"{item.Command} — exit {item.ExitCode}")" TextStyle="TextStyle.H6" />

                    @if (!string.IsNullOrWhiteSpace(item.Output))
                    {
                        <h4>Output</h4>
                        <pre class="coder-output">@item.Output</pre>
                    }

                    @if (!string.IsNullOrWhiteSpace(item.Error))
                    {
                        <h4>Error</h4>
                        <pre class="coder-error">@item.Error</pre>
                    }
                </RadzenCard>
            }
        </RadzenCard>
    }
</RadzenStack>

@code {
    [Inject] private ICoderConsoleService CoderConsoleService { get; set; } = default!;
    [Inject] private IAgentModeRunner AgentModeRunner { get; set; } = default!;
    [Inject] private IAgentModeProfileService AgentModeProfiles { get; set; } = default!;
    [Inject] private IAgentRunHistoryService AgentRunHistoryService { get; set; } = default!;
    [Inject] private IPatchPackageService PatchPackageService { get; set; } = default!;
    [Inject] private IPatchApplyService PatchApplyService { get; set; } = default!;
    [Inject] private IPatchRollbackService PatchRollbackService { get; set; } = default!;
    [Inject] private AiBox.DevPortal.Services.ILocalCoderHistoryService LocalCoderHistoryService { get; set; } = default!;
    [Inject] private Radzen.DialogService DialogService { get; set; } = default!;
    [Inject] private Radzen.NotificationService NotificationService { get; set; } = default!;

    private readonly LocalCoderRequest request = new();

    private IReadOnlyList<string> workspaceRoots = [];
    private IReadOnlyList<string> models = [];
    private IReadOnlyList<CommandRunResult> verifyResults = [];
    private IReadOnlyList<CommandRunResult> commitResults = [];
    private IReadOnlyList<CommandRunResult> buildDeployResults = [];
    private IReadOnlyList<AgentModeProfile> agentModeProfiles = [];
    private IReadOnlyList<AgentRunRecord> agentRunHistory = [];
    private IReadOnlyList<PatchPackage> patchPackages = [];
    private IReadOnlyList<LocalCoderHistoryEntry> historyEntries = [];
    private object? grid1;
    private object? grid2;

    private List<LocalCoderFileContext> fileContexts = [];
    private List<string> selectedFilePaths = [];
    private List<FileSearchItem> selectedFiles = [];

    private AiBox.DevPortal.Models.LocalCoderTask? currentTask;
    private LocalCoderPatchPreview? patchPreview;
    private LocalCoderPatchApplyResult? applyResult;
    private LocalCoderPatchRollbackResult? rollbackResult;
    private CommandRunResult? lastCommand;
    private LocalCoderHistoryEntry? selectedHistoryEntry;
    private AgentRunRecord? selectedAgentRun;
    private PatchPackage? selectedPatchPackage;
    private string commitMessage = string.Empty;
    private string LastPatchRawResponse { get; set; } = string.Empty;
    private string LastPatchNormalizedDiff { get; set; } = string.Empty;
    private IReadOnlyList<string> LastPatchValidationErrors { get; set; } = [];

    private bool isLoading;
    private bool isPlanning;
    private bool isGeneratingPatch;
    private bool isApplyingPatch;
    private bool isRollingBack;
    private bool isRunningCommand;
    private bool isVerifying;
    private bool isCommitRunning;
    private bool isBuildDeployRunning;
    private bool isLoadingHistory;
    private bool isClearingHistory;

    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            workspaceRoots = await CoderConsoleService.GetWorkspaceRootsAsync();
            models = await CoderConsoleService.GetOllamaModelsAsync();

            if (string.IsNullOrWhiteSpace(request.ProjectPath))
            {
                request.ProjectPath = workspaceRoots.FirstOrDefault(IsDevPortalProjectRoot)
                    ?? workspaceRoots.FirstOrDefault()
                    ?? string.Empty;
            }
            
Console.WriteLine($"Available workspaceRoots: {string.Join(", ", workspaceRoots)}");
            if (string.IsNullOrWhiteSpace(request.Model) || !models.Contains(request.Model, StringComparer.OrdinalIgnoreCase))
            {
                request.Model = models.Contains("qwen2.5-coder:7b", StringComparer.OrdinalIgnoreCase)
                    ? "qwen2.5-coder:7b"
                    : models.FirstOrDefault() ?? request.Model;
            }

            agentModeProfiles = await AgentModeProfiles.GetAllAsync();
            await LoadAgentRunHistoryAsync();
            await LoadPatchQueueAsync();
            await LoadHistoryAsync();
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static bool IsDevPortalProjectRoot(string path)
    {
        return !string.IsNullOrWhiteSpace(path) &&
               File.Exists(Path.Combine(path, "AiBox.DevPortal.csproj"));
    }

    private Task OnProjectPathChanged(object? value)
    {
        request.ProjectPath = value?.ToString() ?? string.Empty;
        ClearSelectedFiles();
        currentTask = null;
        patchPreview = null;
        ClearPatchDebug();
        lastCommand = null;
        verifyResults = [];
        commitResults = [];
        buildDeployResults = [];
        rollbackResult = null;
        selectedHistoryEntry = null;
        selectedAgentRun = null;
        selectedPatchPackage = null;

        error = null;
        return Task.CompletedTask;
    }

    private async Task PreviewContextAsync()
    {
        error = null;

        try
        {
            if (!await EnsureFileContextLoadedAsync())
            {
                return;
            }
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Preview context failed",
                exception.Message);
        }
    }

    private Task ClearSelectedFilesAsync()
    {
        ClearSelectedFiles();

        NotificationService.Notify(
            NotificationSeverity.Info,
            "Selected files cleared",
            "The file selection list was cleared.");

        return Task.CompletedTask;
    }

    private Task ClearContextAsync()
    {
        ClearLoadedContext();

        NotificationService.Notify(
            NotificationSeverity.Info,
            "Context cleared",
            "Loaded file context was cleared.");

        return Task.CompletedTask;
    }

    private void ClearSelectedFiles()
    {
        selectedFilePaths = [];
        selectedFiles = [];
        ClearLoadedContext();
        patchPreview = null;
        ClearPatchDebug();
    }

    private void ClearLoadedContext()
    {
        fileContexts = [];
        request.FileContexts = [];
        patchPreview = null;
        applyResult = null;
        rollbackResult = null;
        ClearPatchDebug();
    }

    private async Task CreatePlanAsync()
    {
        isPlanning = true;
        error = null;
        currentTask = null;
        lastCommand = null;

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForCreatePlan());
            if (!await EnsureFileContextLoadedAsync())
            {
                await SaveHistoryEntryAsync(
                    LocalCoderHistoryActionType.CreatePlan,
                    success: false,
                    "Select files before creating a plan.");
                return;
            }

            currentTask = await AgentModeRunner.CreatePlanAsync(request, profile);
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.CreatePlan,
                success: true,
                "Plan created.",
                planText: currentTask!.Plan,
                model: profile.Model);

            NotificationService.Notify(
                NotificationSeverity.Success,
                "Plan created",
                $"Local coder generated a plan with {request.FileContexts.Count} file context(s).");
        }
        catch (Exception exception)
        {
            error = exception.Message;
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.CreatePlan,
                success: false,
                exception.Message);

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Local coder failed",
                exception.Message);
        }
        finally
        {
            isPlanning = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private async Task GeneratePatchPreviewAsync()
    {
        isGeneratingPatch = true;
        error = null;
        currentTask = null;
        patchPreview = null;
        applyResult = null;
        rollbackResult = null;
        ClearPatchDebug();

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForGeneratePatchPreview());
            if (!await EnsureFileContextLoadedAsync())
            {
                await SaveHistoryEntryAsync(
                    LocalCoderHistoryActionType.GeneratePatchPreview,
                    success: false,
                    "Select files before generating a patch preview.");
                return;
            }

            patchPreview = await AgentModeRunner.GeneratePatchPreviewAsync(request, profile);
            ClearPatchDebug();
            try
            {
                selectedPatchPackage = await PatchPackageService.CreateFromPreviewAsync(patchPreview!, request.Task);
                await LoadPatchQueueAsync();
            }
            catch (Exception packageException)
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Patch queue save failed",
                    packageException.Message);
            }
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.GeneratePatchPreview,
                success: true,
                "Patch preview created.",
                patchPreviewText: patchPreview!.PatchText,
                model: profile.Model);
            NotificationService.Notify(
                NotificationSeverity.Success,
                "Patch preview created",
                "Local coder generated a patch preview for the selected context.");
        }
        catch (PatchPreviewValidationException exception)
        {
            error = exception.Message;
            LastPatchRawResponse = exception.RawModelResponse;
            LastPatchNormalizedDiff = exception.NormalizedDiff;
            LastPatchValidationErrors = exception.ValidationErrors.ToArray();

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.GeneratePatchPreview,
                success: false,
                exception.Message);

            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Patch preview rejected",
                exception.Message);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
            ClearPatchDebug();
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.GeneratePatchPreview,
                success: false,
                exception.Message);

            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Patch preview rejected",
                exception.Message);
        }
        catch (Exception exception)
        {
            error = exception.Message;
            ClearPatchDebug();
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.GeneratePatchPreview,
                success: false,
                exception.Message);

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Patch preview failed",
                exception.Message);
        }
        finally
        {
            isGeneratingPatch = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private void ClearPatchDebug()
    {
        LastPatchRawResponse = string.Empty;
        LastPatchNormalizedDiff = string.Empty;
        LastPatchValidationErrors = [];
    }

    private async Task ApplyPatchAsync()
    {
        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForApplyPatch());
            NotificationService.Notify(
                NotificationSeverity.Info,
                "Apply Patch clicked",
                "Starting patch apply...");
            StateHasChanged();
            Console.WriteLine("Apply Patch clicked. Starting patch apply...");
            if (!CanApplyPatchPreview() || patchPreview is null)
            {
                throw new InvalidOperationException("Generate and review an applicable patch preview before applying it.");
            }
            Console.WriteLine("APPLY STEP 1: handler reached.");
            var confirmed = await DialogService.Confirm(
                "Apply this patch to selected files? Backups will be created first.",
                "Apply Patch",
                new ConfirmOptions { OkButtonText = "Apply Patch", CancelButtonText = "Cancel" });

            if (confirmed != true)
            {
                return;
            }

            isApplyingPatch = true;
            error = null;
            applyResult = null;
            rollbackResult = null;

            Console.WriteLine("APPLY STEP 2: calling ApplyPatchPreviewAsync.");

            applyResult = await AgentModeRunner.ApplyPatchPreviewAsync(patchPreview, profile);
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.ApplyPatch,
                success: applyResult.Applied && applyResult.VerificationPassed,
                applyResult.Message,
                applyResult: applyResult,
                model: profile.Model);

            Console.WriteLine("APPLY STEP 3: service returned.");
            Console.WriteLine($"APPLIED: {applyResult.Applied}");
            Console.WriteLine($"VERIFICATION PASSED: {applyResult.VerificationPassed}");
            Console.WriteLine($"MESSAGE: {applyResult.Message}");

            Console.WriteLine($"GIT APPLY EXIT: {applyResult.GitApplyResult?.ExitCode}");
            Console.WriteLine($"GIT APPLY COMMAND: {applyResult.GitApplyResult?.Command}");
            Console.WriteLine($"GIT APPLY STDOUT: {applyResult.GitApplyResult?.Output}");
            Console.WriteLine($"GIT APPLY STDERR: {applyResult.GitApplyResult?.Error}");

            Console.WriteLine($"GIT DIFF STAT EXIT: {applyResult.GitDiffStatResult?.ExitCode}");
            Console.WriteLine($"GIT DIFF STAT STDOUT: {applyResult.GitDiffStatResult?.Output}");
            Console.WriteLine($"GIT DIFF STAT STDERR: {applyResult.GitDiffStatResult?.Error}");

            Console.WriteLine($"CHANGED FILES DIFF EXIT: {applyResult.ChangedFilesDiffResult?.ExitCode}");
            Console.WriteLine($"CHANGED FILES DIFF STDOUT: {applyResult.ChangedFilesDiffResult?.Output}");
            Console.WriteLine($"CHANGED FILES DIFF STDERR: {applyResult.ChangedFilesDiffResult?.Error}");
            if (applyResult.Applied && applyResult.VerificationPassed)
            {
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Patch applied",
                    applyResult.Message);
            }
            else
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    applyResult.Applied ? "Verification failed" : "Patch apply failed",
                    applyResult.Message);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("APPLY STEP 3: handler reached.");
            error = ex.Message;
            var failedAt = DateTimeOffset.UtcNow;
            applyResult = new LocalCoderPatchApplyResult
            {
                Applied = false,
                VerificationPassed = false,
                Message = ex.ToString(),
                GitApplyResult = new CommandRunResult
                {
                    Command = "git apply --whitespace=fix <patchfile> (not completed)",
                    ExitCode = -1,
                    Error = ex.ToString(),
                    Started = failedAt,
                    Finished = failedAt
                }
            };

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.ApplyPatch,
                success: false,
                ex.Message,
                applyResult: applyResult);

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Patch apply failed",
                ex.Message);
        }
        finally
        {
            isApplyingPatch = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private bool CanApplyPatchPreview()
    {
        return !isApplyingPatch &&
               patchPreview is not null &&
               !patchPreview.PatchText.Contains("PATCH_NOT_POSSIBLE", StringComparison.Ordinal);
    }

    private bool CanRollbackPatch()
    {
        return applyResult is not null &&
               applyResult.BackupFiles.Count > 0 &&
               !isRollingBack;
    }

    private async Task RollbackPatchAsync()
    {
        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForRollbackPatch());
            var confirmed = await DialogService.Confirm(
                "Restore files from backup and undo this patch?",
                "Rollback Patch",
                new ConfirmOptions { OkButtonText = "Rollback Patch", CancelButtonText = "Cancel" });

            if (confirmed != true || applyResult is null)
            {
                return;
            }

            isRollingBack = true;
            error = null;
            rollbackResult = null;

            rollbackResult = await AgentModeRunner.RollbackPatchAsync(applyResult, request.ProjectPath, profile);
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.RollbackPatch,
                success: rollbackResult.RolledBack && rollbackResult.VerificationPassed,
                rollbackResult.Message,
                applyResult: applyResult,
                rollbackResult: rollbackResult,
                model: profile.Model);

            if (rollbackResult.RolledBack && rollbackResult.VerificationPassed)
            {
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Rollback completed",
                    rollbackResult.Message);
            }
            else
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Rollback completed with issues",
                    rollbackResult.Message);
            }
        }
        catch (Exception exception)
        {
            error = exception.Message;
            rollbackResult = new LocalCoderPatchRollbackResult
            {
                RolledBack = false,
                VerificationPassed = false,
                Message = exception.ToString(),
                RestoredFiles = [],
                VerificationResults = []
            };

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.RollbackPatch,
                success: false,
                exception.Message,
                applyResult: applyResult,
                rollbackResult: rollbackResult);

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Rollback failed",
                exception.Message);
        }
        finally
        {
            isRollingBack = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private async Task RunCommandAsync(string command)
    {
        isRunningCommand = true;
        error = null;

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForRunCommand());
            lastCommand = await AgentModeRunner.RunCommandAsync(
                request.ProjectPath,
                command,
                profile);

            var severity = lastCommand.ExitCode == 0
                ? NotificationSeverity.Success
                : NotificationSeverity.Warning;

            NotificationService.Notify(
                severity,
                "Command finished",
                $"{command}: exit {lastCommand.ExitCode}");
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Command failed",
                exception.Message);
        }
        finally
        {
            isRunningCommand = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private async Task VerifyProjectAsync()
    {
        isVerifying = true;
        error = null;
        verifyResults = [];

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForVerifyProject());
            verifyResults = await AgentModeRunner.VerifyProjectAsync(request.ProjectPath, profile);

            var failed = verifyResults.FirstOrDefault(x => x.ExitCode != 0);

            if (failed is null)
            {
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Verification passed",
                    "git status, dotnet build, and dotnet test completed.");
            }
            else
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Verification failed",
                    $"{failed.Command}: exit {failed.ExitCode}");
            }

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.VerifyProject,
                success: failed is null,
                failed is null ? "Verification passed." : $"{failed.Command}: exit {failed.ExitCode}",
                verificationResults: verifyResults,
                model: profile.Model);
        }
        catch (Exception exception)
        {
            error = exception.Message;
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.VerifyProject,
                success: false,
                exception.Message,
                verificationResults: verifyResults);

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Verification failed",
                exception.Message);
        }
        finally
        {
            isVerifying = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private bool CanCommitChanges()
    {
        return !isRunningCommand &&
               !isVerifying &&
               !isCommitRunning &&
               !string.IsNullOrWhiteSpace(request.ProjectPath);
    }

    private bool CanBuildDeploy()
    {
        return !isRunningCommand &&
               !isVerifying &&
               !isBuildDeployRunning &&
               !string.IsNullOrWhiteSpace(request.ProjectPath);
    }

    private async Task CommitChangesAsync()
    {
        isCommitRunning = true;
        error = null;
        commitResults = [];

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForCommitChanges());
            var results = await AgentModeRunner.CommitChangesAsync(
                request.ProjectPath,
                commitMessage.Trim(),
                profile);

            commitResults = results;

            var statusResult = results.FirstOrDefault(result => result.Command == "git status --short");
            var noChanges = statusResult is not null &&
                            statusResult.ExitCode == 0 &&
                            string.IsNullOrEmpty(statusResult.Output);
            var failed = results.FirstOrDefault(result => result.ExitCode != 0);
            var success = !noChanges && failed is null;

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.CommitChanges,
                success: success,
                noChanges
                    ? "No changes to commit."
                    : success ? "Commit and deploy completed." : "Commit or deploy failed.",
                verificationResults: results,
                model: profile.Model);

            if (noChanges)
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "No changes to commit",
                    "No changes to commit.");
                return;
            }

            if (failed is null)
            {
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Commit and deploy completed",
                    "Commit and deploy completed.");
            }
            else
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Commit or deploy failed",
                    $"{failed.Command}: exit {failed.ExitCode}");
            }
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Commit failed",
                exception.Message);
        }
        finally
        {
            isCommitRunning = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private async Task BuildDeployAsync()
    {
        isBuildDeployRunning = true;
        error = null;
        buildDeployResults = [];

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForBuildDeploy());
            var results = await AgentModeRunner.BuildDeployAsync(request.ProjectPath, profile);

            buildDeployResults = results;

            var success = results.Count > 0 && results.All(result => result.ExitCode == 0);

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.BuildDeploy,
                success: success,
                success ? "Build and deploy completed." : "Build or deploy failed.",
                verificationResults: results,
                model: profile.Model);

            var failed = results.FirstOrDefault(result => result.ExitCode != 0);
            if (failed is null)
            {
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Build and deploy completed",
                    "dotnet build and docker compose completed successfully.");
            }
            else
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Build or deploy failed",
                    $"{failed.Command}: exit {failed.ExitCode}");
            }
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Build and deploy failed",
                exception.Message);
        }
        finally
        {
            isBuildDeployRunning = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private Task OnSelectedFilesChanged(IReadOnlyList<FileSearchItem> files)
    {
        selectedFiles = files.ToList();
        selectedFilePaths = selectedFiles
            .Select(file => file.RelativePath)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        ClearLoadedContext();
        error = null;
        return Task.CompletedTask;
    }

    private Task OnFileSelected(FileSearchItem? file)
    {
        if (file is not null && !selectedFilePaths.Contains(file.RelativePath, StringComparer.OrdinalIgnoreCase))
        {
            selectedFilePaths.Add(file.RelativePath);
            ClearLoadedContext();
        }

        return Task.CompletedTask;
    }

    private async Task<bool> EnsureFileContextLoadedAsync()
    {
        if (fileContexts.Count > 0)
        {
            request.FileContexts = fileContexts.ToList();
            return true;
        }

        if (selectedFilePaths.Count == 0)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "No files selected",
                "Select files before creating a plan or patch preview.");

            return false;
        }

        fileContexts = (await CoderConsoleService.ReadFileContextsAsync(
                request.ProjectPath,
                selectedFilePaths.ToArray()))
            .ToList();

        request.FileContexts = fileContexts.ToList();

        NotificationService.Notify(
            NotificationSeverity.Info,
            "Context auto-loaded",
            $"{fileContexts.Count} file(s) loaded into context.");

        return true;
    }

    private string GetProjectFilesStatusText()
    {
        if (string.IsNullOrWhiteSpace(request.ProjectPath))
        {
            return "Select a project path to search for files.";
        }

        if (isLoading)
        {
            return "Loading project settings...";
        }

        return $"Selected files: {selectedFilePaths.Count}. Use the file picker to add more files.";
    }

