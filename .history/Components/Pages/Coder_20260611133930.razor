    }

    private Task OnPatchPackageSelected(PatchPackage package)
    {
        selectedPatchPackage = package;
        return Task.CompletedTask;
    }

    private bool CanReviewSelectedPatch()
    {
        return selectedPatchPackage is not null && !isCommitRunning && !isBuildDeployRunning && !isApplyingPatch;
    }

    private bool CanApproveSelectedPatch()
    {
        return selectedPatchPackage is not null &&
               selectedPatchPackage.Status is PatchPackageStatus.Draft or PatchPackageStatus.Reviewed &&
               !isCommitRunning &&
               !isBuildDeployRunning &&
               !isApplyingPatch;
    }

    private bool CanApplySelectedPatch()
    {
        return selectedPatchPackage is not null &&
               selectedPatchPackage.Status == PatchPackageStatus.Approved &&
               selectedPatchPackage.ApprovalGatesPassed &&
               !isApplyingPatch &&
               !isRollingBack;
    }

    private bool CanRollbackSelectedPatch()
    {
        return selectedPatchPackage is not null &&
               selectedPatchPackage.Status == PatchPackageStatus.Applied &&
               !selectedPatchPackage.RolledBack &&
               !isApplyingPatch &&
               !isRollingBack &&
               !isCommitRunning &&
               !isBuildDeployRunning;
    }

    private bool CanVerifySelectedPatch()
    {
        return selectedPatchPackage is not null &&
               !isVerifying &&
               !isRunningCommand;
    }

    private async Task ReviewSelectedPatchAsync()
    {
        if (selectedPatchPackage is null)
        {
            return;
        }

        try
        {
            selectedPatchPackage = await PatchPackageService.UpdateStatusAsync(
                selectedPatchPackage.Id,
                PatchPackageStatus.Reviewed,
                "Patch reviewed.");
            await LoadPatchQueueAsync();
            NotificationService.Notify(
                NotificationSeverity.Success,
                "Patch reviewed",
                selectedPatchPackage?.Id ?? string.Empty);
        }
        catch (Exception exception)
        {
            error = exception.Message;
            NotificationService.Notify(NotificationSeverity.Error, "Patch review failed", exception.Message);
        }
    }

    private async Task ApproveSelectedPatchAsync()
    {
        if (selectedPatchPackage is null)
        {
            return;
        }

        try
        {
            selectedPatchPackage = await PatchPackageService.ApproveAsync(selectedPatchPackage.Id);
            await LoadPatchQueueAsync();
            NotificationService.Notify(
                NotificationSeverity.Success,
                "Patch approved",
                selectedPatchPackage?.Id ?? string.Empty);
        }
        catch (Exception exception)
        {
            error = exception.Message;
            NotificationService.Notify(NotificationSeverity.Error, "Patch approval failed", exception.Message);
        }
    }

    private async Task ApplySelectedPatchAsync()
    {
        if (selectedPatchPackage is null)
        {
            return;
        }

        try
        {
            selectedPatchPackage = await PatchApplyService.ApplyAsync(selectedPatchPackage.Id);
            await LoadPatchQueueAsync();
            NotificationService.Notify(
                NotificationSeverity.Success,
                "Patch applied",
                selectedPatchPackage?.StatusMessage ?? "Applied.");
        }
        catch (Exception exception)
        {
            error = exception.Message;
            await PatchPackageService.UpdateStatusAsync(
                selectedPatchPackage.Id,
                PatchPackageStatus.Failed,
                exception.Message);
            await LoadPatchQueueAsync();
            NotificationService.Notify(NotificationSeverity.Error, "Patch apply failed", exception.Message);
        }
    }

    private async Task RollbackSelectedPatchAsync()
    {
        if (selectedPatchPackage is null)
        {
            return;
        }

        try
        {
            isRollingBack = true;
            selectedPatchPackage = await PatchRollbackService.RollbackAsync(selectedPatchPackage.Id);
            await LoadPatchQueueAsync();
            NotificationService.Notify(
                NotificationSeverity.Success,
                "Patch rolled back",
                selectedPatchPackage?.RollbackResult ?? "Rollback completed.");
        }
        catch (Exception exception)
        {
            error = exception.Message;
            await LoadPatchQueueAsync();
            NotificationService.Notify(NotificationSeverity.Error, "Patch rollback failed", exception.Message);
        }
        finally
        {
            isRollingBack = false;
        }
    }

    private async Task VerifySelectedPatchAsync()
    {
        if (selectedPatchPackage is null)
        {
            return;
        }

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForVerifyProject());
            var results = await AgentModeRunner.VerifyProjectAsync(selectedPatchPackage.ProjectPath, profile);
            var failed = results.FirstOrDefault(result => result.ExitCode != 0);
            var status = failed is null ? PatchPackageStatus.Verified : PatchPackageStatus.Failed;
            var statusMessage = failed is null
                ? "Patch verification passed."
                : $"{failed.Command} exited {failed.ExitCode}";

            selectedPatchPackage = await PatchPackageService.UpdateStatusAsync(
                selectedPatchPackage.Id,
                status,
                statusMessage);
            await LoadPatchQueueAsync();

            NotificationService.Notify(
                failed is null ? NotificationSeverity.Success : NotificationSeverity.Warning,
                failed is null ? "Patch verified" : "Patch verification failed",
                statusMessage);
        }
        catch (Exception exception)
        {
            error = exception.Message;
            NotificationService.Notify(NotificationSeverity.Error, "Patch verification failed", exception.Message);
        }
    }

    private async Task ViewHistoryEntryAsync(string id)
    {
        selectedHistoryEntry = await LocalCoderHistoryService.GetEntryAsync(id);
    }

    private async Task UseHistoryEntryAsContextAsync()
    {
        if (selectedHistoryEntry is null)
        {
            return;
        }

        request.ProjectPath = selectedHistoryEntry.ProjectPath;
        if (!string.IsNullOrWhiteSpace(selectedHistoryEntry.Model))
        {
            request.Model = selectedHistoryEntry.Model;
        }

        selectedFilePaths = selectedHistoryEntry.SelectedFiles.ToList();
        selectedFiles = [];
        ClearLoadedContext();

        await EnsureFileContextLoadedAsync();

        var summary = BuildHistoryContextSummary(selectedHistoryEntry);
        request.Task = string.IsNullOrWhiteSpace(request.Task)
            ? summary
            : $"{request.Task.TrimEnd()}{Environment.NewLine}{Environment.NewLine}{summary}";

        NotificationService.Notify(
            NotificationSeverity.Success,
            "History context loaded",
            "The history entry was loaded into the current task context.");
    }

    private async Task ClearHistoryAsync()
    {
        var confirmed = await DialogService.Confirm(
            "Clear all Local Coder history entries?",
            "Clear History",
            new ConfirmOptions { OkButtonText = "Clear History", CancelButtonText = "Cancel" });

        if (confirmed != true)
        {
            return;
        }

        isClearingHistory = true;

        try
        {
            await LocalCoderHistoryService.ClearHistoryAsync();
            historyEntries = [];
            selectedHistoryEntry = null;

            NotificationService.Notify(
                NotificationSeverity.Success,
                "History cleared",
                "Local Coder history was cleared.");
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "History clear failed",
                exception.Message);
        }
        finally
        {
            isClearingHistory = false;
        }
    }

    private async Task SaveHistoryEntryAsync(
        LocalCoderHistoryActionType actionType,
        bool success,
        string message,
        string? planText = null,
        string? patchPreviewText = null,
        LocalCoderPatchApplyResult? applyResult = null,
        LocalCoderPatchRollbackResult? rollbackResult = null,
        IReadOnlyList<CommandRunResult>? verificationResults = null,
        string? model = null)
    {
        try
        {
            await LocalCoderHistoryService.AddEntryAsync(new LocalCoderHistoryEntry
            {
                ActionType = actionType,
                CreatedAt = DateTimeOffset.UtcNow,
                ProjectPath = request.ProjectPath,
                Model = model ?? request.Model,
                Task = request.Task,
                SelectedFiles = selectedFilePaths.ToArray(),
                LoadedContextFiles = request.FileContexts
                    .Select(fileContext => new LocalCoderHistoryFileSummary
                    {
                        RelativePath = fileContext.RelativePath,
                        CharacterCount = fileContext.CharacterCount
                    })
                    .ToArray(),
                PlanText = planText ?? string.Empty,
                PatchPreviewText = patchPreviewText ?? string.Empty,
                ApplyResult = applyResult,
                RollbackResult = rollbackResult,
                VerificationResults = verificationResults?.ToArray() ?? [],
                Success = success,
                Message = message
            });

            await LoadHistoryAsync();
        }
        catch (Exception exception)
        {
            Console.WriteLine($"History save failed: {exception}");
        }
    }

    private static string GetHistoryMessageSummary(string message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return string.Empty;
        }

        return message.Length <= 80 ? message : message[..77] + "...";
    }

    private static string GetHistoryStatusText(bool success)
    {
        return success ? "Success" : "Failed";
    }

    private static string BuildHistoryContextSummary(LocalCoderHistoryEntry entry)
    {
        var selectedFiles = entry.SelectedFiles.Count == 0
            ? "none"
            : string.Join(", ", entry.SelectedFiles);

        var resultStatus = entry.ActionType switch
        {
            LocalCoderHistoryActionType.ApplyPatch => entry.ApplyResult is null
                ? "n/a"
                : $"{entry.ApplyResult.Applied}, verification {entry.ApplyResult.VerificationPassed}",
            LocalCoderHistoryActionType.RollbackPatch => entry.RollbackResult is null
                ? "n/a"
                : $"{entry.RollbackResult.RolledBack}, verification {entry.RollbackResult.VerificationPassed}",
            LocalCoderHistoryActionType.VerifyProject => entry.VerificationResults.Count == 0
                ? "n/a"
                : entry.Success.ToString(),
            _ => entry.Success.ToString()
        };

        return string.Join(Environment.NewLine, new[]
        {
            "Previous Local Coder history context:",
            $"- Previous action: {entry.ActionType}",
            $"- Previous task: {entry.Task}",
            $"- Previous selected files: {selectedFiles}",
            $"- Previous result message: {entry.Message}",
            $"- Apply/rollback/verify passed: {resultStatus}"
        });
    }

    private AgentModeProfile GetRequiredProfile(AgentMode mode)
    {
        var profile = agentModeProfiles.FirstOrDefault(item => item.Mode == mode);

        if (profile is null)
        {
            throw new InvalidOperationException($"Agent mode profile is not configured for {mode}.");
        }

        return profile;
    }

    private IReadOnlyList<(string ActionLabel, AgentModeProfile Profile)> GetProfileRows()
    {
        var rows = new List<(string ActionLabel, AgentModeProfile Profile)>
        {
            ("Create Plan", GetRequiredProfile(AgentActionProfiles.ForCreatePlan())),
            ("Generate Patch Preview", GetRequiredProfile(AgentActionProfiles.ForGeneratePatchPreview())),
            ("Apply Patch", GetRequiredProfile(AgentActionProfiles.ForApplyPatch())),
            ("Rollback Patch", GetRequiredProfile(AgentActionProfiles.ForRollbackPatch())),
            ("Run Command", GetRequiredProfile(AgentActionProfiles.ForRunCommand())),
            ("Verify Project", GetRequiredProfile(AgentActionProfiles.ForVerifyProject())),
            ("Commit Changes", GetRequiredProfile(AgentActionProfiles.ForCommitChanges())),
            ("Build & Deploy", GetRequiredProfile(AgentActionProfiles.ForBuildDeploy())),
            ("Reviewer", GetRequiredProfile(AgentActionProfiles.ForReviewDiff()))
        };

        return rows;
    }
