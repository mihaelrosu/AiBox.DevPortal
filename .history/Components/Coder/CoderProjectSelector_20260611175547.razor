<RadzenRow AlignItems="AlignItems.Center">
    <RadzenColumn>
        <RadzenText Text="Local Coder" TextStyle="TextStyle.H4" />
        <RadzenText
            Text="Use a local Ollama model to plan code changes, generate patch previews, apply patches, rollback patches, and run safe verification commands."
            TextStyle="TextStyle.Body2" />
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenButton Text="Refresh" Icon="refresh" Click="@OnRefresh" Disabled="@IsLoading" Style="width: 100%;" />
    </RadzenColumn>
</RadzenRow>

<RadzenCard>
    <RadzenStack Gap="1rem">
        <RadzenFormField Text="Project path">
            <RadzenDropDown TValue="string" Value="@ProjectPath" ValueChanged="@ProjectPathChanged" Data="@WorkspaceRoots"
                            Style="width: 100%;" Placeholder="Select project folder" />
        </RadzenFormField>
        @ChildContent
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter] public string ProjectPath { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ProjectPathChanged { get; set; }
    [Parameter] public IReadOnlyList<string> WorkspaceRoots { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
