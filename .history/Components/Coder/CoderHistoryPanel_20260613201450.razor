<RadzenTabs Style="width: 100%;">
    <Tabs>
        <RadzenTabsItem Text="Agent Run History" Icon="history">
            @if (ShowAgentRunHistory)
            {
                <RadzenCard>
                    <RadzenStack Gap="0.75rem">
                        <RadzenText Text="Agent Run History" TextStyle="TextStyle.H5" />
                        <RadzenText Text="Newest runs appear first. Select a row to inspect the prompt and result text."
                                    TextStyle="TextStyle.Body2" />
                        <AppDataGrid Data="@AgentRunHistory" TItem="AgentRunRecord" PageSize="10"
                                     EmptyText="No agent runs recorded yet." RowSelect="@OnAgentRunSelected">
                            <Columns>
                                <RadzenDataGridColumn TItem="AgentRunRecord" Title="Timestamp">
                                    <Template Context="run">@run.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AgentRunRecord" Property="ActionKey" Title="Action" />
                                <RadzenDataGridColumn TItem="AgentRunRecord" Property="ProfileMode" Title="Profile" />
                                <RadzenDataGridColumn TItem="AgentRunRecord" Property="Model" Title="Model" />
                                <RadzenDataGridColumn TItem="AgentRunRecord" Title="Success">
                                    <Template Context="run">
                                        <RadzenBadge Text="@(run.Success ? "Success" : "Failed")"
                                                     BadgeStyle="@(run.Success ? BadgeStyle.Success : BadgeStyle.Warning)" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AgentRunRecord" Property="ErrorMessage" Title="Error" />
                            </Columns>
                        </AppDataGrid>
                        @if (SelectedAgentRun is not null)
                        {
                            <RadzenCard>
                                <RadzenStack Gap="0.5rem">
                                    <RadzenText Text="Selected Run" TextStyle="TextStyle.H6" />
                                    <RadzenText Text="@($"Action: {SelectedAgentRun.ActionKey}")" TextStyle="TextStyle.Body1" />
                                    <RadzenText Text="@($"Profile mode: {SelectedAgentRun.ProfileMode}")" TextStyle="TextStyle.Body1" />
                                    <RadzenText Text="@($"Model: {SelectedAgentRun.Model}")" TextStyle="TextStyle.Body1" />
                                    <RadzenText Text="@($"Timestamp: {SelectedAgentRun.Timestamp:O}")" TextStyle="TextStyle.Body1" />
                                    <RadzenText Text="@($"Success: {SelectedAgentRun.Success}")" TextStyle="TextStyle.Body1" />
                                    <RadzenText Text="@($"Error: {SelectedAgentRun.ErrorMessage}")" TextStyle="TextStyle.Body1" />
                                    <RadzenText Text="User Request" TextStyle="TextStyle.H6" />
                                    <pre class="coder-output">@SelectedAgentRun.UserRequest</pre>
                                    <RadzenText Text="Prompt Sent" TextStyle="TextStyle.H6" />
                                    <pre class="coder-output">@SelectedAgentRun.PromptSent</pre>
                                    <RadzenText Text="Result Text" TextStyle="TextStyle.H6" />
                                    <pre class="coder-output">@SelectedAgentRun.ResultText</pre>
                                </RadzenStack>
                            </RadzenCard>
                        }
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenTabsItem>

        <RadzenTabsItem Text="Task History" Icon="assignment">
            @if (ShowTaskHistory)
            {
                <RadzenCard>
                    <RadzenStack Gap="0.75rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                            <div>
                                <RadzenText Text="Task History" TextStyle="TextStyle.H5" />
                                <RadzenText Text="@($"Latest entries: {HistoryEntries.Count}")" TextStyle="TextStyle.Body2" />
                            </div>
                            <RadzenButton Text="Clear History" Icon="delete" ButtonStyle="ButtonStyle.Light"
                                          Click="@OnClearHistory"
                                          Disabled="@(IsLoadingHistory || IsClearingHistory || HistoryEntries.Count == 0)" />
                        </RadzenStack>

                        <AppDataGrid Data="@HistoryEntries" TItem="LocalCoderHistoryEntry" PageSize="10"
                                     EmptyText="No Local Coder history entries yet.">
                            <Columns>
                                <RadzenDataGridColumn TItem="LocalCoderHistoryEntry" Title="Timestamp">
                                    <Template Context="entry">@entry.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="LocalCoderHistoryEntry" Property="ActionType" Title="Action" />
                                <RadzenDataGridColumn TItem="LocalCoderHistoryEntry" Title="Status">
                                    <Template Context="entry">
                                        <RadzenBadge Text="@GetStatusText(entry.Success)"
                                                     BadgeStyle="@(entry.Success ? BadgeStyle.Success : BadgeStyle.Warning)" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="LocalCoderHistoryEntry" Title="Summary">
                                    <Template Context="entry">
                                        <RadzenStack Gap="0.15rem">
                                            <RadzenText Text="@entry.Message" TextStyle="TextStyle.Body2" />
                                            @if (entry.ContextFileCount > 0)
                                            {
                                                <RadzenText Text="@($"Context: {entry.ContextFileCount} files | ~{entry.ContextEstimatedTokens:N0} tokens")"
                                                            TextStyle="TextStyle.Caption" />
                                            }
                                        </RadzenStack>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="LocalCoderHistoryEntry" Title="Actions">
                                    <Template Context="entry">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem" Wrap="FlexWrap.Wrap">
                                            <RadzenButton Text="View" Icon="open_in_new" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                                          Click="@(() => OnViewHistoryEntry.InvokeAsync(entry.Id))" />
                                            <RadzenButton Text="Use Again" Icon="repeat" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                          Click="@(() => OnUseAgainAsync(entry.Id))" />
                                            <RadzenButton Text="Restore" Icon="restore" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary"
                                                          Click="@(() => OnRestoreAsync(entry.Id))" />
                                        </RadzenStack>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </AppDataGrid>

                        <CoderHistoryRunDetails Entry="@SelectedHistoryEntry"
                                                OnUseAsContext="@OnUseHistoryEntryAsContext"
                                                OnRestoreContext="@OnRestoreContext"
                                                ContextRestoreResult="@ContextRestoreResult" />
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {
    [Parameter] public bool ShowAgentRunHistory { get; set; }
    [Parameter] public IReadOnlyList<AgentRunRecord> AgentRunHistory { get; set; } = [];
    [Parameter] public AgentRunRecord? SelectedAgentRun { get; set; }
    [Parameter] public EventCallback<AgentRunRecord> OnAgentRunSelected { get; set; }
    [Parameter] public bool ShowTaskHistory { get; set; }
    [Parameter] public IReadOnlyList<LocalCoderHistoryEntry> HistoryEntries { get; set; } = [];
    [Parameter] public LocalCoderHistoryEntry? SelectedHistoryEntry { get; set; }
    [Parameter] public bool IsLoadingHistory { get; set; }
    [Parameter] public bool IsClearingHistory { get; set; }
    [Parameter] public EventCallback OnClearHistory { get; set; }
    [Parameter] public EventCallback<string> OnViewHistoryEntry { get; set; }
    [Parameter] public EventCallback OnUseHistoryEntryAsContext { get; set; }
    [Parameter] public EventCallback OnRestoreContext { get; set; }
    [Parameter] public LocalCoderContextRestoreResult? ContextRestoreResult { get; set; }

    private static string GetStatusText(bool success) => success ? "Success" : "Failed";

    private async Task OnUseAgainAsync(string id)
    {
        await OnViewHistoryEntry.InvokeAsync(id);
        await OnUseHistoryEntryAsContext.InvokeAsync();
    }

    private async Task OnRestoreAsync(string id)
    {
        await OnViewHistoryEntry.InvokeAsync(id);
        await OnRestoreContext.InvokeAsync();
    }
}
