@typeparam TItem

<RadzenDataGrid TItem="TItem"
                Data="@Data"
                FilterMode="@FilterMode"
                AllowVirtualization="@AllowVirtualization"
                AllowPaging="@AllowPaging"
                AllowSorting="@AllowSorting"
                ShowPagingSummary="@ShowPagingSummary"
                AllowColumnResize="@AllowColumnResize"
                AllowFiltering="@AllowFiltering"
                PagerPosition="@PagerPosition"
                RowSelect="@RowSelect"
                IsLoading="@IsLoading"
                PageSize="@PageSize"
                EmptyText="@EmptyText"
                @attributes="AdditionalAttributes">
    <Columns>
        @Columns
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter] public IEnumerable<TItem>? Data { get; set; }

    [Parameter] public RenderFragment? Columns { get; set; }

    @* [Parameter] public FilterMode FilterMode { get; set; } //= FilterMode.Simple; *@

    [Parameter] public bool AllowVirtualization { get; set; } = false;

    [Parameter] public bool AllowPaging { get; set; } = true;

    [Parameter] public bool AllowSorting { get; set; } = true;

    [Parameter] public bool ShowPagingSummary { get; set; } = true;

    [Parameter] public bool AllowColumnResize { get; set; } = true;

    [Parameter] public bool AllowFiltering { get; set; } = true;

    [Parameter] public PagerPosition PagerPosition { get; set; } = PagerPosition.TopAndBottom;

    [Parameter] public EventCallback<TItem> RowSelect { get; set; }

    [Parameter] public bool IsLoading { get; set; }

    [Parameter] public int PageSize { get; set; }

    [Parameter] public string? EmptyText { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
