@using AiBox.DevPortal.Models
@using AiBox.DevPortal.Services
@inject IFileSearchService FileSearchService

<RadzenStack Gap="0.75rem" Style="@Style">
    <RadzenAutoComplete TValue="string"
                        @bind-Value="@searchText"
                        Data="@searchResults"
                        TextProperty="DisplayText"
                        Placeholder="@Placeholder"
                        Style="width: 100%;"
                        LoadData="@OnLoadDataAsync"
                        SelectedItem="@selectedFile"
                        SelectedItemChanged="@OnSelectedItemChangedAsync"
                        MinLength="1"
                        FilterDelay="200"
                        OpenOnFocus="true" />

    @if (ShowSelectedInfo)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText Text="Selected Files" TextStyle="TextStyle.H6" />

                    @if (selectedFiles.Count > 0)
                    {
                        <RadzenButton Text="Clear"
                                      Icon="clear"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Light"
                                      Click="@ClearSelectedFiles" />
                    }
                </RadzenStack>

                @if (selectedFiles.Count == 0)
                {
                    <RadzenText Text="No files selected yet." TextStyle="TextStyle.Body2" />
                }
                else
                {
                    @foreach (var file in selectedFiles)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween"
                                     Gap="0.75rem"
                                     Style="padding: 0.35rem 0.5rem; border: 1px solid var(--rz-base-300); border-radius: 0.35rem;">
                           
                                <RadzenText Text="@($"{file.RelativePath}")" TextStyle="TextStyle.Body2" />

                            <RadzenButton Text="Remove"
                                          Icon="close"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Light"
                                          Click="@(() => RemoveSelectedFile(file))" />
                        </RadzenStack>
                    }
                }
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@code {
    [Parameter] public string RootDirectory { get; set; } = string.Empty;

    [Parameter] public string SearchPattern { get; set; } = "*.*";

    [Parameter] public bool IncludeSubdirectories { get; set; } = true;

    [Parameter] public int MaxResults { get; set; } = 25;

    [Parameter] public string Placeholder { get; set; } = "Search file...";

    [Parameter] public string Style { get; set; } = "width:100%;";

    [Parameter] public bool ShowSelectedInfo { get; set; } = true;

    [Parameter] public FileSearchItem? SelectedFile { get; set; }

    [Parameter] public EventCallback<FileSearchItem?> SelectedFileChanged { get; set; }

    [Parameter] public IReadOnlyList<FileSearchItem> SelectedFiles { get; set; } = [];

    [Parameter] public EventCallback<IReadOnlyList<FileSearchItem>> SelectedFilesChanged { get; set; }

    [Parameter] public EventCallback<FileSearchItem?> FileSelected { get; set; }

    private List<FileSearchItem> searchResults = [];
    private List<FileSearchItem> selectedFiles = [];
    private string searchText = string.Empty;
    private FileSearchItem? selectedFile;
    private string? selectedFilePath;

    protected override void OnParametersSet()
    {
        if (!SelectedFiles.SequenceEqual(selectedFiles, new FileSearchItemPathComparer()))
        {
            selectedFiles = SelectedFiles.ToList();
        }

        if (!string.Equals(SelectedFile?.FullPath, selectedFilePath, StringComparison.OrdinalIgnoreCase))
        {
            selectedFile = SelectedFile;
            selectedFilePath = SelectedFile?.FullPath;
            searchText = SelectedFile?.DisplayText ?? string.Empty;
        }
    }

    private async Task OnLoadDataAsync(LoadDataArgs args)
    {
        var query = args.Filter ?? searchText;
        searchResults = await FileSearchService.SearchAsync(
            RootDirectory,
            query ?? string.Empty,
            SearchPattern,
            IncludeSubdirectories,
            MaxResults);

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            selectedFile = searchResults.FirstOrDefault(item =>
                item.DisplayText.Equals(searchText, StringComparison.OrdinalIgnoreCase));
        }
    }

    private async Task OnSelectedItemChangedAsync(object? value)
    {
        selectedFile = value as FileSearchItem;

        if (selectedFile is not null)
        {
            AddSelectedFile(selectedFile);
            searchText = string.Empty;
        }

        await EmitSelectionAsync(selectedFile);
    }

    private async Task EmitSelectionAsync(FileSearchItem? file)
    {
        selectedFilePath = file?.FullPath;

        if (SelectedFileChanged.HasDelegate)
        {
            await SelectedFileChanged.InvokeAsync(file);
        }

        if (FileSelected.HasDelegate)
        {
            await FileSelected.InvokeAsync(file);
        }
    }

    private void AddSelectedFile(FileSearchItem file)
    {
        if (selectedFiles.Any(item => item.FullPath.Equals(file.FullPath, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        selectedFiles.Add(file);
        _ = NotifySelectedFilesChangedAsync();
    }

    private void RemoveSelectedFile(FileSearchItem file)
    {
        selectedFiles.RemoveAll(item => item.FullPath.Equals(file.FullPath, StringComparison.OrdinalIgnoreCase));
        _ = NotifySelectedFilesChangedAsync();
    }

    private void ClearSelectedFiles()
    {
        selectedFiles.Clear();
        _ = NotifySelectedFilesChangedAsync();
    }

    private async Task NotifySelectedFilesChangedAsync()
    {
        if (SelectedFilesChanged.HasDelegate)
        {
            await SelectedFilesChanged.InvokeAsync(selectedFiles.ToList());
        }

        selectedFile = selectedFiles.LastOrDefault();
        selectedFilePath = selectedFile?.FullPath;
        await InvokeAsync(StateHasChanged);
    }

    private sealed class FileSearchItemPathComparer : IEqualityComparer<FileSearchItem>
    {
        public bool Equals(FileSearchItem? x, FileSearchItem? y)
        {
            return string.Equals(x?.FullPath, y?.FullPath, StringComparison.OrdinalIgnoreCase);
        }

        public int GetHashCode(FileSearchItem obj)
        {
            return StringComparer.OrdinalIgnoreCase.GetHashCode(obj.FullPath);
        }
    }
}
