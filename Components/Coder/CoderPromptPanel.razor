@ContextContent
<RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter">
    Model is selected by Agent Profile route, not by this page.
</RadzenAlert>

<RadzenFormField Text="Task">
    <RadzenTextArea Value="@Task" ValueChanged="@TaskChanged" Rows="6" Style="width: 100%;"
                    Placeholder="Example: review AiBox.DevPortal and suggest the next safe Local Coder improvement" />
</RadzenFormField>

<RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
    <RadzenButton Text="Create Plan" Icon="psychology" ButtonStyle="ButtonStyle.Primary" Click="@OnCreatePlan"
                  Disabled="@(IsLoading || IsPlanning || string.IsNullOrWhiteSpace(Task))" />

    <RadzenButton Text="Generate Patch Preview" Icon="difference" ButtonStyle="ButtonStyle.Warning"
                  Click="@OnGeneratePatchPreview"
                  Disabled="@(IsLoading || IsGeneratingPatch || string.IsNullOrWhiteSpace(Task))" />

    <RadzenButton Text="Verify Project" Icon="verified" ButtonStyle="ButtonStyle.Success" Click="@OnVerifyProject"
                  Disabled="@(!CanVerifyProject)" />

    <RadzenButton Text="Review Diff" Icon="rate_review" ButtonStyle="ButtonStyle.Light" Click="@OnReviewDiff"
                  Disabled="@(!CanReviewDiff)" />
</RadzenStack>

<RadzenText Text="Preview only. No files are modified automatically." TextStyle="TextStyle.Caption" />

@code {
    [Parameter] public RenderFragment? ContextContent { get; set; }

    [Parameter] public string Task { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TaskChanged { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsPlanning { get; set; }
    [Parameter] public bool IsGeneratingPatch { get; set; }
    [Parameter] public bool CanVerifyProject { get; set; }
    [Parameter] public bool CanReviewDiff { get; set; }
    [Parameter] public EventCallback OnCreatePlan { get; set; }
    [Parameter] public EventCallback OnGeneratePatchPreview { get; set; }
    [Parameter] public EventCallback OnVerifyProject { get; set; }
    [Parameter] public EventCallback OnReviewDiff { get; set; }
}
