@if (!string.IsNullOrWhiteSpace(Error))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true">@Error</RadzenAlert>
}

@if (string.IsNullOrWhiteSpace(Error) &&
     ValidationErrors.Count == 0 &&
     PatchPreview is null &&
     ApplyResult is null &&
     RollbackResult is null)
{
    <RadzenCard>
        <RadzenStack Gap="0.25rem">
            <RadzenText Text="No patch preview yet" TextStyle="TextStyle.H6" />
            <RadzenText Text="Generate a patch preview from the Work tab to inspect its diff and validation results here."
                        TextStyle="TextStyle.Body2" />
        </RadzenStack>
    </RadzenCard>
}

@if (ValidationErrors.Count > 0)
{
    <RadzenCard>
        <RadzenStack Gap="0.75rem">
                    <RadzenText Text="Patch Debug" TextStyle="TextStyle.H5" />
                    <div>
                        <RadzenText Text="Validation Errors" TextStyle="TextStyle.H6" />
                        <pre class="coder-error">@string.Join(Environment.NewLine, ValidationErrors.Select(errorText => $"- {errorText}"))</pre>
                    </div>
                    @if (ValidationGuidance.Count > 0)
                    {
                        <div>
                            <RadzenText Text="Safer Patch Suggestions" TextStyle="TextStyle.H6" />
                            <RadzenStack Gap="0.75rem">
                                @foreach (var guidance in ValidationGuidance)
                                {
                                    <RadzenCard>
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenBadge Text="@guidance.Category.ToString()"
                                                         BadgeStyle="@CategoryBadgeStyle(guidance.Category)" />
                                            <RadzenText Text="@($"Reason: {guidance.Reason}")" TextStyle="TextStyle.Body2" />
                                            <RadzenText Text="@($"Original operation: {guidance.OriginalOperation}")" TextStyle="TextStyle.Body2" />
                                            <RadzenText Text="@($"Safer operation: {guidance.SaferOperation}")" TextStyle="TextStyle.Body2" />
                                            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true">
                                                @guidance.SuggestedFix
                                            </RadzenAlert>
                                        </RadzenStack>
                                    </RadzenCard>
                        }
                    </RadzenStack>
                </div>
            }
            <div>
                <RadzenText Text="Raw Model Response" TextStyle="TextStyle.H6" />
                <pre class="coder-output">@RawResponse</pre>
            </div>
            <div>
                <RadzenText Text="Normalized Diff" TextStyle="TextStyle.H6" />
                <pre class="coder-output">@NormalizedDiff</pre>
            </div>
        </RadzenStack>
    </RadzenCard>
}

@if (PatchPreview is not null)
{
    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                <RadzenText Text="Patch Preview" TextStyle="TextStyle.H5" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <CopyToClipboardButton Text="Copy Patch" Value="@PatchPreview.PatchText" SuccessTitle="Patch copied"
                                           SuccessMessage="The patch preview was copied to the clipboard." />
                    <RadzenButton Text="Apply Patch" Icon="publish" ButtonStyle="ButtonStyle.Danger"
                                  Click="@OnApplyPatch" Disabled="@(!CanApplyPatch)" />
                </RadzenStack>
                <RadzenText Text="Preview only. No files are modified automatically." TextStyle="TextStyle.Caption" />
                <RadzenCard>
                    <RadzenStack Gap="0.75rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                            <RadzenText Text="Context Coverage" TextStyle="TextStyle.H6" />
                            <RadzenBadge Text="@($"Patch Risk: {PatchPreview.ContextCoverage.RiskScore}")"
                                         BadgeStyle="@RiskBadgeStyle(PatchPreview.ContextCoverage.RiskScore)" />
                        </RadzenStack>
                        @if (PatchPreview.ContextCoverage.HasFilesOutsideContext)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true">
                                This patch modifies files that were not provided to the model.
                            </RadzenAlert>
                        }
                        @foreach (var file in PatchPreview.ContextCoverage.Files)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                         JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                <RadzenText Text="@file.RelativePath" TextStyle="TextStyle.Body2" />
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                    <RadzenBadge Text="@CoverageBadgeText(file.Category)"
                                                 BadgeStyle="@CoverageBadgeStyle(file.Category)" />
                                    @foreach (var reason in file.RiskReasons)
                                    {
                                        <RadzenBadge Text="@reason" BadgeStyle="BadgeStyle.Warning" />
                                    }
                                </RadzenStack>
                            </RadzenStack>
                        }
                    </RadzenStack>
                </RadzenCard>
                <RadzenCard>
                    <RadzenStack Gap="0.75rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                            <RadzenText Text="Patch Intent" TextStyle="TextStyle.H6" />
                            <RadzenBadge Text="@ValidationStatusText(PatchPreview.IntentValidation?.Status)"
                                         BadgeStyle="@ValidationStatusBadgeStyle(PatchPreview.IntentValidation?.Status)" />
                        </RadzenStack>
                        @if (PatchPreview.Intent is not null)
                        {
                            <RadzenText Text="@($"Goal: {PatchPreview.Intent.Goal}")" TextStyle="TextStyle.Body2" />
                            <RadzenText Text="@($"Allowed scope: {PatchPreview.Intent.AllowedScope}")" TextStyle="TextStyle.Body2" />
                            <RadzenText Text="@($"Expected change type: {PatchPreview.Intent.ExpectedChangeType}")" TextStyle="TextStyle.Body2" />
                            <RadzenText Text="@($"Verification: {PatchPreview.Intent.VerificationCommand}")" TextStyle="TextStyle.Body2" />
                        }
                        @if (PatchPreview.IntentValidation is not null && PatchPreview.IntentValidation.Reasons.Count > 0)
                        {
                            <RadzenAlert AlertStyle="@(PatchPreview.IntentValidation.IsBlocking ? AlertStyle.Danger : AlertStyle.Warning)"
                                         ShowIcon="true">
                                @string.Join(" ", PatchPreview.IntentValidation.Reasons)
                            </RadzenAlert>
                        }
                        @if (PatchPreview.IntentValidation is not null)
                        {
                            <div>
                                <RadzenText Text="Debug output" TextStyle="TextStyle.Body2" />
                                <pre class="coder-output">Scope mode: @PatchPreview.IntentValidation.ScopeMode
Requested files: @(string.Join(", ", PatchPreview.IntentValidation.RequestedFiles))
Modified files: @(string.Join(", ", PatchPreview.IntentValidation.ModifiedFiles))
Context files: @(string.Join(", ", PatchPreview.IntentValidation.ContextFiles))
Protected files: @(string.Join(", ", PatchPreview.IntentValidation.ProtectedFiles))
Result: @ValidationStatusText(PatchPreview.IntentValidation.Status)</pre>
                            </div>
                        }
                    </RadzenStack>
                </RadzenCard>
                <RadzenCard>
                    <RadzenStack Gap="0.75rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                            <RadzenText Text="Patch Scope" TextStyle="TextStyle.H6" />
                            <RadzenBadge Text="@ScopeModeText(PatchPreview.AllowedPatchScope)"
                                         BadgeStyle="@ScopeModeBadgeStyle(PatchPreview.AllowedPatchScope)" />
                        </RadzenStack>
                        @if (!string.IsNullOrWhiteSpace(PatchPreview.ScopeAnalysis.WarningMessage))
                        {
                            <RadzenAlert AlertStyle="@(PatchPreview.ScopeAnalysis.IsBlocking ? AlertStyle.Danger : AlertStyle.Warning)"
                                         ShowIcon="true">
                                @PatchPreview.ScopeAnalysis.WarningMessage
                            </RadzenAlert>
                        }
                        @if (PatchPreview.ScopeAnalysis.AllowedFolders.Count > 0)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem" Wrap="FlexWrap.Wrap">
                                @foreach (var folder in PatchPreview.ScopeAnalysis.AllowedFolders)
                                {
                                    <RadzenBadge Text="@folder" BadgeStyle="BadgeStyle.Light" />
                                }
                            </RadzenStack>
                        }
                        @foreach (var file in PatchPreview.ScopeAnalysis.Files)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                         JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                <RadzenText Text="@file.RelativePath" TextStyle="TextStyle.Body2" />
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                    <RadzenBadge Text="@ScopeStatusText(file.Status)"
                                                 BadgeStyle="@ScopeStatusBadgeStyle(file.Status)" />
                                    @if (!string.IsNullOrWhiteSpace(file.Reason))
                                    {
                                        <RadzenBadge Text="@file.Reason" BadgeStyle="BadgeStyle.Warning" />
                                    }
                                </RadzenStack>
                            </RadzenStack>
                        }
                    </RadzenStack>
                </RadzenCard>
                <pre class="coder-output">@PatchPreview.PatchText</pre>
                @if (ApplyResult is not null)
                {
                    <RadzenText Text="Apply Patch Message" TextStyle="TextStyle.H6" />
                    <pre class="coder-output">@ApplyResult.Message</pre>
                }
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>
}

@if (ApplyResult is not null)
{
    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenText Text="Patch Apply Result" TextStyle="TextStyle.H5" />
            @if (!ApplyResult.Applied || !ApplyResult.VerificationPassed)
            {
                <RadzenCard>
                    <RadzenStack Gap="0.75rem">
                        <RadzenText Text="Patch Blocked" TextStyle="TextStyle.H6" />
                        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true">
                            @ApplyResult.Message
                        </RadzenAlert>
                        <div>
                            <RadzenText Text="Reason" TextStyle="TextStyle.Body2" />
                            <RadzenText Text="@ApplyResult.Message" TextStyle="TextStyle.Body1" />
                        </div>
                        <div>
                            <RadzenText Text="Requested Intent" TextStyle="TextStyle.Body2" />
                            <RadzenText Text="@DescribeRequestedIntent()" TextStyle="TextStyle.Body1" />
                        </div>
                        <div>
                            <RadzenText Text="Modified Files" TextStyle="TextStyle.Body2" />
                            @foreach (var file in ModifiedFiles())
                            {
                                <RadzenText Text="@file" TextStyle="TextStyle.Body1" />
                            }
                        </div>
                        <div>
                            <RadzenText Text="Protected Files" TextStyle="TextStyle.Body2" />
                            @if (ProtectedFiles().Count == 0)
                            {
                                <RadzenText Text="None" TextStyle="TextStyle.Body1" />
                            }
                            else
                            {
                                @foreach (var file in ProtectedFiles())
                                {
                                    <RadzenText Text="@file" TextStyle="TextStyle.Body1" />
                                }
                            }
                        </div>
                        <div>
                            <RadzenText Text="Scope Result" TextStyle="TextStyle.Body2" />
                            <RadzenText Text="@DescribeScopeResult()" TextStyle="TextStyle.Body1" />
                        </div>
                        <div>
                            <RadzenText Text="Intent Result" TextStyle="TextStyle.Body2" />
                            <RadzenText Text="@DescribeIntentResult()" TextStyle="TextStyle.Body1" />
                        </div>
                        <details>
                            <summary>Show Technical Details</summary>
                            <pre class="coder-error">@TechnicalDetails()</pre>
                        </details>
                    </RadzenStack>
                </RadzenCard>
            }
            else
            {
                <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true">@ApplyResult.Message</RadzenAlert>
                @if (CanRollbackPatch)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        <RadzenButton Text="Rollback Patch" Icon="undo" ButtonStyle="ButtonStyle.Warning"
                                      Click="@OnRollbackPatch" Disabled="@IsRollingBack" />
                    </RadzenStack>
                }
                <RadzenText Text="@($"Project path: {PatchPreview?.ProjectPath}")" TextStyle="TextStyle.Body1" />
                <RadzenText Text="@($"Applied: {ApplyResult.Applied}")" TextStyle="TextStyle.Body1" />
                <RadzenText Text="@($"Verification passed: {ApplyResult.VerificationPassed}")" TextStyle="TextStyle.Body1" />
                <RadzenText Text="@($"Message: {ApplyResult.Message}")" TextStyle="TextStyle.Body1" />
                <RadzenText Text="Git Apply Result" TextStyle="TextStyle.H6" />
                @ResultCard(ApplyResult.GitApplyResult, true)
                <RadzenText Text="Git Diff Stat" TextStyle="TextStyle.H6" />
                @ResultCard(ApplyResult.GitDiffStatResult)
                <RadzenText Text="Changed Files Diff" TextStyle="TextStyle.H6" />
                @ResultCard(ApplyResult.ChangedFilesDiffResult)
                @if (ApplyResult.ChangedFiles.Count > 0)
                {
                    <RadzenText Text="Changed Files" TextStyle="TextStyle.H6" />
                    @foreach (var changedFile in ApplyResult.ChangedFiles)
                    {
                        <RadzenText Text="@changedFile" TextStyle="TextStyle.Body2" />
                    }
                }
                @if (ApplyResult.BackupFiles.Count > 0)
                {
                    <RadzenText Text="Backup Files" TextStyle="TextStyle.H6" />
                    @foreach (var backupFile in ApplyResult.BackupFiles)
                    {
                        <RadzenText Text="@backupFile" TextStyle="TextStyle.Body2" />
                    }
                }
                @VerificationResults(ApplyResult.VerificationResults)
            }
        </RadzenStack>
    </RadzenCard>
}

@if (RollbackResult is not null)
{
    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenText Text="Patch Rollback Result" TextStyle="TextStyle.H5" />
            <RadzenAlert AlertStyle="@(RollbackResult.RolledBack && RollbackResult.VerificationPassed ? AlertStyle.Success : AlertStyle.Warning)"
                         ShowIcon="true">@RollbackResult.Message</RadzenAlert>
            <RadzenText Text="@($"Rolled back: {RollbackResult.RolledBack}")" TextStyle="TextStyle.Body1" />
            <RadzenText Text="@($"Verification passed: {RollbackResult.VerificationPassed}")" TextStyle="TextStyle.Body1" />
            <RadzenText Text="Restored Files" TextStyle="TextStyle.H6" />
            @foreach (var restoredFile in RollbackResult.RestoredFiles)
            {
                <RadzenText Text="@restoredFile" TextStyle="TextStyle.Body2" />
            }
            @VerificationResults(RollbackResult.VerificationResults)
        </RadzenStack>
    </RadzenCard>
}

@code {
    [Parameter] public string? Error { get; set; }
    [Parameter] public IReadOnlyList<string> ValidationErrors { get; set; } = [];
    [Parameter] public IReadOnlyList<PatchValidationGuidance> ValidationGuidance { get; set; } = [];
    [Parameter] public string RawResponse { get; set; } = string.Empty;
    [Parameter] public string NormalizedDiff { get; set; } = string.Empty;
    [Parameter] public LocalCoderPatchPreview? PatchPreview { get; set; }
    [Parameter] public LocalCoderPatchApplyResult? ApplyResult { get; set; }
    [Parameter] public LocalCoderPatchRollbackResult? RollbackResult { get; set; }
    [Parameter] public bool CanApplyPatch { get; set; }
    [Parameter] public bool CanRollbackPatch { get; set; }
    [Parameter] public bool IsRollingBack { get; set; }
    [Parameter] public EventCallback OnApplyPatch { get; set; }
    [Parameter] public EventCallback OnRollbackPatch { get; set; }

    private static BadgeStyle CategoryBadgeStyle(PatchValidationCategory category) => category switch
    {
        PatchValidationCategory.RazorMarkupRisk => BadgeStyle.Danger,
        PatchValidationCategory.HtmlStructureRisk => BadgeStyle.Warning,
        PatchValidationCategory.MissingAnchor => BadgeStyle.Info,
        PatchValidationCategory.AmbiguousAnchor => BadgeStyle.Warning,
        PatchValidationCategory.UnsafeFileOperation => BadgeStyle.Danger,
        _ => BadgeStyle.Secondary
    };

    private static string CoverageBadgeText(PatchContextCoverageCategory category) => category switch
    {
        PatchContextCoverageCategory.ContextFile => "✓ In Context",
        PatchContextCoverageCategory.RelatedFile => "⚠ Related",
        _ => "❌ Not In Context"
    };

    private static BadgeStyle CoverageBadgeStyle(PatchContextCoverageCategory category) => category switch
    {
        PatchContextCoverageCategory.ContextFile => BadgeStyle.Success,
        PatchContextCoverageCategory.RelatedFile => BadgeStyle.Warning,
        _ => BadgeStyle.Danger
    };

    private static string ScopeModeText(PatchScopeMode scopeMode) => scopeMode switch
    {
        PatchScopeMode.ContextFilesOnly => "Context Files Only",
        PatchScopeMode.SelectedFolders => "Selected Folders",
        PatchScopeMode.AnyProjectFile => "Any Project File",
        _ => "Context Files Only"
    };

    private static BadgeStyle ScopeModeBadgeStyle(PatchScopeMode scopeMode) => scopeMode switch
    {
        PatchScopeMode.ContextFilesOnly => BadgeStyle.Info,
        PatchScopeMode.SelectedFolders => BadgeStyle.Warning,
        PatchScopeMode.AnyProjectFile => BadgeStyle.Danger,
        _ => BadgeStyle.Info
    };

    private static string ScopeStatusText(PatchScopeStatus status) => status switch
    {
        PatchScopeStatus.InScope => "In Scope",
        _ => "Out of Scope"
    };

    private static BadgeStyle ScopeStatusBadgeStyle(PatchScopeStatus status) => status switch
    {
        PatchScopeStatus.InScope => BadgeStyle.Success,
        _ => BadgeStyle.Danger
    };

    private static string ValidationStatusText(PatchIntentMatchStatus? status) => status switch
    {
        PatchIntentMatchStatus.MatchesIntent => "Matches Intent",
        PatchIntentMatchStatus.PartiallyMatches => "Partially Matches",
        PatchIntentMatchStatus.DoesNotMatch => "Does Not Match",
        _ => "Patch Intent"
    };

    private static BadgeStyle ValidationStatusBadgeStyle(PatchIntentMatchStatus? status) => status switch
    {
        PatchIntentMatchStatus.MatchesIntent => BadgeStyle.Success,
        PatchIntentMatchStatus.PartiallyMatches => BadgeStyle.Warning,
        PatchIntentMatchStatus.DoesNotMatch => BadgeStyle.Danger,
        _ => BadgeStyle.Info
    };

    private static BadgeStyle RiskBadgeStyle(int riskScore) => riskScore switch
    {
        0 => BadgeStyle.Success,
        <= 2 => BadgeStyle.Warning,
        _ => BadgeStyle.Danger
    };

    private string DescribeRequestedIntent()
    {
        if (PatchPreview?.Intent is null)
        {
            return "No intent was recorded.";
        }

        return $"{PatchPreview.Intent.Goal} | Scope: {PatchPreview.Intent.AllowedScope} | Expected: {PatchPreview.Intent.ExpectedChangeType}";
    }

    private string DescribeScopeResult()
    {
        if (PatchPreview?.ScopeAnalysis is null)
        {
            return "No scope analysis was recorded.";
        }

        return PatchPreview.ScopeAnalysis.IsBlocking
            ? "Blocked by scope guard."
            : "Scope passed.";
    }

    private string DescribeIntentResult()
    {
        var status = PatchPreview?.IntentValidation?.Status;
        return status is null ? "No intent validation was recorded." : ValidationStatusText(status);
    }

    private IReadOnlyList<string> ModifiedFiles()
    {
        return PatchPreview?.IntentValidation?.ModifiedFiles ?? [];
    }

    private IReadOnlyList<string> ProtectedFiles()
    {
        return PatchPreview?.IntentValidation?.ProtectedFiles ?? [];
    }

    private string TechnicalDetails()
    {
        return ApplyResult?.TechnicalDetails
               ?? ApplyResult?.GitApplyResult?.Error
               ?? string.Empty;
    }

    private RenderFragment ResultCard(CommandRunResult Result, bool ShowHeadings = false) => @<RadzenCard>
        <RadzenText Text="@($"Exit code: {Result.ExitCode}")" TextStyle="TextStyle.Body1" />
        @if (ShowHeadings) { <h4>Stdout</h4> }
        <pre class="coder-output">@Result.Output</pre>
        @if (ShowHeadings) { <h4>Stderr</h4> }
        <pre class="coder-error">@Result.Error</pre>
    </RadzenCard>;

    private RenderFragment VerificationResults(IReadOnlyList<CommandRunResult> Results) => @<text>
        @if (Results.Count > 0)
        {
            <RadzenText Text="Verification Results" TextStyle="TextStyle.H6" />
            @foreach (var result in Results)
            {
                <RadzenCard>
                    <RadzenText Text="@($"{result.Command} — exit {result.ExitCode}")" TextStyle="TextStyle.Body1" />
                    @if (!string.IsNullOrWhiteSpace(result.Output)) { <pre class="coder-output">@result.Output</pre> }
                    @if (!string.IsNullOrWhiteSpace(result.Error)) { <pre class="coder-error">@result.Error</pre> }
                </RadzenCard>
            }
        }
    </text>;
}
