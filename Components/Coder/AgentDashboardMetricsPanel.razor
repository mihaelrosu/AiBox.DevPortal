@inject AgentDashboardMetricsService AgentDashboardMetricsService

<RadzenCard>
    <RadzenStack Gap="0.75rem">
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.SpaceBetween"
                     Gap="0.75rem"
                     Wrap="FlexWrap.Wrap">
            <div>
                <RadzenText Text="Agent Dashboard Metrics" TextStyle="TextStyle.H5" />
                <RadzenText Text="@GetGeneratedAtText()" TextStyle="TextStyle.Body2" />
            </div>

            <RadzenButton Text="Refresh"
                          Icon="refresh"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@LoadAsync"
                          Disabled="@isLoading" />
        </RadzenStack>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter">
                @errorMessage
            </RadzenAlert>
        }

        @if (isLoading)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else
        {
            <RadzenRow Gap="0.75rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenCard Style="margin: 0;">
                        <RadzenText Text="Total Attempts" TextStyle="TextStyle.Caption" />
                        <RadzenText Text="@metrics.TotalAttempts.ToString()" TextStyle="TextStyle.H4" />
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenCard Style="margin: 0;">
                        <RadzenText Text="Build Success Rate" TextStyle="TextStyle.Caption" />
                        <RadzenText Text="@($"{metrics.BuildSuccessRate:0.0}%")" TextStyle="TextStyle.H4" />
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenCard Style="margin: 0;">
                        <RadzenText Text="Rollback Success Rate" TextStyle="TextStyle.Caption" />
                        <RadzenText Text="@($"{metrics.RollbackSuccessRate:0.0}%")" TextStyle="TextStyle.H4" />
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="0.75rem">
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenText Text="Successful Applies" TextStyle="TextStyle.Caption" />
                    <RadzenText Text="@metrics.SuccessfulApplies.ToString()" TextStyle="TextStyle.Body1" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenText Text="Failed Applies" TextStyle="TextStyle.Caption" />
                    <RadzenText Text="@metrics.FailedApplies.ToString()" TextStyle="TextStyle.Body1" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenText Text="Rolled Back" TextStyle="TextStyle.Caption" />
                    <RadzenText Text="@metrics.RolledBackAttempts.ToString()" TextStyle="TextStyle.Body1" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenText Text="Last Attempt" TextStyle="TextStyle.Caption" />
                    <RadzenText Text="@GetDateText(metrics.LastAttemptAtUtc)" TextStyle="TextStyle.Body1" />
                </RadzenColumn>
            </RadzenRow>

            @if (metrics.TopFailureMessages.Count > 0)
            {
                <RadzenCard Style="margin: 0;">
                    <RadzenStack Gap="0.5rem">
                        <RadzenText Text="Top Failure Messages" TextStyle="TextStyle.H6" />
                        @foreach (var message in metrics.TopFailureMessages)
                        {
                            <RadzenText Text="@message" TextStyle="TextStyle.Body2" />
                        }
                    </RadzenStack>
                </RadzenCard>
            }

            <RadzenDataGrid Data="@metrics.RecentAttempts"
                            TItem="TaskSliceApplyHistoryItem"
                            AllowPaging="false"
                            AllowSorting="false"
                            AllowFiltering="false"
                            Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="TaskSliceApplyHistoryItem" Title="Applied">
                        <Template Context="item">@item.AppliedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TaskSliceApplyHistoryItem" Property="SliceTitle" Title="Slice" />
                    <RadzenDataGridColumn TItem="TaskSliceApplyHistoryItem" Title="Build">
                        <Template Context="item">
                            <RadzenBadge Text="@(item.BuildSucceeded ? "Succeeded" : "Failed")"
                                         BadgeStyle="@(item.BuildSucceeded ? BadgeStyle.Success : BadgeStyle.Danger)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TaskSliceApplyHistoryItem" Title="Rollback">
                        <Template Context="item">
                            <RadzenBadge Text="@(item.RolledBack ? (item.RollbackSucceeded ? "Succeeded" : "Failed") : "No rollback")"
                                         BadgeStyle="@(item.RolledBack ? (item.RollbackSucceeded ? BadgeStyle.Warning : BadgeStyle.Danger) : BadgeStyle.Light)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TaskSliceApplyHistoryItem" Title="Result">
                        <Template Context="item">@item.ResultMessage</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </RadzenStack>
</RadzenCard>

@code {
    private AgentDashboardMetrics metrics = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            metrics = await AgentDashboardMetricsService.GetMetricsAsync();
        }
        catch (Exception exception)
        {
            errorMessage = $"Unable to load agent dashboard metrics: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetGeneratedAtText()
    {
        return $"Generated at UTC: {metrics.GeneratedAtUtc:O}";
    }

    private static string GetDateText(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("yyyy-MM-dd HH:mm:ss") : "N/A";
    }
}
