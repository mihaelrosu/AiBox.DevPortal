@using AiBox.DevPortal.Models

<RadzenCard>
    <RadzenStack Gap="0.75rem">
        <RadzenText Text="Task Plan Preview" TextStyle="TextStyle.H5" />

        @if (Plan is null)
        {
            <RadzenCard Style="margin: 0;">
                <RadzenText Text="No task decomposition preview yet." TextStyle="TextStyle.Body2" />
            </RadzenCard>
        }
        else
        {
            <RadzenCard Style="margin: 0;">
                <RadzenStack Gap="0.25rem">
                    <RadzenText Text="Original Request" TextStyle="TextStyle.Body1" />
                    <RadzenText Text="@Plan.OriginalRequest" TextStyle="TextStyle.Body2" />
                    <RadzenText Text="@($"Created at UTC: {Plan.CreatedAtUtc:O}")" TextStyle="TextStyle.Caption" />
                    <RadzenBadge Text="@($"{Plan.Slices.Count} slices")" BadgeStyle="BadgeStyle.Info" />
                </RadzenStack>
            </RadzenCard>

            @if (CanApplyPlan())
            {
                <RadzenButton Text="Apply Plan"
                              Icon="playlist_add_check"
                              ButtonStyle="ButtonStyle.Primary"
                              Disabled="@(!OnApplyPlanRequested.HasDelegate || IsApplyingPlan)"
                              Click="@(() => OnApplyPlanRequested.InvokeAsync(Plan))" />
            }

            @foreach (var slice in Plan.Slices)
            {
                <RadzenCard Style="margin: 0;">
                    <RadzenStack Gap="0.5rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                                     Wrap="FlexWrap.Wrap">
                            @if (!string.IsNullOrWhiteSpace(slice.Id))
                            {
                                <RadzenBadge Text="@slice.Id" BadgeStyle="BadgeStyle.Light" />
                            }
                            <RadzenText Text="@slice.Title" TextStyle="TextStyle.Body1" />
                            <RadzenBadge Text="@slice.Status.ToString()" BadgeStyle="@GetStatusBadgeStyle(slice.Status)" />
                            <RadzenBadge Text="@slice.AllowedChangeType.ToString()" BadgeStyle="BadgeStyle.Secondary" />
                            @if (HasRiskDisplay(slice))
                            {
                                <RadzenBadge Text="@($"Risk: {GetDisplayRiskLevel(slice)}")"
                                             BadgeStyle="@GetRiskBadgeStyle(GetDisplayRiskLevel(slice))" />
                            }
                        </RadzenStack>

                        <RadzenText Text="@GetSliceBodyText(slice)" TextStyle="TextStyle.Body2" />

                        @if (HasRiskDisplay(slice))
                        {
                            <RadzenText Text="@GetSliceRiskSummary(slice)" TextStyle="TextStyle.Caption" />
                        }

                        @if (string.IsNullOrWhiteSpace(slice.RiskSummary) && GetSliceRiskAnalysis(slice) is not null)
                        {
                            <TaskSliceRiskPanel Analysis="@GetSliceRiskAnalysis(slice)"
                                                Compact="true"
                                                ShowReasons="true" />
                        }

                        @{
                            var displayRiskLevel = GetDisplayRiskLevel(slice);
                        }

                        @if (displayRiskLevel == RiskLevel.Medium)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
                                Medium-risk apply: review before applying.
                            </RadzenAlert>
                        }
                        else if (displayRiskLevel == RiskLevel.High)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
                                High-risk apply requires explicit manual approval.
                            </RadzenAlert>
                        }
                        else if (displayRiskLevel == RiskLevel.Critical)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
                                Critical-risk slices are blocked from apply.
                            </RadzenAlert>
                        }

                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Related Files" TextStyle="TextStyle.Caption" />
                            @if (GetRelatedFiles(slice).Count == 0)
                            {
                                <RadzenText Text="None" TextStyle="TextStyle.Body2" />
                            }
                            else
                            {
                                @foreach (var relatedFile in GetRelatedFiles(slice))
                                {
                                    <RadzenText Text="@relatedFile" TextStyle="TextStyle.Body2" />
                                }
                            }
                        </RadzenStack>

                        @if (!string.IsNullOrWhiteSpace(slice.Notes))
                        {
                            <RadzenStack Gap="0.25rem">
                                <RadzenText Text="Notes" TextStyle="TextStyle.Caption" />
                                <RadzenText Text="@slice.Notes" TextStyle="TextStyle.Body2" />
                            </RadzenStack>
                        }

                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Verification Commands" TextStyle="TextStyle.Caption" />
                            @if (slice.VerificationCommands.Count == 0)
                            {
                                <RadzenText Text="None" TextStyle="TextStyle.Body2" />
                            }
                            else
                            {
                                @foreach (var command in slice.VerificationCommands)
                                {
                                    <RadzenText Text="@command" TextStyle="TextStyle.Body2" />
                                }
                            }
                        </RadzenStack>

                        <RadzenButton Text="Generate Patch" Icon="difference" ButtonStyle="ButtonStyle.Primary"
                                      Disabled="@(!OnGeneratePatchRequested.HasDelegate || IsGeneratingPatch)"
                                      Click="@(() => OnGeneratePatchRequested.InvokeAsync(slice))" />

                        @if (slice.Status == TaskSliceStatus.Previewed)
                        {
                            <RadzenButton Text="Verify" Icon="check_circle" ButtonStyle="ButtonStyle.Success"
                                          Disabled="@(!OnVerifyRequested.HasDelegate || IsVerifyingSlice)"
                                          Click="@(() => OnVerifyRequested.InvokeAsync(slice))" />
                        }
                        @if (slice.Status == TaskSliceStatus.Verified)
                        {
                            @if (displayRiskLevel == RiskLevel.High)
                            {
                                <RadzenButton Text="@GetHighRiskApprovalButtonText(slice)"
                                              Icon="verified"
                                              ButtonStyle="@(HighRiskApplyApprovals.Contains(slice.Id) ? ButtonStyle.Success : ButtonStyle.Warning)"
                                              Disabled="@(!OnHighRiskApplyApprovalRequested.HasDelegate)"
                                              Click="@(() => OnHighRiskApplyApprovalRequested.InvokeAsync(slice))" />
                            }

                            <TaskSliceApprovalPanel Slice="@slice"
                                                    Approval="@GetSliceApproval(slice)"
                                                    RiskAnalysis="@GetSliceRiskAnalysis(slice)"
                                                    IsBusy="@(IsApplyingSlice || IsApprovalBusy)"
                                                    OnApproveRequested="@OnApproveRequested"
                                                    OnRejectRequested="@OnRejectRequested" />

                                <RadzenButton Text="Apply" Icon="done_all" ButtonStyle="ButtonStyle.Success"
                                          Disabled="@(!CanApplySlice(slice))"
                                          Click="@(() => OnApplyRequested.InvokeAsync(slice))" />
                        }
                        @if (slice.Status == TaskSliceStatus.Applied)
                        {
                            <RadzenButton Text="Rollback" Icon="undo" ButtonStyle="ButtonStyle.Warning"
                                          Disabled="@(!OnRollbackRequested.HasDelegate || IsRollingBack || string.IsNullOrWhiteSpace(slice.PatchPackageId))"
                                          Click="@(() => OnRollbackRequested.InvokeAsync(slice))" />
                        }

                        @if (SliceStatusMessages.TryGetValue(slice.Id, out var sliceStatusMessage) &&
                             !string.IsNullOrWhiteSpace(sliceStatusMessage))
                        {
                            <RadzenText Text="@sliceStatusMessage" TextStyle="TextStyle.Caption" />
                        }

                        @if (GetSliceVerificationLoopResult(slice) is { } loopResult)
                        {
                            <RadzenCard Style="margin: 0;">
                                <RadzenStack Gap="0.5rem">
                                    <RadzenStack Orientation="Orientation.Horizontal"
                                                 AlignItems="AlignItems.Center"
                                                 Gap="0.5rem"
                                                 Wrap="FlexWrap.Wrap">
                                        <RadzenText Text="Verification Loop" TextStyle="TextStyle.Body1" />
                                        <RadzenBadge Text="@($"{loopResult.Attempts}/{TaskSliceVerificationLoopService.MaxAttempts} attempts")"
                                                     BadgeStyle="BadgeStyle.Info" />
                                        <RadzenBadge Text="@GetLoopStatusText(loopResult.Success)"
                                                     BadgeStyle="@(loopResult.Success ? BadgeStyle.Success : BadgeStyle.Warning)" />
                                    </RadzenStack>

                                    @foreach (var attempt in loopResult.VerificationResults.Select((value, index) => (Value: value, Index: index)))
                                    {
                                        <RadzenCard Style="margin: 0;">
                                            <RadzenStack Gap="0.35rem">
                                                <RadzenStack Orientation="Orientation.Horizontal"
                                                             AlignItems="AlignItems.Center"
                                                             Gap="0.5rem"
                                                             Wrap="FlexWrap.Wrap">
                                                    <RadzenText Text="@($"Attempt {attempt.Index + 1}/{TaskSliceVerificationLoopService.MaxAttempts}")"
                                                                TextStyle="TextStyle.Body2" />
                                                    <RadzenBadge Text="@GetAttemptStatusText(attempt.Value.Success)"
                                                                 BadgeStyle="@(attempt.Value.Success ? BadgeStyle.Success : BadgeStyle.Danger)" />
                                                </RadzenStack>

                                                <RadzenText Text="@attempt.Value.Summary" TextStyle="TextStyle.Body2" />

                                                @if (attempt.Value.Errors.Count > 0)
                                                {
                                                    @foreach (var error in attempt.Value.Errors)
                                                    {
                                                        <RadzenText Text="@error" TextStyle="TextStyle.Caption" />
                                                    }
                                                }
                                            </RadzenStack>
                                        </RadzenCard>
                                    }

                                    @if (loopResult.GeneratedFixSlice is not null)
                                    {
                                        <RadzenText Text="@($"Generated fix slice: {loopResult.GeneratedFixSlice.Title}")"
                                                    TextStyle="TextStyle.Caption" />
                                    }

                                    @if (!string.IsNullOrWhiteSpace(loopResult.FinalMessage))
                                    {
                                        <RadzenText Text="@($"Final result: {loopResult.FinalMessage}")"
                                                    TextStyle="TextStyle.Body2" />
                                    }
                                </RadzenStack>
                            </RadzenCard>
                        }
                    </RadzenStack>
                </RadzenCard>
            }

            @if (PlanApplyResult is not null)
            {
                <RadzenCard Style="margin: 0;">
                    <RadzenStack Gap="0.5rem">
                        <RadzenText Text="Plan Apply" TextStyle="TextStyle.H6" />

                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                            <RadzenBadge Text="@($"{PlanApplyResult.AppliedSlices}/{PlanApplyResult.TotalSlices} applied")"
                                         BadgeStyle="BadgeStyle.Info" />
                            <RadzenBadge Text="@(PlanApplyResult.Success ? "Success" : "Failed")"
                                         BadgeStyle="@(PlanApplyResult.Success ? BadgeStyle.Success : BadgeStyle.Danger)" />
                            @if (PlanApplyResult.RollbackPerformed)
                            {
                                <RadzenBadge Text="Rollback performed" BadgeStyle="BadgeStyle.Warning" />
                            }
                        </RadzenStack>

                        @if (IsApplyingPlan && !string.IsNullOrWhiteSpace(PlanApplyResult.CurrentSliceTitle))
                        {
                            <RadzenText Text="@($"Current slice: {PlanApplyResult.CurrentSliceTitle}")" TextStyle="TextStyle.Body2" />
                            <RadzenText Text="@PlanApplyResult.StatusMessage" TextStyle="TextStyle.Body2" />
                            <RadzenProgressBar Value="@GetPlanProgressPercent()" ShowValue="false" />
                        }

                        @if (!string.IsNullOrWhiteSpace(PlanApplyResult.Summary))
                        {
                            <RadzenText Text="@PlanApplyResult.Summary" TextStyle="TextStyle.Body2" />
                        }

                        @if (PlanApplyResult.CyclesDetected.Count > 0 || PlanApplyResult.ValidationErrors.Count > 0)
                        {
                            <RadzenStack Gap="0.35rem">
                                <RadzenText Text="Dependency Validation" TextStyle="TextStyle.Caption" />

                                @foreach (var cycle in PlanApplyResult.CyclesDetected)
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
                                        @cycle
                                    </RadzenAlert>
                                }

                                @foreach (var error in PlanApplyResult.ValidationErrors)
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
                                        @error
                                    </RadzenAlert>
                                }
                            </RadzenStack>
                        }

                        @if (PlanApplyResult.AuditTrail.Count > 0)
                        {
                            <RadzenStack Gap="0.25rem">
                                <RadzenText Text="Audit Trail" TextStyle="TextStyle.Caption" />
                                @foreach (var entry in PlanApplyResult.AuditTrail)
                                {
                                    <RadzenText Text="@entry" TextStyle="TextStyle.Body2" />
                                }
                            </RadzenStack>
                        }
                    </RadzenStack>
                </RadzenCard>
            }
        }
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter] public TaskPlan? Plan { get; set; }
    [Parameter] public EventCallback<TaskPlanSlice> OnGeneratePatchRequested { get; set; }
    [Parameter] public EventCallback<TaskPlanSlice> OnVerifyRequested { get; set; }
    [Parameter] public EventCallback<TaskPlanSlice> OnRollbackRequested { get; set; }
    [Parameter] public EventCallback<TaskPlanSlice> OnApplyRequested { get; set; } 
    [Parameter] public EventCallback<TaskPlan> OnApplyPlanRequested { get; set; }
    [Parameter] public EventCallback<TaskPlanSlice> OnApproveRequested { get; set; }
    [Parameter] public EventCallback<TaskPlanSlice> OnRejectRequested { get; set; }
    [Parameter] public EventCallback<TaskPlanSlice> OnHighRiskApplyApprovalRequested { get; set; }
    [Parameter] public bool IsGeneratingPatch { get; set; }
    [Parameter] public bool IsVerifyingSlice { get; set; }
    [Parameter] public bool IsRollingBack { get; set; }
    [Parameter] public bool IsApplyingSlice { get; set; }
    [Parameter] public bool IsApplyingPlan { get; set; }
    [Parameter] public bool IsApprovalBusy { get; set; }
    [Parameter] public IReadOnlySet<string> HighRiskApplyApprovals { get; set; } = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    [Parameter] public IReadOnlyDictionary<string, TaskSliceApproval> SliceApprovals { get; set; } = new Dictionary<string, TaskSliceApproval>();
    [Parameter] public IReadOnlyDictionary<string, TaskSliceRiskAnalysis> SliceRiskAnalyses { get; set; } = new Dictionary<string, TaskSliceRiskAnalysis>(StringComparer.OrdinalIgnoreCase);
    [Parameter] public IReadOnlyDictionary<string, TaskSliceVerificationLoopResult> SliceVerificationLoopResults { get; set; } = new Dictionary<string, TaskSliceVerificationLoopResult>(StringComparer.OrdinalIgnoreCase);
    [Parameter] public TaskPlanApplyResult? PlanApplyResult { get; set; }
    [Parameter]
    public IReadOnlyDictionary<string, string> SliceStatusMessages { get; set; } = new Dictionary<string,string>();

    private static BadgeStyle GetStatusBadgeStyle(TaskSliceStatus status)
    {
        return status switch
        {
            TaskSliceStatus.Pending => BadgeStyle.Info,
            TaskSliceStatus.Previewed => BadgeStyle.Warning,
            TaskSliceStatus.Applied => BadgeStyle.Primary,
            TaskSliceStatus.Verified => BadgeStyle.Success,
            TaskSliceStatus.Failed => BadgeStyle.Danger,
            TaskSliceStatus.RolledBack => BadgeStyle.Secondary,
            _ => BadgeStyle.Light
        };
    }
    
    private static string GetSliceBodyText(TaskPlanSlice slice)
    {
        if (!string.IsNullOrWhiteSpace(slice.Description))
        {
            return slice.Description;
        }

        return string.IsNullOrWhiteSpace(slice.Goal) ? "No description provided." : slice.Goal;
    }

    private static IReadOnlyList<string> GetRelatedFiles(TaskPlanSlice slice)
    {
        var relatedFiles = slice.RelatedFiles.Count > 0 ? slice.RelatedFiles : slice.TargetFiles;
        return relatedFiles.Count == 0 ? [] : relatedFiles;
    }

    private TaskSliceApproval? GetSliceApproval(TaskPlanSlice slice)
    {
        return SliceApprovals.TryGetValue(slice.Id, out var approval) ? approval : null;
    }

    private TaskSliceRiskAnalysis? GetSliceRiskAnalysis(TaskPlanSlice slice)
    {
        return SliceRiskAnalyses.TryGetValue(slice.Id, out var analysis) ? analysis : null;
    }

    private bool HasRiskDisplay(TaskPlanSlice slice)
    {
        return GetDisplayRiskLevel(slice) != RiskLevel.Low ||
               !string.IsNullOrWhiteSpace(slice.RiskSummary) ||
               GetSliceRiskAnalysis(slice) is not null;
    }

    private RiskLevel GetDisplayRiskLevel(TaskPlanSlice slice)
    {
        if (slice.RiskLevel != RiskLevel.Low || !string.IsNullOrWhiteSpace(slice.RiskSummary))
        {
            return slice.RiskLevel;
        }

        var analysis = GetSliceRiskAnalysis(slice);
        return analysis is null
            ? slice.RiskLevel
            : analysis.RiskLevel switch
            {
                TaskSliceRiskLevel.Low => RiskLevel.Low,
                TaskSliceRiskLevel.Medium => RiskLevel.Medium,
                TaskSliceRiskLevel.High => RiskLevel.High,
                TaskSliceRiskLevel.Critical => RiskLevel.Critical,
                _ => RiskLevel.Low
            };
    }

    private string GetSliceRiskSummary(TaskPlanSlice slice)
    {
        if (!string.IsNullOrWhiteSpace(slice.RiskSummary))
        {
            return slice.RiskSummary;
        }

        var analysis = GetSliceRiskAnalysis(slice);
        return analysis is null
            ? string.Empty
            : string.Join(" ", analysis.Reasons);
    }

    private string GetHighRiskApprovalButtonText(TaskPlanSlice slice)
    {
        return HighRiskApplyApprovals.Contains(slice.Id)
            ? "Revoke high-risk approval"
            : "Approve high-risk apply";
    }

    private TaskSliceVerificationLoopResult? GetSliceVerificationLoopResult(TaskPlanSlice slice)
    {
        return SliceVerificationLoopResults.TryGetValue(slice.Id, out var result) ? result : null;
    }

    private static string GetLoopStatusText(bool success)
    {
        return success ? "Success" : "Stopped";
    }

    private static string GetAttemptStatusText(bool success)
    {
        return success ? "Success" : "Failure";
    }

    private bool CanApplySlice(TaskPlanSlice slice)
    {
        return OnApplyRequested.HasDelegate &&
               !IsApplyingSlice &&
               GetSliceApproval(slice)?.Status == TaskSliceApprovalStatus.Approved &&
               (slice.RiskLevel switch
               {
                   RiskLevel.Low => true,
                   RiskLevel.Medium => true,
                   RiskLevel.High => HighRiskApplyApprovals.Contains(slice.Id),
                   RiskLevel.Critical => false,
                   _ => true
               });
    }

    private bool CanApplyPlan()
    {
        return Plan is not null &&
               OnApplyPlanRequested.HasDelegate &&
               !IsApplyingPlan &&
               Plan.Slices.Any(slice => GetSliceApproval(slice)?.Status == TaskSliceApprovalStatus.Approved);
    }

    private static BadgeStyle GetRiskBadgeStyle(RiskLevel riskLevel)
    {
        return riskLevel switch
        {
            RiskLevel.Low => BadgeStyle.Success,
            RiskLevel.Medium => BadgeStyle.Warning,
            RiskLevel.High => BadgeStyle.Danger,
            RiskLevel.Critical => BadgeStyle.Danger,
            _ => BadgeStyle.Light
        };
    }

    private int GetPlanProgressPercent()
    {
        if (PlanApplyResult is null || PlanApplyResult.TotalSlices <= 0)
        {
            return 0;
        }

        return Math.Clamp((int)Math.Round(PlanApplyResult.AppliedSlices * 100d / PlanApplyResult.TotalSlices, MidpointRounding.AwayFromZero), 0, 100);
    }
}
