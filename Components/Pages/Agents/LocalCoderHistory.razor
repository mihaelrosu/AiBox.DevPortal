@page "/agents/local-coder-history"

// This file is intentionally left blank for demonstration purposes.
@rendermode InteractiveServer
@using System.Text.Json
@using System.Text.Json.Serialization
@using AiBox.DevPortal.Models.Agents
@using AiBox.DevPortal.Services.Agents
@using AiBox.DevPortal.Components.Common
@using Microsoft.AspNetCore.Components.Web
@using Radzen
@using Radzen.Blazor
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using AgentLocalCoderHistoryService = AiBox.DevPortal.Services.Agents.ILocalCoderHistoryService

<PageTitle>Local Coder History</PageTitle>

<RadzenCard>
    <div class="page-header">
        <div>
            <h1>Local Coder History & Sessions</h1>
            <p>Browse and inspect saved Local Coder sessions. This page does not execute Local Coder actions.</p>
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true"
                         Text="This page displays previously executed Local Coder runs." />
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenButton Text="Open Local Coder" Icon="code" ButtonStyle="ButtonStyle.Light" Click="@OpenLocalCoder" />
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Click="@LoadAsync" Disabled="@isBusy" />
        </RadzenStack>
    </div>

    <RadzenCard>
        <RadzenRow Gap="0.75rem" AlignItems="AlignItems.End">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Search history" Style="width: 100%;">
                    <RadzenTextBox @bind-Value="@searchText" Placeholder="Title, repository, model, or instructions" Style="width: 100%;" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="Status" Style="width: 100%;">
                    <RadzenDropDown TValue="LocalCoderTaskStatus?"
                                    Data="@statuses"
                                    @bind-Value="@selectedStatus"
                                    AllowClear="true"
                                    Placeholder="All statuses"
                                    Style="width: 100%;" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenButton Text="Clear Filters" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@ClearFilters"
                              Disabled="@(string.IsNullOrWhiteSpace(searchText) && selectedStatus is null)" Style="width: 100%;" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenCard>
        <AppDataGrid @ref="grid" Data="@FilteredRecords" TItem="LocalCoderTaskHistoryRecord" PageSize="10"
                        RowSelect="@SelectRecord" EmptyText="No Local Coder history records match the current filters.">
            <Columns>
                <RadzenDataGridColumn TItem="LocalCoderTaskHistoryRecord" Title="Updated">
                    <Template Context="record">@record.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LocalCoderTaskHistoryRecord" Title="Title">
                    <Template Context="record">@DisplayTitle(record)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LocalCoderTaskHistoryRecord" Property="Task.RepositoryPath" Title="Repository" />
                <RadzenDataGridColumn TItem="LocalCoderTaskHistoryRecord" Property="Task.Model" Title="Model" />
                <RadzenDataGridColumn TItem="LocalCoderTaskHistoryRecord" Title="Status">
                    <Template Context="record"><RadzenBadge Text="@record.Task.Status.ToString()" BadgeStyle="@StatusBadgeStyle(record.Task.Status)" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LocalCoderTaskHistoryRecord" Title="Context Files">
                    <Template Context="record">@(record.Task.SelectedFilePaths?.Count ?? 0)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LocalCoderTaskHistoryRecord" Title="Actions" Sortable="false" Filterable="false">
                    <Template Context="record">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem" Wrap="FlexWrap.Wrap">
                            <RadzenButton Text="Inspect" Icon="visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                          Click="@(() => SelectRecord(record))" Disabled="@isBusy" />
                            <RadzenButton Text="Open" Icon="open_in_new" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                          Click="@(() => OpenLocalCoder(record))" Disabled="@isBusy" />
                            <RadzenButton Text="Export" Icon="markdown" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                          Click="@(() => ExportMarkdown(record))" Disabled="@isBusy" />
                            <RadzenButton Text="Delete" Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                          Click="@(() => DeleteAsync(record))" Disabled="@isBusy" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </AppDataGrid>
    </RadzenCard>

    @if (selectedRecord is not null)
    {
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                    <div>
                        <RadzenText Text="@DisplayTitle(selectedRecord)" TextStyle="TextStyle.H5" />
                        <RadzenText Text="@selectedRecord.Id" TextStyle="TextStyle.Caption" />
                    </div>
                    <RadzenBadge Text="@selectedRecord.Task.Status.ToString()" BadgeStyle="@StatusBadgeStyle(selectedRecord.Task.Status)" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenButton Text="Export Markdown" Icon="markdown" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => ExportMarkdown(selectedRecord))" />
                    <CopyToClipboardButton Text="Copy Markdown"
                                           Value="@exportMarkdown"
                                           SuccessTitle="Markdown copied"
                                           SuccessMessage="The Local Coder Markdown was copied to the clipboard." />
                </RadzenStack>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenText Text="Created" TextStyle="TextStyle.Caption" />
                        <RadzenText Text="@selectedRecord.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenText Text="Updated" TextStyle="TextStyle.Caption" />
                        <RadzenText Text="@selectedRecord.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenText Text="Selected context files" TextStyle="TextStyle.Caption" />
                        <RadzenText Text="@((selectedRecord.Task.SelectedFilePaths?.Count ?? 0).ToString())" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenTabs>
                    <Tabs>
                        <RadzenTabsItem Text="Task JSON">
                            <RadzenTextArea Value="@SelectedTaskJson" ReadOnly="true" Rows="18" Style="width: 100%; font-family: monospace;" />
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="Plan">
                            <RadzenTextArea Value="@selectedRecord.PlanText" ReadOnly="true" Rows="18" Style="width: 100%;" />
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="Diff">
                            <RadzenTextArea Value="@selectedRecord.DiffText" ReadOnly="true" Rows="18" Style="width: 100%; font-family: monospace;" />
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="Build Output">
                            <RadzenTextArea Value="@selectedRecord.BuildOutput" ReadOnly="true" Rows="18" Style="width: 100%; font-family: monospace;" />
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="Review">
                            <RadzenTextArea Value="@selectedRecord.ReviewText" ReadOnly="true" Rows="18" Style="width: 100%;" />
                        </RadzenTabsItem>
                    </Tabs>
                </RadzenTabs>
            </RadzenStack>
        </RadzenCard>
    }

    @if (!string.IsNullOrWhiteSpace(exportMarkdown))
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText Text="Markdown Export" TextStyle="TextStyle.H5" />
                <RadzenTextArea Value="@exportMarkdown" ReadOnly="true" Rows="18" Style="width: 100%; font-family: monospace;" />
            </RadzenStack>
        </RadzenCard>
    }
</RadzenCard>

@code {
    [Inject] private AgentLocalCoderHistoryService HistoryService { get; set; } = default!;
    [Inject] private ILocalCoderMarkdownService MarkdownService { get; set; } = default!;
    [Inject] private DialogService DialogService { get; set; } = default!;
    [Inject] private NotificationService NotificationService { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private object? grid;
    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        WriteIndented = true,
        Converters = { new JsonStringEnumConverter() }
    };

    private readonly LocalCoderTaskStatus[] statuses = Enum.GetValues<LocalCoderTaskStatus>();
    private IReadOnlyList<LocalCoderTaskHistoryRecord> records = [];
    private LocalCoderTaskHistoryRecord? selectedRecord;
    private LocalCoderTaskStatus? selectedStatus;
    private string searchText = string.Empty;
    private string exportMarkdown = string.Empty;
    private bool isBusy;

    private IEnumerable<LocalCoderTaskHistoryRecord> FilteredRecords => records.Where(record =>
        (selectedStatus is null || record.Task.Status == selectedStatus)
        && (string.IsNullOrWhiteSpace(searchText)
            || DisplayTitle(record).Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase)
            || record.Task.RepositoryPath.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase)
            || record.Task.Model.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase)
            || record.Task.Instructions.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase)));

    private string SelectedTaskJson => selectedRecord is null
        ? string.Empty
        : JsonSerializer.Serialize(selectedRecord.Task, JsonOptions);

    protected override Task OnInitializedAsync()
    {
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        isBusy = true;

        try
        {
            records = await HistoryService.GetAllAsync();

            if (selectedRecord is not null)
            {
                selectedRecord = records.FirstOrDefault(record => record.Id.Equals(selectedRecord.Id, StringComparison.OrdinalIgnoreCase));
            }
        }
        catch (Exception exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "History load failed", exception.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void SelectRecord(LocalCoderTaskHistoryRecord record)
    {
        selectedRecord = record;
    }

    private void OpenLocalCoder()
    {
        NavigationManager.NavigateTo("agents/local-coder");
    }

    private void OpenLocalCoder(LocalCoderTaskHistoryRecord record)
    {
        NavigationManager.NavigateTo($"agents/local-coder?historyId={Uri.EscapeDataString(record.Id)}");
    }

    private void ExportMarkdown(LocalCoderTaskHistoryRecord record)
    {
        selectedRecord = record;
        exportMarkdown = MarkdownService.Export(record);
        NotificationService.Notify(NotificationSeverity.Success, "Markdown exported", DisplayTitle(record));
    }

    private async Task DeleteAsync(LocalCoderTaskHistoryRecord record)
    {
        var confirmed = await DialogService.Confirm(
            $"Delete Local Coder history for '{DisplayTitle(record)}'?",
            "Delete Local Coder history",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed != true)
        {
            return;
        }

        isBusy = true;

        try
        {
            await HistoryService.DeleteAsync(record.Id);

            if (selectedRecord?.Id == record.Id)
            {
                selectedRecord = null;
                exportMarkdown = string.Empty;
            }

            records = await HistoryService.GetAllAsync();
            NotificationService.Notify(NotificationSeverity.Success, "History deleted", DisplayTitle(record));
        }
        catch (Exception exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Delete failed", exception.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ClearFilters()
    {
        searchText = string.Empty;
        selectedStatus = null;
    }

    private static string DisplayTitle(LocalCoderTaskHistoryRecord record)
    {
        return string.IsNullOrWhiteSpace(record.Task.Title) ? "Untitled task" : record.Task.Title;
    }

    private static BadgeStyle StatusBadgeStyle(LocalCoderTaskStatus status) => status switch
    {
        LocalCoderTaskStatus.BuildSucceeded or LocalCoderTaskStatus.Reviewed or LocalCoderTaskStatus.Applied => BadgeStyle.Success,
        LocalCoderTaskStatus.BuildFailed or LocalCoderTaskStatus.Failed => BadgeStyle.Danger,
        LocalCoderTaskStatus.ApplyDisabled => BadgeStyle.Warning,
        LocalCoderTaskStatus.PatchGenerated or LocalCoderTaskStatus.Planned => BadgeStyle.Info,
        _ => BadgeStyle.Secondary
    };
}
