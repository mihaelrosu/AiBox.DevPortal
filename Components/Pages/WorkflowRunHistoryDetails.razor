    private async Task RunExecutionAsync()
    {
        if (run is null || string.IsNullOrWhiteSpace(selectedExecutionStepId))
        {
            return;
        }

        isExecutingCommand = true;
        executionMessage = null;

        try
        {
            var result = await ExecutionEngine.ExecuteAsync(new ExecutionRequest
            {
                RunId = run.Id,
                StepId = selectedExecutionStepId,
                ProjectId = run.ProjectId,
                WorkingDirectory = executionWorkingDirectory,
                CommandType = executionCommandType,
                Command = executionCommand,
                Arguments = executionArguments,
                RequiresConfirmation = executionRequiresConfirmation,
                Confirmed = executionConfirmed
            });

            latestExecutionResult = result;
            run = await HistoryService.GetByIdAsync(RunId);
            executionMessage = result.Status == ExecutionStatus.WaitingForConfirmation
                ? "The command was queued for confirmation."
                : $"Command finished with status {result.Status}.";
            executionAlertStyle = result.Status is ExecutionStatus.Completed
                ? AlertStyle.Success
                : result.Status is ExecutionStatus.WaitingForConfirmation
                    ? AlertStyle.Warning
                    : AlertStyle.Danger;

            NotificationService.Notify(
                result.Status == ExecutionStatus.Completed ? NotificationSeverity.Success : NotificationSeverity.Info,
                "Execution complete",
                result.Status.ToString());
        }
        catch (Exception exception)
        {
            executionMessage = exception.Message;
            executionAlertStyle = AlertStyle.Danger;
            NotificationService.Notify(NotificationSeverity.Error, "Execution failed", exception.Message);
        }
        finally
        {
            isExecutingCommand = false;
        }
    }

