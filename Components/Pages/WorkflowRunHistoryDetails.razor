    private static string DisplayTextOrNa(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "n/a" : value;
    }

    private static string ProjectDisplayText(ProjectSnapshot? project)
    {
        return project is null ? "Not specified" : $"{project.Name} ({project.Type})";
    }

    private static string ResultLabel(bool success)
    {
        return success ? "Success" : "Failed";
    }

    private static bool RequiresGitConfirmation(GitOperationType operationType)
    {
        return operationType is GitOperationType.CheckoutBranch or GitOperationType.Add or GitOperationType.Commit;
    }

    private static bool RequiresDockerConfirmation(DockerOperationType operationType)
    {
        return operationType is DockerOperationType.ComposeUp or DockerOperationType.ComposeDown or DockerOperationType.ComposeRestart;
    }

    private static bool RequiresComfyUiConfirmation(ComfyUiOperationType operationType)
    {
        return operationType is ComfyUiOperationType.QueueWorkflow or ComfyUiOperationType.BackupWorkflows;
    }

    private static bool IsImplementatorStep(WorkflowRunStepRecord step)
    {
        return step.AgentName.Contains("Implementator", StringComparison.OrdinalIgnoreCase)
            || step.StepName.Contains("Implementator", StringComparison.OrdinalIgnoreCase);
    }

    private static string TimingText(WorkflowRunStepRecord step)
    {
        if (step.CompletedAt is not null)
        {
            return $"Completed {step.CompletedAt.Value.LocalDateTime:yyyy-MM-dd HH:mm:ss}";
        }

        if (step.StartedAt is not null)
        {
            return $"Started {step.StartedAt.Value.LocalDateTime:yyyy-MM-dd HH:mm:ss}";
        }

        return "Not started";
    }

    private static BadgeStyle RunStatusBadgeStyle(WorkflowRunStatus status)
    {
        return status switch
        {
            WorkflowRunStatus.Completed => BadgeStyle.Success,
            WorkflowRunStatus.Failed => BadgeStyle.Danger,
            WorkflowRunStatus.Cancelled or WorkflowRunStatus.Paused => BadgeStyle.Warning,
            WorkflowRunStatus.Running => BadgeStyle.Info,
            _ => BadgeStyle.Secondary
        };
    }

    private static BadgeStyle StepStatusBadgeStyle(WorkflowRunStepStatus status)
    {
        return status switch
        {
            WorkflowRunStepStatus.Completed => BadgeStyle.Success,
            WorkflowRunStepStatus.Failed => BadgeStyle.Danger,
            WorkflowRunStepStatus.Running => BadgeStyle.Info,
            WorkflowRunStepStatus.Skipped => BadgeStyle.Warning,
            _ => BadgeStyle.Secondary
        };
    }

    private static BadgeStyle ExecutionStatusBadgeStyle(ExecutionStatus status)
    {
        return status switch
        {
            ExecutionStatus.Completed => BadgeStyle.Success,
            ExecutionStatus.WaitingForConfirmation => BadgeStyle.Warning,
            ExecutionStatus.Running => BadgeStyle.Info,
            ExecutionStatus.TimedOut => BadgeStyle.Warning,
            ExecutionStatus.Failed => BadgeStyle.Danger,
            ExecutionStatus.Rejected => BadgeStyle.Danger,
            _ => BadgeStyle.Secondary
        };
    }

    private static BadgeStyle VerificationStatusBadgeStyle(VerificationStatus status)
    {
        return status switch
        {
            VerificationStatus.Passed => BadgeStyle.Success,
            VerificationStatus.Warning => BadgeStyle.Warning,
            VerificationStatus.Failed => BadgeStyle.Danger,
            _ => BadgeStyle.Secondary
        };
    }

    private static BadgeStyle VerificationSeverityBadgeStyle(VerificationSeverity severity)
    {
        return severity switch
        {
            VerificationSeverity.Info => BadgeStyle.Info,
            VerificationSeverity.Warning => BadgeStyle.Warning,
            VerificationSeverity.Error => BadgeStyle.Danger,
            VerificationSeverity.Critical => BadgeStyle.Danger,
            _ => BadgeStyle.Secondary
        };
    }
}
