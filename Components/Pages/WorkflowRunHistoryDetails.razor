    private async Task InitializeExecutionAsync()
    {
        if (run is null)
        {
            executionStepOptions = [];
            selectedExecutionStepId = string.Empty;
            latestExecutionResult = null;
            return;
        }

        executionStepOptions = run.Steps
            .Where(step => step.Enabled && IsImplementatorStep(step))
            .Concat(run.Steps.Where(step => step.Enabled && !IsImplementatorStep(step)))
            .ToArray();

        var defaultStep = executionStepOptions.FirstOrDefault() ?? run.Steps.FirstOrDefault();
        selectedExecutionStepId = defaultStep?.StepId ?? string.Empty;
        executionWorkingDirectory = run.ProjectSnapshot?.LocalPath ?? string.Empty;
        executionCommandType = ExecutionCommandType.DotNet;
        executionCommand = "build";
        executionArguments = string.Empty;
        executionRequiresConfirmation = false;
        executionConfirmed = false;
        executionMessage = null;
        fileOperationType = FileOperationType.ListDirectory;
        fileOperationPath = string.Empty;
        fileOperationTargetPath = string.Empty;
        fileOperationContent = string.Empty;
        fileOperationConfirmed = false;
        latestExecutionResult = selectedExecutionStepId.Length > 0
            ? await ExecutionEngine.GetLatestForStepAsync(run.Id, selectedExecutionStepId)
            : null;
        gitOperationLatestResult = selectedExecutionStepId.Length > 0
            ? await GitOperations.GetLatestForStepAsync(run.Id, selectedExecutionStepId)
            : null;
        dockerOperationLatestResult = selectedExecutionStepId.Length > 0
            ? await DockerOperations.GetLatestForStepAsync(run.Id, selectedExecutionStepId)
            : null;
        comfyUiOperationLatestResult = selectedExecutionStepId.Length > 0
            ? await ComfyUiOperations.GetLatestForStepAsync(run.Id, selectedExecutionStepId)
            : null;

        await RefreshExecutionRequirementsAsync();
    }

    private async Task OnExecutionStepChangedAsync(object? value)
    {
        selectedExecutionStepId = value?.ToString() ?? string.Empty;
        await RefreshExecutionRequirementsAsync();
    }

    private async Task RefreshExecutionRequirementsAsync()
    {
        executionMessage = null;

        if (run is null || string.IsNullOrWhiteSpace(selectedExecutionStepId))
        {
            executionRequiresConfirmation = false;
            latestExecutionResult = null;
            return;
        }

        latestExecutionResult = await ExecutionEngine.GetLatestForStepAsync(run.Id, selectedExecutionStepId);

        var step = run.Steps.FirstOrDefault(item => item.StepId.Equals(selectedExecutionStepId, StringComparison.OrdinalIgnoreCase));

        if (step is null)
        {
            executionRequiresConfirmation = false;
            return;
        }

        var agent = await AgentRegistry.GetByIdAsync(step.AgentId);
        var profileId = agent?.ExecutionPermissionProfileId;
        var profile = !string.IsNullOrWhiteSpace(profileId)
            ? await ExecutionPermissionProfiles.GetByIdAsync(profileId)
            : null;

        if (profile is null && run.ProjectSnapshot is not null && !string.IsNullOrWhiteSpace(run.ProjectSnapshot.DefaultExecutionPermissionProfileId))
        {
            profile = await ExecutionPermissionProfiles.GetByIdAsync(run.ProjectSnapshot.DefaultExecutionPermissionProfileId);
        }

        executionRequiresConfirmation = profile?.RequiresConfirmation == true || profile?.AllowDeleteFiles == true;
        executionConfirmed = !executionRequiresConfirmation;

        if (string.IsNullOrWhiteSpace(executionWorkingDirectory))
        {
            executionWorkingDirectory = run.ProjectSnapshot?.LocalPath ?? string.Empty;
        }

        gitProfileRequiresConfirmation = profile?.RequiresConfirmation == true;
        gitOperationRequiresConfirmation = gitProfileRequiresConfirmation || RequiresGitConfirmation(gitOperationType);
        gitConfirmed = !gitOperationRequiresConfirmation;
        gitOperationLatestResult = await GitOperations.GetLatestForStepAsync(run.Id, selectedExecutionStepId);
        dockerOperationRequiresConfirmation = RequiresDockerConfirmation(dockerOperationType);
        dockerConfirmed = !dockerOperationRequiresConfirmation;
        dockerOperationLatestResult = await DockerOperations.GetLatestForStepAsync(run.Id, selectedExecutionStepId);
        comfyUiOperationRequiresConfirmation = RequiresComfyUiConfirmation(comfyUiOperationType);
        comfyUiConfirmed = !comfyUiOperationRequiresConfirmation;
        comfyUiOperationLatestResult = await ComfyUiOperations.GetLatestForStepAsync(run.Id, selectedExecutionStepId);
    }

