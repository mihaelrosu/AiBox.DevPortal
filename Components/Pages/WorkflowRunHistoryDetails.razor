    private async Task ExecuteComfyUiOperationAsync()
    {
        if (run is null || string.IsNullOrWhiteSpace(selectedExecutionStepId))
        {
            return;
        }

        isExecutingComfyUiOperation = true;
        comfyUiOperationMessage = null;

        try
        {
            var result = await ComfyUiOperations.ExecuteAsync(new ComfyUiOperationRequest
            {
                RunId = run.Id,
                StepId = selectedExecutionStepId,
                ProjectId = run.ProjectId,
                OperationType = comfyUiOperationType,
                WorkflowFileName = comfyUiWorkflowFileName,
                WorkflowJson = comfyUiWorkflowJson,
                Confirmed = comfyUiConfirmed
            });

            comfyUiOperationLatestResult = result;
            if (result.Success && result.OperationType == ComfyUiOperationType.ReadWorkflow)
            {
                comfyUiWorkflowJson = result.WorkflowJson;
            }
            if (result.Success && result.OperationType is ComfyUiOperationType.SaveWorkflow or ComfyUiOperationType.ListWorkflows)
            {
                await LoadComfyUiWorkflowFilesAsync();
            }

            await LoadComfyUiOperationHistoryAsync();
            comfyUiOperationMessage = result.Message;
            comfyUiOperationAlertStyle = result.Success ? AlertStyle.Success : AlertStyle.Danger;
            NotificationService.Notify(
                result.Success ? NotificationSeverity.Success : NotificationSeverity.Warning,
                "ComfyUI operation complete",
                result.Message);
        }
        catch (Exception exception)
        {
            comfyUiOperationMessage = exception.Message;
            comfyUiOperationAlertStyle = AlertStyle.Danger;
            NotificationService.Notify(NotificationSeverity.Error, "ComfyUI operation failed", exception.Message);
        }
        finally
        {
            isExecutingComfyUiOperation = false;
        }
    }

