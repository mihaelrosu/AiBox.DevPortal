@page "/workflows/history/{RunId}"
@rendermode InteractiveServer

<PageTitle>Workflow Run Details</PageTitle>

@if (isLoading)
{
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
}
else if (run is null)
{
    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText Text="Workflow run not found" TextStyle="TextStyle.H5" />
            <RadzenButton Text="Back to History" Icon="arrow_back" ButtonStyle="ButtonStyle.Primary" Click="@BackToHistory" />
        </RadzenStack>
    </RadzenCard>
}
else
{
    <div class="page-header">
        <div>
            <h1>@run.WorkflowName</h1>
            <p>@run.Created.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</p>
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
            <RadzenButton Text="Export Codex Task" Icon="description" ButtonStyle="ButtonStyle.Light"
                          Click="@ExportCodexTaskAsync"
                          Disabled="@(isBusy || isExecutingAll || executingStepId is not null)" />
            <RadzenButton Text="Run All with Local LLM" Icon="play_circle" ButtonStyle="ButtonStyle.Primary"
                          Click="@ExecuteAllWithLocalLlmAsync"
                          Disabled="@(isBusy || isExecutingAll || executingStepId is not null)" />
            @if (isExecutingAll)
            {
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            }
            <RadzenButton Text="Back to History" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@BackToHistory" Disabled="@isExecutingAll" />
        </RadzenStack>
    </div>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenText Text="@($"{CompletedSteps} / {TotalSteps} steps completed")" TextStyle="TextStyle.H6" />
                <RadzenBadge Text="@run.Status.ToString()" BadgeStyle="@RunStatusBadgeStyle(run.Status)" />
            </RadzenStack>
            <RadzenProgressBar Value="@ProgressPercent" ShowValue="false" />

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenText Text="Project" TextStyle="TextStyle.Caption" />
                    <RadzenText Text="@ProjectDisplayText(run.ProjectSnapshot)" TextStyle="TextStyle.Body1" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenText Text="Run ID" TextStyle="TextStyle.Caption" />
                    <RadzenText Text="@run.Id" TextStyle="TextStyle.Body1" />
                </RadzenColumn>
            </RadzenRow>

            @if (run.ProjectSnapshot is not null)
            {
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText Text="Local path" TextStyle="TextStyle.Caption" />
                        <RadzenText Text="@run.ProjectSnapshot.LocalPath" TextStyle="TextStyle.Body1" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText Text="Repository" TextStyle="TextStyle.Caption" />
                        <RadzenText Text="@run.ProjectSnapshot.GitRepository" TextStyle="TextStyle.Body1" />
                    </RadzenColumn>
                </RadzenRow>
            }

            <div>
                <RadzenText Text="Goal" TextStyle="TextStyle.Caption" />
                <RadzenText Text="@run.GoalText" TextStyle="TextStyle.Body1" />
            </div>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenText Text="Verification" TextStyle="TextStyle.H5" />
                    @if (verificationResult is not null)
                    {
                        <RadzenBadge Text="@verificationResult.Status.ToString()" BadgeStyle="@VerificationStatusBadgeStyle(verificationResult.Status)" />
                    }
                </RadzenStack>
                <RadzenButton Text="Run Verification" Icon="fact_check" ButtonStyle="ButtonStyle.Primary"
                              Click="@RunVerificationAsync"
                              Disabled="@(isRunningVerification || isBusy || isExecutingAll || executingStepId is not null)" />
            </RadzenStack>

            @if (isRunningVerification)
            {
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
            }

            @if (verificationResult is not null)
            {
                <div>
                    <RadzenText Text="Summary" TextStyle="TextStyle.Caption" />
                    <RadzenText Text="@verificationResult.Summary" TextStyle="TextStyle.Body1" />
                </div>
                <div>
                    <RadzenText Text="Recommended next action" TextStyle="TextStyle.Caption" />
                    <RadzenText Text="@verificationResult.RecommendedNextAction" TextStyle="TextStyle.Body1" />
                </div>

                <AppDataGrid @ref="grid1" Data="@verificationResult.Checks" TItem="VerificationCheck" EmptyText="No verification checks recorded.">
                    <Columns>
                        <RadzenDataGridColumn TItem="VerificationCheck" Property="Name" Title="Check" />
                        <RadzenDataGridColumn TItem="VerificationCheck" Title="Status">
                            <Template Context="item">
                                <RadzenBadge Text="@item.Status.ToString()" BadgeStyle="@VerificationStatusBadgeStyle(item.Status)" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="VerificationCheck" Title="Severity">
                            <Template Context="item">
                                <RadzenBadge Text="@item.Severity.ToString()" BadgeStyle="@VerificationSeverityBadgeStyle(item.Severity)" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="VerificationCheck" Property="Message" Title="Message" />
                    </Columns>
                </AppDataGrid>

                @if (!string.IsNullOrWhiteSpace(verificationResult.LocalLlmReview))
                {
                    <RadzenFormField Text="Local LLM verifier review" Style="width: 100%;">
                        <pre style="white-space: pre-wrap; overflow-wrap: anywhere; padding: 1rem; border-radius: 0.25rem; background: var(--rz-base-200);">@verificationResult.LocalLlmReview</pre>
                    </RadzenFormField>
                }
            }

            @if (!string.IsNullOrWhiteSpace(verificationMessage))
            {
                <RadzenAlert AlertStyle="@verificationAlertStyle" ShowIcon="true">@verificationMessage</RadzenAlert>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText Text="Implementator Execution" TextStyle="TextStyle.H5" />

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Step" Style="width: 100%;">
                        <RadzenDropDown TValue="string"
                                        Data="@executionStepOptions"
                                        TextProperty="StepName"
                                        ValueProperty="StepId"
                                        @bind-Value="@selectedExecutionStepId"
                                        Change="@OnExecutionStepChangedAsync"
                                        Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Command type" Style="width: 100%;">
                        <RadzenDropDown TValue="ExecutionCommandType"
                                        Data="@commandTypes"
                                        @bind-Value="@executionCommandType"
                                        Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Working directory" Style="width: 100%;">
                        <RadzenTextBox @bind-Value="@executionWorkingDirectory" Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Command" Style="width: 100%;">
                        <RadzenTextBox @bind-Value="@executionCommand" Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Arguments" Style="width: 100%;">
                        <RadzenTextBox @bind-Value="@executionArguments" Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Gap="0.75rem">
                <RadzenText Text="Safe presets" TextStyle="TextStyle.Caption" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenButton Text="dotnet build" ButtonStyle="ButtonStyle.Light" Click="@SetDotNetBuildPreset" />
                    <RadzenButton Text="dotnet test" ButtonStyle="ButtonStyle.Light" Click="@SetDotNetTestPreset" />
                    <RadzenButton Text="git status" ButtonStyle="ButtonStyle.Light" Click="@SetGitStatusPreset" />
                    <RadzenButton Text="git diff" ButtonStyle="ButtonStyle.Light" Click="@SetGitDiffPreset" />
                    <RadzenButton Text="docker ps" ButtonStyle="ButtonStyle.Light" Click="@SetDockerPsPreset" />
                    <RadzenButton Text="docker compose ps" ButtonStyle="ButtonStyle.Light" Click="@SetDockerComposePsPreset" />
                </RadzenStack>
            </RadzenStack>

            @if (executionRequiresConfirmation)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenSwitch @bind-Value="@executionConfirmed" />
                    <RadzenLabel Text="I confirm this command is permitted by the selected execution profile." />
                </RadzenStack>
            }

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center">
                <RadzenButton Text="Run Command" Icon="play_arrow" ButtonStyle="ButtonStyle.Primary"
                              Click="@RunExecutionAsync"
                              Disabled="@(isBusy || isExecutingAll || executingStepId is not null || isExecutingCommand || string.IsNullOrWhiteSpace(selectedExecutionStepId))" />
                @if (isExecutingCommand)
                {
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                }
            </RadzenStack>

            @if (latestExecutionResult is not null)
            {
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                            <RadzenText Text="Latest result" TextStyle="TextStyle.H6" />
                            <RadzenBadge Text="@latestExecutionResult.Status.ToString()" BadgeStyle="@ExecutionStatusBadgeStyle(latestExecutionResult.Status)" />
                        </RadzenStack>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenText Text="Exit code" TextStyle="TextStyle.Caption" />
                                <RadzenText Text="@DisplayTextOrNa(latestExecutionResult.ExitCode?.ToString())" TextStyle="TextStyle.Body1" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenText Text="Working directory" TextStyle="TextStyle.Caption" />
                                <RadzenText Text="@latestExecutionResult.WorkingDirectory" TextStyle="TextStyle.Body1" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenText Text="Command" TextStyle="TextStyle.Caption" />
                                <RadzenText Text="@latestExecutionResult.CommandText" TextStyle="TextStyle.Body1" />
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenFormField Text="Standard output" Style="width: 100%;">
                            <pre style="white-space: pre-wrap; overflow-wrap: anywhere; padding: 1rem; border-radius: 0.25rem; background: var(--rz-base-200);">@latestExecutionResult.StandardOutput</pre>
                        </RadzenFormField>

                        <RadzenFormField Text="Standard error" Style="width: 100%;">
                            <pre style="white-space: pre-wrap; overflow-wrap: anywhere; padding: 1rem; border-radius: 0.25rem; background: var(--rz-base-200);">@latestExecutionResult.StandardError</pre>
                        </RadzenFormField>
                    </RadzenStack>
                </RadzenCard>
            }

            @if (!string.IsNullOrWhiteSpace(executionMessage))
            {
                <RadzenAlert AlertStyle="@executionAlertStyle" ShowIcon="true">
                    @executionMessage
                </RadzenAlert>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText Text="Implementator File Operations" TextStyle="TextStyle.H5" />

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Operation" Style="width: 100%;">
                        <RadzenDropDown TValue="FileOperationType"
                                        Data="@fileOperationTypes"
                                        @bind-Value="@fileOperationType"
                                        Change="@OnFileOperationTypeChangedAsync"
                                        Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Path" Style="width: 100%;">
                        <RadzenTextBox @bind-Value="@fileOperationPath" Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                @if (RequiresTargetPath(fileOperationType))
                {
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Target path" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="@fileOperationTargetPath" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                }
            </RadzenRow>

            <RadzenFormField Text="Content" Style="width: 100%;">
                <RadzenTextArea @bind-Value="@fileOperationContent" Rows="12" Style="width: 100%;" />
            </RadzenFormField>

            <RadzenStack Gap="0.75rem">
                <RadzenText Text="Safe presets" TextStyle="TextStyle.Caption" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenButton Text="Read Program.cs" ButtonStyle="ButtonStyle.Light" Click="@SetReadProgramPreset" />
                    <RadzenButton Text="Read appsettings.json" ButtonStyle="ButtonStyle.Light" Click="@SetReadAppSettingsPreset" />
                    <RadzenButton Text="List project root" ButtonStyle="ButtonStyle.Light" Click="@SetListProjectRootPreset" />
                    <RadzenButton Text="List Components/Pages" ButtonStyle="ButtonStyle.Light" Click="@SetListComponentsPagesPreset" />
                    <RadzenButton Text="List Services" ButtonStyle="ButtonStyle.Light" Click="@SetListServicesPreset" />
                    <RadzenButton Text="Create Razor page" ButtonStyle="ButtonStyle.Light" Click="@SetCreateRazorPagePreset" />
                    <RadzenButton Text="Create service class" ButtonStyle="ButtonStyle.Light" Click="@SetCreateServiceClassPreset" />
                </RadzenStack>
            </RadzenStack>

            @if (fileOperationType == FileOperationType.Delete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenSwitch @bind-Value="@fileOperationConfirmed" />
                    <RadzenLabel Text="I confirm this delete operation is intentional." />
                </RadzenStack>
            }

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center">
                <RadzenButton Text="Execute File Operation" Icon="folder_open" ButtonStyle="ButtonStyle.Primary"
                              Click="@ExecuteFileOperationAsync"
                              Disabled="@(isBusy || isExecutingAll || executingStepId is not null || isExecutingCommand || isExecutingFileOperation || string.IsNullOrWhiteSpace(selectedExecutionStepId) || (fileOperationType == FileOperationType.Delete && !fileOperationConfirmed))" />
                @if (isExecutingFileOperation)
                {
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                }
            </RadzenStack>

            @if (fileOperationLatestResult is not null)
            {
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                            <RadzenText Text="Latest file operation" TextStyle="TextStyle.H6" />
                            <RadzenBadge Text="@ResultLabel(fileOperationLatestResult.Success)"
                                         BadgeStyle="@(fileOperationLatestResult.Success ? BadgeStyle.Success : BadgeStyle.Danger)" />
                        </RadzenStack>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenText Text="Operation" TextStyle="TextStyle.Caption" />
                                <RadzenText Text="@fileOperationLatestResult.OperationType.ToString()" TextStyle="TextStyle.Body1" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenText Text="Path" TextStyle="TextStyle.Caption" />
                                <RadzenText Text="@fileOperationLatestResult.Path" TextStyle="TextStyle.Body1" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenText Text="Target" TextStyle="TextStyle.Caption" />
                                <RadzenText Text="@DisplayTextOrNa(fileOperationLatestResult.TargetPath)" TextStyle="TextStyle.Body1" />
                            </RadzenColumn>
                        </RadzenRow>

                        <div>
                            <RadzenText Text="Message" TextStyle="TextStyle.Caption" />
                            <RadzenText Text="@fileOperationLatestResult.Message" TextStyle="TextStyle.Body1" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(fileOperationLatestResult.ContentPreview))
                        {
                            <RadzenFormField Text="Content preview" Style="width: 100%;">
                                <pre style="white-space: pre-wrap; overflow-wrap: anywhere; padding: 1rem; border-radius: 0.25rem; background: var(--rz-base-200);">@fileOperationLatestResult.ContentPreview</pre>
                            </RadzenFormField>
                        }
                    </RadzenStack>
                </RadzenCard>
            }

            @if (!string.IsNullOrWhiteSpace(fileOperationMessage))
            {
                <RadzenAlert AlertStyle="@fileOperationAlertStyle" ShowIcon="true">
                    @fileOperationMessage
                </RadzenAlert>
            }

            <AppDataGrid @ref="grid2" Data="@fileOperationHistory" TItem="FileOperationResult" PageSize="5" EmptyText="No file operations recorded yet.">
                <Columns>
                    <RadzenDataGridColumn TItem="FileOperationResult" Property="CreatedAt" Title="Created">
                        <Template Context="item">
                            @item.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FileOperationResult" Property="OperationType" Title="Operation" />
                    <RadzenDataGridColumn TItem="FileOperationResult" Property="Path" Title="Path" />
                    <RadzenDataGridColumn TItem="FileOperationResult" Property="TargetPath" Title="Target" />
                    <RadzenDataGridColumn TItem="FileOperationResult" Title="Result">
                        <Template Context="item">
                            <RadzenBadge Text="@ResultLabel(item.Success)"
                                         BadgeStyle="@(item.Success ? BadgeStyle.Success : BadgeStyle.Danger)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FileOperationResult" Property="Message" Title="Message" />
                </Columns>
            </AppDataGrid>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText Text="Git Operations" TextStyle="TextStyle.H5" />

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Operation" Style="width: 100%;">
                        <RadzenDropDown TValue="GitOperationType"
                                        Data="@gitOperationTypes"
                                        @bind-Value="@gitOperationType"
                                        Change="@OnGitOperationTypeChangedAsync"
                                        Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Branch name" Style="width: 100%;">
                        <RadzenTextBox @bind-Value="@gitBranchName" Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Commit message" Style="width: 100%;">
                        <RadzenTextBox @bind-Value="@gitCommitMessage" Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenFormField Text="File paths" Style="width: 100%;">
                <RadzenTextArea @bind-Value="@gitFilePaths" Rows="4" Style="width: 100%;" />
            </RadzenFormField>

            <RadzenStack Gap="0.75rem">
                <RadzenText Text="Safe presets" TextStyle="TextStyle.Caption" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenButton Text="status" ButtonStyle="ButtonStyle.Light" Click="@SetGitStatusPreset" />
                    <RadzenButton Text="diff" ButtonStyle="ButtonStyle.Light" Click="@SetGitDiffPreset" />
                    <RadzenButton Text="current branch" ButtonStyle="ButtonStyle.Light" Click="@SetGitCurrentBranchPreset" />
                    <RadzenButton Text="recent log" ButtonStyle="ButtonStyle.Light" Click="@SetGitRecentLogPreset" />
                    <RadzenButton Text="create feature branch" ButtonStyle="ButtonStyle.Light" Click="@SetGitCreateFeatureBranchPreset" />
                    <RadzenButton Text="add selected files" ButtonStyle="ButtonStyle.Light" Click="@SetGitAddSelectedFilesPreset" />
                    <RadzenButton Text="commit selected files" ButtonStyle="ButtonStyle.Light" Click="@SetGitCommitSelectedFilesPreset" />
                </RadzenStack>
            </RadzenStack>

            @if (gitOperationRequiresConfirmation)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenSwitch @bind-Value="@gitConfirmed" />
                    <RadzenLabel Text="I confirm this Git operation is intentional." />
                </RadzenStack>
            }

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center">
                <RadzenButton Text="Run Git Operation" Icon="call_split" ButtonStyle="ButtonStyle.Primary"
                              Click="@ExecuteGitOperationAsync"
                              Disabled="@(isBusy || isExecutingAll || executingStepId is not null || isExecutingCommand || isExecutingFileOperation || isExecutingGitOperation || string.IsNullOrWhiteSpace(selectedExecutionStepId) || (gitOperationRequiresConfirmation && !gitConfirmed))" />
                @if (isExecutingGitOperation)
                {
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                }
            </RadzenStack>

            @if (gitOperationLatestResult is not null)
            {
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                            <RadzenText Text="Latest Git result" TextStyle="TextStyle.H6" />
                            <RadzenBadge Text="@ResultLabel(gitOperationLatestResult.Success)"
                                         BadgeStyle="@(gitOperationLatestResult.Success ? BadgeStyle.Success : BadgeStyle.Danger)" />
                        </RadzenStack>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenText Text="Operation" TextStyle="TextStyle.Caption" />
                                <RadzenText Text="@gitOperationLatestResult.OperationType.ToString()" TextStyle="TextStyle.Body1" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenText Text="Exit code" TextStyle="TextStyle.Caption" />
                                <RadzenText Text="@DisplayTextOrNa(gitOperationLatestResult.ExitCode?.ToString())" TextStyle="TextStyle.Body1" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenText Text="Branch" TextStyle="TextStyle.Caption" />
                                <RadzenText Text="@DisplayTextOrNa(gitOperationLatestResult.BranchName)" TextStyle="TextStyle.Body1" />
                            </RadzenColumn>
                        </RadzenRow>

                        <div>
                            <RadzenText Text="Message" TextStyle="TextStyle.Caption" />
                            <RadzenText Text="@gitOperationLatestResult.Message" TextStyle="TextStyle.Body1" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(gitOperationLatestResult.StandardOutput))
                        {
                            <RadzenFormField Text="Standard output" Style="width: 100%;">
                                <pre style="white-space: pre-wrap; overflow-wrap: anywhere; padding: 1rem; border-radius: 0.25rem; background: var(--rz-base-200);">@gitOperationLatestResult.StandardOutput</pre>
                            </RadzenFormField>
                        }

                        @if (!string.IsNullOrWhiteSpace(gitOperationLatestResult.StandardError))
                        {
                            <RadzenFormField Text="Standard error" Style="width: 100%;">
                                <pre style="white-space: pre-wrap; overflow-wrap: anywhere; padding: 1rem; border-radius: 0.25rem; background: var(--rz-base-200);">@gitOperationLatestResult.StandardError</pre>
                            </RadzenFormField>
                        }
                    </RadzenStack>
                </RadzenCard>
            }

            @if (!string.IsNullOrWhiteSpace(gitOperationMessage))
            {
                <RadzenAlert AlertStyle="@gitOperationAlertStyle" ShowIcon="true">
                    @gitOperationMessage
                </RadzenAlert>
            }

            <AppDataGrid @ref="grid3" Data="@gitOperationHistory" TItem="GitOperationResult" PageSize="5" EmptyText="No Git operations recorded yet.">
                <Columns>
                    <RadzenDataGridColumn TItem="GitOperationResult" Property="CreatedAt" Title="Created">
                        <Template Context="item">
                            @item.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="GitOperationResult" Property="OperationType" Title="Operation" />
                    <RadzenDataGridColumn TItem="GitOperationResult" Property="BranchName" Title="Branch" />
                    <RadzenDataGridColumn TItem="GitOperationResult" Property="CommitMessage" Title="Commit message" />
                    <RadzenDataGridColumn TItem="GitOperationResult" Title="Result">
                        <Template Context="item">
                            <RadzenBadge Text="@ResultLabel(item.Success)"
                                         BadgeStyle="@(item.Success ? BadgeStyle.Success : BadgeStyle.Danger)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="GitOperationResult" Property="Message" Title="Message" />
                </Columns>
            </AppDataGrid>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText Text="Docker Operations" TextStyle="TextStyle.H5" />

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Operation" Style="width: 100%;">
                        <RadzenDropDown TValue="DockerOperationType"
                                        Data="@dockerOperationTypes"
                                        @bind-Value="@dockerOperationType"
                                        Change="@OnDockerOperationTypeChangedAsync"
                                        Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="5">
                    <RadzenFormField Text="Compose file path" Style="width: 100%;">
                        <RadzenTextBox @bind-Value="@dockerComposeFilePath" Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Service name" Style="width: 100%;">
                        <RadzenTextBox @bind-Value="@dockerServiceName" Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="1">
                    <RadzenFormField Text="Lines" Style="width: 100%;">
                        <RadzenNumeric TValue="int" @bind-Value="@dockerLines" Min="1" Max="10000" Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Gap="0.75rem">
                <RadzenText Text="Safe presets" TextStyle="TextStyle.Caption" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenButton Text="docker ps" ButtonStyle="ButtonStyle.Light" Click="@SetDockerOperationPsPreset" />
                    <RadzenButton Text="docker images" ButtonStyle="ButtonStyle.Light" Click="@SetDockerImagesPreset" />
                    <RadzenButton Text="compose ps" ButtonStyle="ButtonStyle.Light" Click="@SetDockerComposeOperationPsPreset" />
                    <RadzenButton Text="compose up" ButtonStyle="ButtonStyle.Light" Click="@SetDockerComposeUpPreset" />
                    <RadzenButton Text="compose restart" ButtonStyle="ButtonStyle.Light" Click="@SetDockerComposeRestartPreset" />
                    <RadzenButton Text="container logs" ButtonStyle="ButtonStyle.Light" Click="@SetDockerLogsPreset" />
                </RadzenStack>
            </RadzenStack>

            @if (dockerOperationRequiresConfirmation)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenSwitch @bind-Value="@dockerConfirmed" />
                    <RadzenLabel Text="I confirm this Docker operation is intentional." />
                </RadzenStack>
            }

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center">
                <RadzenButton Text="Run Docker Operation" Icon="deployed_code" ButtonStyle="ButtonStyle.Primary"
                              Click="@ExecuteDockerOperationAsync"
                              Disabled="@(isBusy || isExecutingAll || executingStepId is not null || isExecutingCommand || isExecutingFileOperation || isExecutingGitOperation || isExecutingDockerOperation || string.IsNullOrWhiteSpace(selectedExecutionStepId) || (dockerOperationRequiresConfirmation && !dockerConfirmed))" />
                @if (isExecutingDockerOperation)
                {
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                }
            </RadzenStack>

            @if (dockerOperationLatestResult is not null)
            {
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                            <RadzenText Text="Latest Docker result" TextStyle="TextStyle.H6" />
                            <RadzenBadge Text="@ResultLabel(dockerOperationLatestResult.Success)"
                                         BadgeStyle="@(dockerOperationLatestResult.Success ? BadgeStyle.Success : BadgeStyle.Danger)" />
                        </RadzenStack>
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenText Text="Operation" TextStyle="TextStyle.Caption" />
                                <RadzenText Text="@dockerOperationLatestResult.OperationType.ToString()" TextStyle="TextStyle.Body1" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenText Text="Exit code" TextStyle="TextStyle.Caption" />
                                <RadzenText Text="@DisplayTextOrNa(dockerOperationLatestResult.ExitCode?.ToString())" TextStyle="TextStyle.Body1" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenText Text="Command" TextStyle="TextStyle.Caption" />
                                <RadzenText Text="@DisplayTextOrNa(dockerOperationLatestResult.CommandText)" TextStyle="TextStyle.Body1" />
                            </RadzenColumn>
                        </RadzenRow>
                        <div>
                            <RadzenText Text="Message" TextStyle="TextStyle.Caption" />
                            <RadzenText Text="@dockerOperationLatestResult.Message" TextStyle="TextStyle.Body1" />
                        </div>
                        <RadzenFormField Text="Standard output" Style="width: 100%;">
                            <pre style="white-space: pre-wrap; overflow-wrap: anywhere; padding: 1rem; border-radius: 0.25rem; background: var(--rz-base-200);">@dockerOperationLatestResult.StandardOutput</pre>
                        </RadzenFormField>
                        <RadzenFormField Text="Standard error" Style="width: 100%;">
                            <pre style="white-space: pre-wrap; overflow-wrap: anywhere; padding: 1rem; border-radius: 0.25rem; background: var(--rz-base-200);">@dockerOperationLatestResult.StandardError</pre>
                        </RadzenFormField>
                    </RadzenStack>
                </RadzenCard>
            }

            @if (!string.IsNullOrWhiteSpace(dockerOperationMessage))
            {
                <RadzenAlert AlertStyle="@dockerOperationAlertStyle" ShowIcon="true">@dockerOperationMessage</RadzenAlert>
            }

            <AppDataGrid @ref="grid4" Data="@dockerOperationHistory" TItem="DockerOperationResult" PageSize="5" EmptyText="No Docker operations recorded yet.">
                <Columns>
                    <RadzenDataGridColumn TItem="DockerOperationResult" Property="CreatedAt" Title="Created">
                        <Template Context="item">@item.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DockerOperationResult" Property="OperationType" Title="Operation" />
                    <RadzenDataGridColumn TItem="DockerOperationResult" Property="ServiceName" Title="Service" />
                    <RadzenDataGridColumn TItem="DockerOperationResult" Property="ExitCode" Title="Exit code" />
                    <RadzenDataGridColumn TItem="DockerOperationResult" Title="Result">
                        <Template Context="item">
                            <RadzenBadge Text="@ResultLabel(item.Success)" BadgeStyle="@(item.Success ? BadgeStyle.Success : BadgeStyle.Danger)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DockerOperationResult" Property="Message" Title="Message" />
                </Columns>
            </AppDataGrid>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText Text="ComfyUI Operations" TextStyle="TextStyle.H5" />

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Operation" Style="width: 100%;">
                        <RadzenDropDown TValue="ComfyUiOperationType"
                                        Data="@comfyUiOperationTypes"
                                        @bind-Value="@comfyUiOperationType"
                                        Change="@OnComfyUiOperationTypeChangedAsync"
                                        Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenFormField Text="Workflow file" Style="width: 100%;">
                        <RadzenDropDown TValue="string"
                                        Data="@comfyUiWorkflowFiles"
                                        TextProperty="FileName"
                                        ValueProperty="FileName"
                                        @bind-Value="@comfyUiWorkflowFileName"
                                        AllowClear="true"
                                        Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenFormField Text="Workflow JSON" Style="width: 100%;">
                <RadzenTextArea @bind-Value="@comfyUiWorkflowJson" Rows="14" Style="width: 100%;" />
            </RadzenFormField>

            <RadzenStack Gap="0.75rem">
                <RadzenText Text="Safe presets" TextStyle="TextStyle.Caption" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenButton Text="check ComfyUI health" ButtonStyle="ButtonStyle.Light" Click="@SetComfyUiHealthPreset" />
                    <RadzenButton Text="list workflows" ButtonStyle="ButtonStyle.Light" Click="@SetComfyUiListWorkflowsPreset" />
                    <RadzenButton Text="list models" ButtonStyle="ButtonStyle.Light" Click="@SetComfyUiListModelsPreset" />
                    <RadzenButton Text="backup workflows" ButtonStyle="ButtonStyle.Light" Click="@SetComfyUiBackupPreset" />
                    <RadzenButton Text="queue selected workflow" ButtonStyle="ButtonStyle.Light" Click="@SetComfyUiQueuePreset" />
                </RadzenStack>
            </RadzenStack>

            @if (comfyUiOperationRequiresConfirmation)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenSwitch @bind-Value="@comfyUiConfirmed" />
                    <RadzenLabel Text="I confirm this ComfyUI operation is intentional." />
                </RadzenStack>
            }

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center">
                <RadzenButton Text="Run ComfyUI Operation" Icon="account_tree" ButtonStyle="ButtonStyle.Primary"
                              Click="@ExecuteComfyUiOperationAsync"
                              Disabled="@(isBusy || isExecutingAll || executingStepId is not null || isExecutingCommand || isExecutingFileOperation || isExecutingGitOperation || isExecutingDockerOperation || isExecutingComfyUiOperation || string.IsNullOrWhiteSpace(selectedExecutionStepId) || (comfyUiOperationRequiresConfirmation && !comfyUiConfirmed))" />
                @if (isExecutingComfyUiOperation)
                {
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                }
            </RadzenStack>

            @if (comfyUiOperationLatestResult is not null)
            {
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                            <RadzenText Text="Latest ComfyUI result" TextStyle="TextStyle.H6" />
                            <RadzenBadge Text="@ResultLabel(comfyUiOperationLatestResult.Success)"
                                         BadgeStyle="@(comfyUiOperationLatestResult.Success ? BadgeStyle.Success : BadgeStyle.Danger)" />
                        </RadzenStack>
                        <div>
                            <RadzenText Text="Message" TextStyle="TextStyle.Caption" />
                            <RadzenText Text="@comfyUiOperationLatestResult.Message" TextStyle="TextStyle.Body1" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(comfyUiOperationLatestResult.PromptId))
                        {
                            <div>
                                <RadzenText Text="Prompt ID" TextStyle="TextStyle.Caption" />
                                <RadzenText Text="@comfyUiOperationLatestResult.PromptId" TextStyle="TextStyle.Body1" />
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(comfyUiOperationLatestResult.ImageUrl))
                        {
                            <div>
                                <RadzenText Text="Image URL" TextStyle="TextStyle.Caption" />
                                <RadzenLink Path="@comfyUiOperationLatestResult.ImageUrl" Text="@comfyUiOperationLatestResult.ImageUrl" Target="_blank" />
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(comfyUiOperationLatestResult.ResultJson))
                        {
                            <RadzenFormField Text="Result" Style="width: 100%;">
                                <pre style="white-space: pre-wrap; overflow-wrap: anywhere; padding: 1rem; border-radius: 0.25rem; background: var(--rz-base-200);">@comfyUiOperationLatestResult.ResultJson</pre>
                            </RadzenFormField>
                        }
                    </RadzenStack>
                </RadzenCard>
            }

            @if (!string.IsNullOrWhiteSpace(comfyUiOperationMessage))
            {
                <RadzenAlert AlertStyle="@comfyUiOperationAlertStyle" ShowIcon="true">@comfyUiOperationMessage</RadzenAlert>
            }

            <AppDataGrid @ref="grid5" Data="@comfyUiOperationHistory" TItem="ComfyUiOperationResult" PageSize="5" EmptyText="No ComfyUI operations recorded yet.">
                <Columns>
                    <RadzenDataGridColumn TItem="ComfyUiOperationResult" Property="CreatedAt" Title="Created">
                        <Template Context="item">@item.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ComfyUiOperationResult" Property="OperationType" Title="Operation" />
                    <RadzenDataGridColumn TItem="ComfyUiOperationResult" Property="WorkflowFileName" Title="Workflow" />
                    <RadzenDataGridColumn TItem="ComfyUiOperationResult" Property="PromptId" Title="Prompt ID" />
                    <RadzenDataGridColumn TItem="ComfyUiOperationResult" Title="Result">
                        <Template Context="item">
                            <RadzenBadge Text="@ResultLabel(item.Success)" BadgeStyle="@(item.Success ? BadgeStyle.Success : BadgeStyle.Danger)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ComfyUiOperationResult" Property="Message" Title="Message" />
                </Columns>
            </AppDataGrid>
        </RadzenStack>
    </RadzenCard>

    @foreach (var step in run.Steps.OrderBy(step => step.Order))
    {
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                        <RadzenBadge Text="@step.Order.ToString()" BadgeStyle="BadgeStyle.Primary" />
                        <RadzenText Text="@step.StepName" TextStyle="TextStyle.H6" />
                        <RadzenBadge Text="@step.Status.ToString()" BadgeStyle="@StepStatusBadgeStyle(step.Status)" />
                        @if (!step.Enabled)
                        {
                            <RadzenBadge Text="Disabled" BadgeStyle="BadgeStyle.Secondary" />
                        }
                    </RadzenStack>
                    <RadzenButton Text="Copy prompt" Icon="content_copy" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => CopyPromptAsync(step))" />
                </RadzenStack>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenText Text="Agent" TextStyle="TextStyle.Caption" />
                        <RadzenText Text="@step.AgentName" TextStyle="TextStyle.Subtitle1" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenText Text="Model" TextStyle="TextStyle.Caption" />
                        <RadzenText Text="@step.Model" TextStyle="TextStyle.Subtitle1" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenText Text="Timing" TextStyle="TextStyle.Caption" />
                        <RadzenText Text="@TimingText(step)" TextStyle="TextStyle.Body2" />
                    </RadzenColumn>
                </RadzenRow>

                <div>
                    <RadzenText Text="Instruction" TextStyle="TextStyle.Caption" />
                    <RadzenText Text="@step.Instruction" TextStyle="TextStyle.Body1" />
                </div>

                <div>
                    <RadzenText Text="Generated Prompt" TextStyle="TextStyle.Caption" />
                    <pre style="white-space: pre-wrap; overflow-wrap: anywhere; padding: 1rem; border-radius: 0.25rem; background: var(--rz-base-200);">@step.GeneratedTaskPrompt</pre>
                </div>

                <RadzenFormField Text="Result" Style="width: 100%;">
                    <RadzenTextArea @bind-Value="@step.ResultText" Rows="8" Style="width: 100%;" />
                </RadzenFormField>

                <RadzenFormField Text="Notes" Style="width: 100%;">
                    <RadzenTextArea @bind-Value="@step.Notes" Rows="4" Style="width: 100%;" />
                </RadzenFormField>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenButton Text="Run with Local LLM" Icon="psychology" ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => ExecuteWithLocalLlmAsync(step))"
                                  Disabled="@(!step.Enabled || isBusy || isExecutingAll || executingStepId is not null)" />
                    @if (executingStepId == step.StepId)
                    {
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                    }
                    <RadzenButton Text="Save Result & Complete" Icon="save" ButtonStyle="ButtonStyle.Success"
                                  Click="@(() => SaveResultAsync(step))" Disabled="@(isBusy || isExecutingAll || executingStepId is not null)" />
                    <RadzenButton Text="Mark Running" Icon="play_arrow" ButtonStyle="ButtonStyle.Info"
                                  Click="@(() => SetStatusAsync(step, WorkflowRunStepStatus.Running))" Disabled="@(isBusy || isExecutingAll || executingStepId is not null)" />
                    <RadzenButton Text="Mark Completed" Icon="check_circle" ButtonStyle="ButtonStyle.Success"
                                  Click="@(() => SetStatusAsync(step, WorkflowRunStepStatus.Completed))" Disabled="@(isBusy || isExecutingAll || executingStepId is not null)" />
                    <RadzenButton Text="Mark Failed" Icon="error" ButtonStyle="ButtonStyle.Danger"
                                  Click="@(() => SetStatusAsync(step, WorkflowRunStepStatus.Failed))" Disabled="@(isBusy || isExecutingAll || executingStepId is not null)" />
                    <RadzenButton Text="Mark Skipped" Icon="skip_next" ButtonStyle="ButtonStyle.Warning"
                                  Click="@(() => SetStatusAsync(step, WorkflowRunStepStatus.Skipped))" Disabled="@(isBusy || isExecutingAll || executingStepId is not null)" />
                </RadzenStack>

                @if (executionErrorStepId == step.StepId && !string.IsNullOrWhiteSpace(executionError))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true">
                        @executionError
                    </RadzenAlert>
                }
            </RadzenStack>
        </RadzenCard>
    }
}

@code {
    [Parameter] public string RunId { get; set; } = string.Empty;

    [Inject] private IWorkflowRunHistoryService HistoryService { get; set; } = default!;
    [Inject] private IExecutionEngineService ExecutionEngine { get; set; } = default!;
    [Inject] private IFileOperationService FileOperations { get; set; } = default!;
    [Inject] private IGitOperationService GitOperations { get; set; } = default!;
    [Inject] private IDockerOperationService DockerOperations { get; set; } = default!;
    [Inject] private IComfyUiOperationService ComfyUiOperations { get; set; } = default!;
    [Inject] private IComfyUiService ComfyUiService { get; set; } = default!;
    [Inject] private IVerificationService VerificationService { get; set; } = default!;
    [Inject] private IAgentRegistryService AgentRegistry { get; set; } = default!;
    [Inject] private IExecutionPermissionProfileService ExecutionPermissionProfiles { get; set; } = default!;
    [Inject] private DialogService DialogService { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Inject] private NotificationService NotificationService { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private object? grid1;
    private object? grid2;
    private object? grid3;
    private object? grid4;
    private object? grid5;
    private readonly ExecutionCommandType[] commandTypes = Enum.GetValues<ExecutionCommandType>();
    private readonly FileOperationType[] fileOperationTypes = Enum.GetValues<FileOperationType>();
    private WorkflowRunRecord? run;
    private bool isLoading;
    private bool isBusy;
    private bool isExecutingAll;
    private bool isExecutingCommand;
    private bool isExecutingFileOperation;
    private string? executingStepId;
    private string? executionErrorStepId;
    private string? executionError;
    private IReadOnlyList<WorkflowRunStepRecord> executionStepOptions = [];
    private string selectedExecutionStepId = string.Empty;
    private ExecutionCommandType executionCommandType = ExecutionCommandType.DotNet;
    private string executionWorkingDirectory = string.Empty;
    private string executionCommand = string.Empty;
    private string executionArguments = string.Empty;
    private bool executionRequiresConfirmation;
    private bool executionConfirmed;
    private ExecutionResult? latestExecutionResult;
    private string? executionMessage;
    private AlertStyle executionAlertStyle = AlertStyle.Info;
    private FileOperationType fileOperationType = FileOperationType.ListDirectory;
    private string fileOperationPath = string.Empty;
    private string fileOperationTargetPath = string.Empty;
    private string fileOperationContent = string.Empty;
    private bool fileOperationConfirmed;
    private FileOperationResult? fileOperationLatestResult;
    private IReadOnlyList<FileOperationResult> fileOperationHistory = [];
    private string? fileOperationMessage;
    private AlertStyle fileOperationAlertStyle = AlertStyle.Info;
    private readonly GitOperationType[] gitOperationTypes = Enum.GetValues<GitOperationType>();
    private GitOperationType gitOperationType = GitOperationType.Status;
    private string gitBranchName = string.Empty;
    private string gitFilePaths = string.Empty;
    private string gitCommitMessage = string.Empty;
    private bool gitConfirmed;
    private bool gitOperationRequiresConfirmation;
    private bool gitProfileRequiresConfirmation;
    private bool isExecutingGitOperation;
    private GitOperationResult? gitOperationLatestResult;
    private IReadOnlyList<GitOperationResult> gitOperationHistory = [];
    private string? gitOperationMessage;
    private AlertStyle gitOperationAlertStyle = AlertStyle.Info;
    private readonly DockerOperationType[] dockerOperationTypes = Enum.GetValues<DockerOperationType>();
    private DockerOperationType dockerOperationType = DockerOperationType.Ps;
    private string dockerComposeFilePath = "compose.yaml";
    private string dockerServiceName = string.Empty;
    private int dockerLines = 100;
    private bool dockerConfirmed;
    private bool dockerOperationRequiresConfirmation;
    private bool isExecutingDockerOperation;
    private DockerOperationResult? dockerOperationLatestResult;
    private IReadOnlyList<DockerOperationResult> dockerOperationHistory = [];
    private string? dockerOperationMessage;
    private AlertStyle dockerOperationAlertStyle = AlertStyle.Info;
    private readonly ComfyUiOperationType[] comfyUiOperationTypes = Enum.GetValues<ComfyUiOperationType>();
    private ComfyUiOperationType comfyUiOperationType = ComfyUiOperationType.Health;
    private IReadOnlyList<ComfyUiWorkflowFile> comfyUiWorkflowFiles = [];
    private string comfyUiWorkflowFileName = string.Empty;
    private string comfyUiWorkflowJson = string.Empty;
    private bool comfyUiConfirmed;
    private bool comfyUiOperationRequiresConfirmation;
    private bool isExecutingComfyUiOperation;
    private ComfyUiOperationResult? comfyUiOperationLatestResult;
    private IReadOnlyList<ComfyUiOperationResult> comfyUiOperationHistory = [];
    private string? comfyUiOperationMessage;
    private AlertStyle comfyUiOperationAlertStyle = AlertStyle.Info;
    private bool isRunningVerification;
    private VerificationResult? verificationResult;
    private string? verificationMessage;
    private AlertStyle verificationAlertStyle = AlertStyle.Info;

    private int CompletedSteps => run?.Steps.Count(step => step.Enabled && step.Status == WorkflowRunStepStatus.Completed) ?? 0;
    private int TotalSteps => run?.Steps.Count(step => step.Enabled) ?? 0;
    private double ProgressPercent => TotalSteps > 0 ? CompletedSteps * 100d / TotalSteps : 0;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        try
        {
            run = await HistoryService.GetByIdAsync(RunId);
            await InitializeExecutionAsync();
            await LoadFileOperationHistoryAsync();
            await LoadGitOperationHistoryAsync();
            await LoadDockerOperationHistoryAsync();
            await LoadComfyUiOperationHistoryAsync();
            await LoadComfyUiWorkflowFilesAsync();
            verificationResult = run is null ? null : await VerificationService.GetLatestForRunAsync(run.Id);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveResultAsync(WorkflowRunStepRecord step)
    {
        isBusy = true;

        try
        {
            run = await HistoryService.UpdateStepResultAsync(RunId, step.StepId, new WorkflowRunStepResultUpdateRequest
            {
                ResultText = step.ResultText,
                Notes = step.Notes
            });
            NotificationService.Notify(NotificationSeverity.Success, "Step result saved", step.StepName);
        }
        catch (Exception exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Save failed", exception.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RunVerificationAsync()
    {
        if (run is null)
        {
            return;
        }

        isRunningVerification = true;
        verificationMessage = null;

        try
        {
            verificationResult = await VerificationService.VerifyAsync(run.Id, new VerificationRequest
            {
                RunId = run.Id,
                IncludeLocalLlmReview = true
            });
            verificationMessage = verificationResult.Summary;
            verificationAlertStyle = verificationResult.Status switch
            {
                VerificationStatus.Passed => AlertStyle.Success,
                VerificationStatus.Warning => AlertStyle.Warning,
                _ => AlertStyle.Danger
            };
            NotificationService.Notify(
                verificationResult.Status == VerificationStatus.Passed ? NotificationSeverity.Success : NotificationSeverity.Warning,
                "Verification complete",
                verificationResult.Summary);
        }
        catch (Exception exception)
        {
            verificationMessage = exception.Message;
            verificationAlertStyle = AlertStyle.Danger;
            NotificationService.Notify(NotificationSeverity.Error, "Verification failed", exception.Message);
        }
        finally
        {
            isRunningVerification = false;
        }
    }

    private async Task SetStatusAsync(WorkflowRunStepRecord step, WorkflowRunStepStatus status)
    {
        isBusy = true;

        try
        {
            run = await HistoryService.UpdateStepStatusAsync(RunId, step.StepId, status);
        }
        catch (Exception exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Status update failed", exception.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ExecuteWithLocalLlmAsync(WorkflowRunStepRecord step)
    {
        executingStepId = step.StepId;
        executionErrorStepId = null;
        executionError = null;
        step.Status = WorkflowRunStepStatus.Running;
        step.StartedAt ??= DateTimeOffset.UtcNow;
        step.CompletedAt = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            run = await HistoryService.ExecuteStepWithLocalLlmAsync(RunId, step.StepId);

            if (run is null)
            {
                executionErrorStepId = step.StepId;
                executionError = "The workflow run or selected step no longer exists.";
                return;
            }

            NotificationService.Notify(NotificationSeverity.Success, "Local LLM completed", step.StepName);
        }
        catch (Exception exception)
        {
            executionErrorStepId = step.StepId;
            executionError = exception.Message;
            run = await HistoryService.GetByIdAsync(RunId);
            NotificationService.Notify(NotificationSeverity.Error, "Local LLM failed", exception.Message);
        }
        finally
        {
            executingStepId = null;
        }
    }

    private async Task ExecuteAllWithLocalLlmAsync()
    {
        isExecutingAll = true;
        executionErrorStepId = null;
        executionError = null;

        try
        {
            var executionTask = HistoryService.ExecuteAllWithLocalLlmAsync(RunId);

            while (!executionTask.IsCompleted)
            {
                await Task.WhenAny(executionTask, Task.Delay(TimeSpan.FromMilliseconds(500)));

                if (!executionTask.IsCompleted)
                {
                    run = await HistoryService.GetByIdAsync(RunId);
                    await InvokeAsync(StateHasChanged);
                }
            }

            run = await executionTask;

            if (run is null)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Workflow execution failed", "The workflow run no longer exists.");
                return;
            }

            NotificationService.Notify(NotificationSeverity.Success, "Workflow execution completed", run.WorkflowName);
        }
        catch (Exception exception)
        {
            run = await HistoryService.GetByIdAsync(RunId);
            NotificationService.Notify(NotificationSeverity.Error, "Workflow execution failed", exception.Message);
        }
        finally
        {
            isExecutingAll = false;
        }
    }

