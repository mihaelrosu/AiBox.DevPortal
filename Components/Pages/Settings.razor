@page "/settings"

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

<RadzenCard>
    <dl class="settings-list">
        <dt>Environment</dt>
        <dd>@Configuration["AiBox:Environment"]</dd>
        <dt>ComfyUI URL</dt>
        <dd>@Configuration.GetComfyBaseUrl()</dd>
        <dt>Ollama URL</dt>
        <dd>@Configuration.GetOllamaBaseUrl()</dd>
    </dl>
</RadzenCard>

@code {
    [Inject]
    private IConfiguration Configuration { get; set; } = default!;
}
