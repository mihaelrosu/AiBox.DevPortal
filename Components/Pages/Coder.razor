    private async Task ApplyPlanAsync(TaskPlan plan)
    {
        if (taskPlanPreview is null || !string.Equals(taskPlanPreview.Id, plan.Id, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(request.ProjectPath))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Apply plan unavailable", "Select a project before applying the plan.");
            return;
        }

        isApplyingPlan = true;
        planApplyResult = null;

        try
        {
            var result = await TaskPlanApplyService.ApplyAsync(
                taskPlanPreview,
                request.ProjectPath,
                async snapshot =>
                {
                    planApplyResult = snapshot;
                    await InvokeAsync(StateHasChanged);
                },
                CancellationToken.None);

            planApplyResult = result;

            if (result.Success)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Plan applied", result.Summary);
            }
            else if (result.RollbackPerformed)
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Plan apply rolled back", result.Summary);
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Plan apply failed", result.Summary);
            }

            await LoadApplyHistoryAsync();
            await LoadApplyAuditAsync();
            await LoadApprovalStatesAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            planApplyResult = new TaskPlanApplyResult
            {
                PlanId = plan.Id,
                PlanTitle = plan.OriginalRequest,
                Success = false,
                StatusMessage = exception.Message,
                Summary = exception.Message,
                AuditTrail = [exception.Message]
            };
            NotificationService.Notify(NotificationSeverity.Error, "Plan apply failed", exception.Message);
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            isApplyingPlan = false;
        }
    }

