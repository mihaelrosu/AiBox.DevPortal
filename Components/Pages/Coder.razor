    private async Task ExecutePlanTaskAsync(LocalCoderPlanTask planTask)
    {
        if (!await EnsureFileContextLoadedAsync())
        {
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.GeneratePatchPreview,
                success: false,
                "Select files before generating a patch preview.",
                planTasksSnapshot: GetPlanTasksSnapshot());
            return;
        }

        selectedPlanTaskId = planTask.Id;
        activePlanTaskId = planTask.Id;
        UpdatePlanTaskStatus(planTask.Id, LocalCoderPlanTaskStatus.InProgress, "Generating patch preview for the selected task.");
        selectedTabIndex = 2;

        await GeneratePatchPreviewCoreAsync(BuildPlanTaskTaskText(planTask), planTask, null);
    }

    private async Task GeneratePatchPreviewCoreAsync(
        string taskText,
        LocalCoderPlanTask? planTask,
        TaskPlanSlice? taskPlanSlice = null,
        PatchPreviewRepairContext? repairContext = null,
        bool preserveFailedPreviewOnError = false,
        IReadOnlyList<LocalCoderFileContext>? additionalFileContexts = null,
        IReadOnlyList<string>? sliceDebugDetails = null)
    {
        IReadOnlyList<LocalCoderHistoryContextFile> contextSnapshot = [];
        var generatedPlanText = currentTask?.Plan ?? string.Empty;
        isContextLocked = true;
        isGeneratingPatch = true;
        error = null;
        currentTask = null;
        patchIntent = null;
        patchIntentValidation = null;
        applyResult = null;
        rollbackResult = null;
        if (repairContext is null)
        {
            patchPreview = null;
            ClearPatchDebug();
        }
        LastSlicePatchDebugDetails = sliceDebugDetails ?? [];
        lastPatchPlanTask = planTask;
        LastPatchTaskText = taskText;

        var previewRequest = CloneRequest(request, taskText);
        var mergedFileContexts = MergeFileContexts(request.FileContexts, additionalFileContexts).ToList();
        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForGeneratePatchPreview());
            if (taskPlanSlice is null && !await EnsureFileContextLoadedAsync())
            {
                if (planTask is not null)
                {
                    UpdatePlanTaskStatus(planTask.Id, LocalCoderPlanTaskStatus.Failed, "Select files before generating a patch preview.");
                }

                await SaveHistoryEntryAsync(
                    LocalCoderHistoryActionType.GeneratePatchPreview,
                    success: false,
                    "Select files before generating a patch preview.",
                    taskTextOverride: taskText,
                    planTasksSnapshot: GetPlanTasksSnapshot());
                return;
            }

            if (taskPlanSlice is not null && mergedFileContexts.Count == 0)
            {
                await FailSlicePreviewAsync(taskPlanSlice, SlicePreviewMissingTargetsMessage, LastSlicePatchDebugDetails.ToList());
                return;
            }

            previewRequest.FileContexts = mergedFileContexts;
            previewRequest.Task = taskText;
            patchIntent = PatchIntentService.BuildIntent(previewRequest);
            contextSnapshot = CreateContextSnapshot(LocalCoderHistoryActionType.GeneratePatchPreview);
            patchPreview = await AgentModeRunner.GeneratePatchPreviewAsync(previewRequest, profile, repairContext);
            patchPreview.Intent = patchIntent;
            patchPreview.IntentValidation = PatchIntentService.Evaluate(patchIntent!, patchPreview);
            patchIntentValidation = patchPreview.IntentValidation;
            ClearPatchDebug();
            LastPatchRepairSummary = patchPreview.RepairSummary;
            LastPatchPromptAudit = patchPreview.PromptAudit;
            LastPatchPromptTargetResolution = patchPreview.PromptTargetResolution;
            if (planTask is not null)
            {
                UpdatePlanTaskStatus(planTask.Id, LocalCoderPlanTaskStatus.PatchGenerated, "Patch preview generated.");
            }

            if (taskPlanSlice is not null)
            {
                await TaskSliceExecutionService.RecordSliceExecutionResultAsync(new TaskSliceExecutionResult
                {
                    PlanId = taskPlanSlice.PlanId,
                    SliceId = taskPlanSlice.Id,
                    SliceTitle = taskPlanSlice.Title,
                    RequestedAction = "GeneratePatch",
                    PatchPackageId = taskPlanSlice.PatchPackageId,
                    Success = true,
                    BuildSuccess = false,
                    VerificationSuccess = false,
                    Summary = $"{taskPlanSlice.Title}: GeneratePatch succeeded.",
                    AppliedFiles = [],
                    AppliedAt = null,
                    Errors = [],
                    ExecutedAt = DateTime.UtcNow
                });
            }

            try
            {
                selectedPatchPackage = await PatchPackageService.CreateFromPreviewAsync(patchPreview!, taskText);
                if (taskPlanSlice is not null)
                {
                    taskPlanSlice.PatchPackageId = selectedPatchPackage.Id;
                    taskPlanSlice.PatchPreviewCreatedAt = selectedPatchPackage.CreatedAt.UtcDateTime;
                }
                await LoadPatchQueueAsync();
            }
            catch (Exception packageException)
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Patch queue save failed",
                    packageException.Message);
            }

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.GeneratePatchPreview,
                success: true,
                "Patch preview created.",
                planText: generatedPlanText,
                patchPreviewText: patchPreview!.PatchText,
                patchPreviewSnapshot: patchPreview!,
                promptAudit: patchPreview.PromptAudit,
                model: profile.Model,
                taskTextOverride: taskText,
                contextSnapshot: contextSnapshot,
                planTasksSnapshot: GetPlanTasksSnapshot());
            NotificationService.Notify(
                NotificationSeverity.Success,
                "Patch preview created",
                "Local coder generated a patch preview for the selected context.");
            selectedTabIndex = 2;
        }
        catch (PatchPreviewValidationException exception)
        {
            error = null;
            LastPatchRepairSummary = exception.RepairSummary;
            LastPatchPromptAudit = exception.PromptAudit;
            LastPatchPromptTargetResolution = exception.PromptTargetResolution;
            if (!preserveFailedPreviewOnError || repairContext is null)
            {
                LastPatchRawResponse = exception.RawModelResponse;
                LastPatchNormalizedResponse = exception.NormalizedResponse;
                LastPatchNormalizedDiff = exception.NormalizedDiff;
                LastPatchValidationErrors = exception.ValidationErrors.ToArray();
                LastPatchOperationGrammarErrors = exception.OperationGrammarErrors.ToArray();
                LastPatchReplaceDiagnostics = exception.ReplaceDiagnostics.ToArray();
                LastPatchSuggestedTargetDiagnostics = exception.SuggestedTargetDiagnostics.ToArray();
                LastPatchValidationGuidance = exception.Guidance.ToArray();
            }

            if (planTask is not null)
            {
                UpdatePlanTaskStatus(planTask.Id, LocalCoderPlanTaskStatus.Failed, exception.Message);
                activePlanTaskId = null;
            }

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.GeneratePatchPreview,
                success: false,
                exception.Message,
                planText: generatedPlanText,
                taskTextOverride: taskText,
                patchPreviewValidation: exception,
                promptAudit: exception.PromptAudit,
                contextSnapshot: contextSnapshot,
                planTasksSnapshot: GetPlanTasksSnapshot());

            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Patch preview rejected",
                exception.Message);
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
            ClearPatchDebug();
            if (planTask is not null)
            {
                UpdatePlanTaskStatus(planTask.Id, LocalCoderPlanTaskStatus.Failed, exception.Message);
                activePlanTaskId = null;
            }

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.GeneratePatchPreview,
                success: false,
                exception.Message,
                planText: generatedPlanText,
                taskTextOverride: taskText,
                contextSnapshot: contextSnapshot,
                planTasksSnapshot: GetPlanTasksSnapshot());

            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Patch preview rejected",
                exception.Message);
        }
        catch (Exception exception)
        {
            error = exception.Message;
            ClearPatchDebug();
            if (planTask is not null)
            {
                UpdatePlanTaskStatus(planTask.Id, LocalCoderPlanTaskStatus.Failed, exception.Message);
                activePlanTaskId = null;
            }

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.GeneratePatchPreview,
                success: false,
                exception.Message,
                planText: generatedPlanText,
                taskTextOverride: taskText,
                contextSnapshot: contextSnapshot,
                planTasksSnapshot: GetPlanTasksSnapshot());

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Patch preview failed",
                exception.Message);
        }
        finally
        {
            isGeneratingPatch = false;
            await LoadAgentRunHistoryAsync();
        }
    }

