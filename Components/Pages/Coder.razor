    private async Task CreatePlanAsync()
    {
        IReadOnlyList<LocalCoderHistoryContextFile> contextSnapshot = [];
        isPlanning = true;
        error = null;
        currentTask = null;
        ClearPlanTasks();
        lastCommand = null;

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForCreatePlan());
            if (!await EnsureFileContextLoadedAsync())
            {
                await SaveHistoryEntryAsync(
                    LocalCoderHistoryActionType.CreatePlan,
                    success: false,
                    "Select files before creating a plan.");
                return;
            }

            contextSnapshot = CreateContextSnapshot(LocalCoderHistoryActionType.CreatePlan);
            currentTask = await AgentModeRunner.CreatePlanAsync(request, profile);
            await ApplyPlannerContextSelectionAsync(currentTask!.Plan);
            InitializePlanTasks(currentTask!.Plan);
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.CreatePlan,
                success: true,
                "Plan created.",
                planText: currentTask!.Plan,
                model: profile.Model,
                contextSnapshot: contextSnapshot,
                planTasksSnapshot: GetPlanTasksSnapshot());

            NotificationService.Notify(
                NotificationSeverity.Success,
                "Plan created",
                $"Local coder generated a plan with {request.FileContexts.Count} file context(s).");
        }
        catch (Exception exception)
        {
            error = exception.Message;
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.CreatePlan,
                success: false,
                exception.Message,
                contextSnapshot: contextSnapshot,
                planTasksSnapshot: GetPlanTasksSnapshot());

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Local coder failed",
                exception.Message);
        }
        finally
        {
            isPlanning = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private async Task ApplyPlannerContextSelectionAsync(string planText)
    {
        if (string.IsNullOrWhiteSpace(planText) || projectKnowledgeIndex is null)
        {
            return;
        }

        PlannerResult? plannerResult;

        try
        {
            plannerResult = System.Text.Json.JsonSerializer.Deserialize<PlannerResult>(
                planText,
                new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
        }
        catch
        {
            return;
        }

        if (plannerResult is null)
        {
            return;
        }

        var selection = PlannerContextSelectionService.SelectContextFiles(plannerResult, projectKnowledgeIndex);
        if (selection.EditableFiles.Count > 0)
        {
            var selectedPlannerFiles = selection.EditableFiles
                .Select(CreateSuggestedFileSearchItem)
                .ToArray();

            await OnSelectedFilesChanged(selectedPlannerFiles);
            NotificationService.Notify(
                NotificationSeverity.Info,
                "Planner context applied",
                $"Planner selected {selection.EditableFiles.Count:N0} editable file(s) and {selection.InstructionFiles.Count:N0} instruction file(s).");
        }

        if (selection.MissingFiles.Count > 0)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Planner context missing files",
                $"Planner referenced {selection.MissingFiles.Count:N0} file(s) missing from the project knowledge index.");
        }

        foreach (var warning in selection.Warnings)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Planner context warning", warning);
        }
    }

