    private async Task GenerateSlicePatchPreviewAsync(TaskPlanSlice slice)
    {
        if (taskPlanPreview is null)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "No task plan",
                "Decompose a task before generating a slice patch preview.");
            return;
        }

        var preparation = await TaskSlicePatchPreviewPreparationService.PrepareAsync(
            slice,
            request.ProjectPath,
            request.FileContexts);
        if (!preparation.CanGenerate)
        {
            var failureMessage = string.IsNullOrWhiteSpace(preparation.FailureMessage)
                ? SlicePreviewMissingTargetsMessage
                : preparation.FailureMessage;
            await FailSlicePreviewAsync(slice, failureMessage, preparation.DebugDetails.ToList());
            return;
        }

        var taskText = preparation.TaskText;
        activePlanTaskId = null;

        await GeneratePatchPreviewCoreAsync(taskText, null, slice, null, false, preparation.FileContexts, preparation.DebugDetails);
    }

    private async Task VerifySliceAsync(TaskPlanSlice slice)
    {
        if (taskPlanPreview is null)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "No task plan",
                "Decompose a task before verifying a slice.");
            return;
        }

        isVerifyingSlice = true;
        sliceStatusMessages[slice.Id] = "Verifying slice...";

        try
        {
            var loopResult = await TaskSliceVerificationLoopService.VerifyAsync(slice);
            sliceVerificationLoopResults[slice.Id] = loopResult;
            sliceStatusMessages[slice.Id] = loopResult.FinalMessage;

            if (loopResult.VerificationResults.Count > 0)
            {
                var finalVerification = loopResult.VerificationResults.Last();
                sliceBuildVerificationResults[slice.Id] = new TaskSliceBuildVerificationResult
                {
                    Success = finalVerification.Success,
                    ExitCode = finalVerification.Success ? 0 : 1,
                    Output = BuildVerificationOutputPreview(finalVerification),
                    VerifiedAtUtc = finalVerification.ExecutedAt
                };
            }
            else
            {
                sliceBuildVerificationResults.Remove(slice.Id);
            }

            if (loopResult.GeneratedFixSlice is not null && taskPlanPreview is not null)
            {
                if (!taskPlanPreview.Slices.Any(item => string.Equals(item.Id, loopResult.GeneratedFixSlice.Id, StringComparison.OrdinalIgnoreCase)))
                {
                    taskPlanPreview.Slices.Add(loopResult.GeneratedFixSlice);
                }

                sliceRiskAnalyses = LoadSliceRiskAnalyses(taskPlanPreview);
                sliceStatusMessages[loopResult.GeneratedFixSlice.Id] = loopResult.Success
                    ? loopResult.FinalMessage
                    : "Generated remediation slice added to plan for review.";
            }

            if (loopResult.Success)
            {
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Slice verified",
                    loopResult.FinalMessage);
            }
            else
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Slice verification failed",
                    loopResult.FinalMessage);
            }
        }
        finally
        {
            isVerifyingSlice = false;
        }
    }

    private async Task<TaskSlicePatchPreviewPreparationResult> FailSlicePreviewAsync(
        TaskPlanSlice slice,
        string message,
        List<string> debugDetails)
    {
        var failedAt = DateTime.UtcNow;
        slice.Status = TaskSliceStatus.Failed;
        slice.UpdatedAt = failedAt;
        sliceStatusMessages[slice.Id] = message;
        LastSlicePatchDebugDetails = debugDetails;

        await TaskSliceExecutionService.RecordSliceExecutionResultAsync(new TaskSliceExecutionResult
        {
            PlanId = slice.PlanId,
            SliceId = slice.Id,
            SliceTitle = slice.Title,
            RequestedAction = "GeneratePatch",
            PatchPackageId = slice.PatchPackageId,
            Success = false,
            BuildSuccess = false,
            VerificationSuccess = false,
            Summary = message,
            AppliedFiles = [],
            AppliedAt = null,
            Errors = [message],
            ExecutedAt = failedAt
        });

        NotificationService.Notify(
            NotificationSeverity.Warning,
            "Slice patch preview failed",
            message);

        return new TaskSlicePatchPreviewPreparationResult(false, string.Empty, [], debugDetails, message);
    }

    private async Task RollbackSliceAsync(TaskPlanSlice slice)
    {
        if (taskPlanPreview is null)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "No task plan",
                "Decompose a task before rolling back a slice.");
            return;
        }

        isRollingBackSlice = true;
        error = null;
        sliceStatusMessages[slice.Id] = "Rolling back slice...";

        try
        {
            var rollbackExecution = await TaskSliceRollbackService.RollbackSliceAsync(slice);
            sliceStatusMessages[slice.Id] = rollbackExecution.Success
                ? rollbackExecution.Summary
                : rollbackExecution.Errors.FirstOrDefault() ?? rollbackExecution.Summary;

            if (rollbackExecution.Success)
            {
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Slice rolled back",
                    rollbackExecution.Summary);
            }
            else
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Slice rollback failed",
                    rollbackExecution.Errors.FirstOrDefault() ?? rollbackExecution.Summary);
            }

            await LoadPatchQueueAsync();
        }
        catch (Exception exception)
        {
            sliceStatusMessages[slice.Id] = exception.Message;
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Slice rollback failed",
                exception.Message);
        }
        finally
        {
            isRollingBackSlice = false;
        }
    }

