    private async Task PreparePromptContextFromTaskAsync(string taskText)
    {
        if (isContextLocked || string.IsNullOrWhiteSpace(request.ProjectPath) || string.IsNullOrWhiteSpace(taskText))
        {
            return;
        }

        error = null;
        promptContextStatusMessage = null;
        var preparation = await TaskSlicePatchPreviewPreparationService.PreparePromptContextAsync(
            taskText,
            request.ProjectPath);

        if (!preparation.Prepared)
        {
            return;
        }

        var applied = false;

        if (selectedFiles.Count == 0 && preparation.FileContexts.Count > 0)
        {
            selectedFiles = preparation.SelectedFilePaths
                .Select(CreateSuggestedFileSearchItem)
                .ToList();
            selectedFilePaths = preparation.SelectedFilePaths.ToList();
            fileContexts = preparation.FileContexts.ToList();
            request.FileContexts = fileContexts.ToList();
            applied = true;
        }

        if (request.AllowedCreateFolders.Count == 0 && preparation.AllowedCreateFolders.Count > 0)
        {
            request.AllowedCreateFolders = preparation.AllowedCreateFolders.ToList();
            applied = true;
        }

        if (!applied)
        {
            return;
        }

        promptContextStatusMessage = preparation.Message;
        NotificationService.Notify(
            NotificationSeverity.Info,
            "Context prepared from task prompt",
            preparation.Message);
    }

