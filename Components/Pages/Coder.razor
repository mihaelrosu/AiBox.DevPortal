    {
        isRunningCommand = true;
        error = null;

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForRunCommand());
            lastCommand = await AgentModeRunner.RunCommandAsync(
                request.ProjectPath,
                command,
                profile);

            var severity = lastCommand.ExitCode == 0
                ? NotificationSeverity.Success
                : NotificationSeverity.Warning;

            NotificationService.Notify(
                severity,
                "Command finished",
                $"{command}: exit {lastCommand.ExitCode}");
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Command failed",
                exception.Message);
        }
        finally
        {
            isRunningCommand = false;
            await LoadAgentRunHistoryAsync();
        }
    }

    private async Task VerifyProjectAsync()
    {
        var contextSnapshot = CreateContextSnapshot(LocalCoderHistoryActionType.VerifyProject);
        isVerifying = true;
        error = null;
        verifyResults = [];

        try
        {
            var profile = GetRequiredProfile(AgentActionProfiles.ForVerifyProject());
            var verificationProfile = GetSelectedVerificationProfile();
            verifyResults = await AgentModeRunner.VerifyProjectAsync(request.ProjectPath, profile, verificationProfile.Commands);
            var activeTaskText = GetActivePlanTaskText();

            var failed = verifyResults.FirstOrDefault(x => x.ExitCode != 0);

            if (failed is null)
            {
                if (!string.IsNullOrWhiteSpace(activePlanTaskId))
                {
                    UpdatePlanTaskStatus(activePlanTaskId, LocalCoderPlanTaskStatus.Verified, "Verification passed.");
                    activePlanTaskId = null;
                }
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Verification passed",
                    $"{verificationProfile.Name} completed: {string.Join(", ", verificationProfile.Commands)}.");
            }
            else
            {
                if (!string.IsNullOrWhiteSpace(activePlanTaskId))
                {
                    UpdatePlanTaskStatus(activePlanTaskId, LocalCoderPlanTaskStatus.Failed, $"{failed.Command}: exit {failed.ExitCode}");
                }
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Verification failed",
                    $"{failed.Command}: exit {failed.ExitCode}");
            }

            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.VerifyProject,
                success: failed is null,
                failed is null ? "Verification passed." : $"{failed.Command}: exit {failed.ExitCode}",
                verificationResults: verifyResults,
                model: profile.Model,
                contextSnapshot: contextSnapshot,
                taskTextOverride: activeTaskText ?? request.Task,
                planTasksSnapshot: GetPlanTasksSnapshot());
        }
        catch (Exception exception)
        {
            error = exception.Message;
            if (!string.IsNullOrWhiteSpace(activePlanTaskId))
            {
                UpdatePlanTaskStatus(activePlanTaskId, LocalCoderPlanTaskStatus.Failed, exception.Message);
            }
            await SaveHistoryEntryAsync(
                LocalCoderHistoryActionType.VerifyProject,
                success: false,
                exception.Message,
                verificationResults: verifyResults,
                contextSnapshot: contextSnapshot,
                taskTextOverride: GetActivePlanTaskText() ?? request.Task,
                planTasksSnapshot: GetPlanTasksSnapshot());

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Verification failed",
                exception.Message);
        }
        finally
        {
            isVerifying = false;
            await LoadAgentRunHistoryAsync();
        }
    }

