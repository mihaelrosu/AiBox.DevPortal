    private static IReadOnlyList<LocalCoderFileContext> MergeFileContexts(
        IReadOnlyList<LocalCoderFileContext> baseContexts,
        IReadOnlyList<LocalCoderFileContext>? additionalContexts)
    {
        if (additionalContexts is null || additionalContexts.Count == 0)
        {
            return baseContexts.ToArray();
        }

        return baseContexts
            .Concat(additionalContexts)
            .GroupBy(context => context.RelativePath, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .ToArray();
    }

    private static List<LocalCoderPlanTask> BuildPlanTasks(string planText)
    {
        var tasks = new List<LocalCoderPlanTask>();
        var lines = (planText ?? string.Empty)
            .ReplaceLineEndings("\n")
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        var order = 1;
        foreach (var line in lines)
        {
            var trimmed = line.Trim();
            var match = System.Text.RegularExpressions.Regex.Match(trimmed, @"^(?:[-*]\s+|\d+[.)]\s+)(.+)$");
            if (!match.Success)
            {
                continue;
            }

            var description = match.Groups[1].Value.Trim();
            if (string.IsNullOrWhiteSpace(description))
            {
                continue;
            }

            tasks.Add(new LocalCoderPlanTask
            {
                Order = order++,
                Title = $"Task {order - 1}",
                Description = description,
                Status = LocalCoderPlanTaskStatus.Pending
            });
        }

        if (tasks.Count == 0 && !string.IsNullOrWhiteSpace(planText))
        {
            tasks.Add(new LocalCoderPlanTask
            {
                Order = 1,
                Title = "Task 1",
                Description = planText.Trim(),
                Status = LocalCoderPlanTaskStatus.Pending
            });
        }

        return tasks;
    }

    private static string BuildPlanTaskTaskText(LocalCoderPlanTask task)
    {
        return string.IsNullOrWhiteSpace(task.Description) ? task.Title : task.Description;
    }

    private LocalCoderVerificationProfile GetSelectedVerificationProfile()
