    private async Task SaveHistoryEntryAsync(
        LocalCoderHistoryActionType actionType,
        bool success,
        string message,
        string? planText = null,
        string? patchPreviewText = null,
        LocalCoderPatchApplyResult? applyResult = null,
        LocalCoderPatchRollbackResult? rollbackResult = null,
        IReadOnlyList<CommandRunResult>? verificationResults = null,
        LocalCoderPatchPreview? patchPreviewSnapshot = null,
        PatchPreviewValidationException? patchPreviewValidation = null,
        PatchPromptAudit? promptAudit = null,
        PatchPromptTargetResolution? promptTargetResolution = null,
        string? model = null,
        IReadOnlyList<LocalCoderHistoryContextFile>? contextSnapshot = null,
        string? taskTextOverride = null,
        IReadOnlyList<LocalCoderPlanTask>? planTasksSnapshot = null)
    {
        try
        {
            contextSnapshot ??= CreateContextSnapshot(actionType);

            await LocalCoderHistoryService.AddEntryAsync(new LocalCoderHistoryEntry
            {
                ActionType = actionType,
                CreatedAt = DateTimeOffset.UtcNow,
                ProjectPath = request.ProjectPath,
                Model = model ?? request.Model,
                Task = taskTextOverride ?? request.Task,
                SelectedFiles = selectedFilePaths.ToArray(),
                LoadedContextFiles = request.FileContexts
                    .Select(fileContext => new LocalCoderHistoryFileSummary
                    {
                        RelativePath = fileContext.RelativePath,
                        CharacterCount = fileContext.CharacterCount
                    })
                    .ToArray(),
                ContextFileCount = contextSnapshot.Count,
                ContextTotalCharacters = contextSnapshot.Sum(file => file.CharacterCount),
                ContextEstimatedTokens = contextSnapshot.Sum(file => file.EstimatedTokens),
                ContextFiles = contextSnapshot,
                PlanTasks = (planTasksSnapshot ?? GetPlanTasksSnapshot()).ToArray(),
                PlanText = planText ?? string.Empty,
                PatchPreviewText = patchPreviewText ?? string.Empty,
                ScopeAnalysis = patchPreviewSnapshot?.ScopeAnalysis,
                AllowedCreateFolders = patchPreviewSnapshot?.AllowedCreateFolders?.ToArray() ?? request.AllowedCreateFolders.ToArray(),
                Intent = patchPreviewSnapshot?.Intent,
                IntentValidation = patchPreviewSnapshot?.IntentValidation,
                ContextCoverage = patchPreviewSnapshot?.ContextCoverage,
                PromptAudit = promptAudit ?? patchPreviewSnapshot?.PromptAudit ?? patchPreviewValidation?.PromptAudit,
                PromptTargetResolution = promptTargetResolution ?? patchPreviewSnapshot?.PromptTargetResolution ?? patchPreviewValidation?.PromptTargetResolution,
                ValidationErrors = patchPreviewValidation?.ValidationErrors?.ToArray() ?? [],
                OperationGrammarErrors = patchPreviewValidation?.OperationGrammarErrors?.ToArray() ?? [],
                ValidationGuidance = patchPreviewValidation?.Guidance?.ToArray() ?? [],
                ReplaceDiagnostics = patchPreviewValidation?.ReplaceDiagnostics?.ToArray() ?? [],
                SuggestedTargetDiagnostics = patchPreviewValidation?.SuggestedTargetDiagnostics?.ToArray() ?? [],
                RepairSummary = patchPreviewSnapshot?.RepairSummary ?? patchPreviewValidation?.RepairSummary,
                ApplyResult = applyResult,
                RollbackResult = rollbackResult,
                VerificationResults = verificationResults?.ToArray() ?? [],
                Success = success,
                Message = message
            });

            await LoadHistoryAsync();
        }
        catch (Exception exception)
        {
            Console.WriteLine($"History save failed: {exception}");
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "History save failed",
                "Local Coder could not save history right now. The current run continues, but this entry was not persisted.");
        }
    }

    private IReadOnlyList<LocalCoderHistoryContextFile> CreateContextSnapshot(LocalCoderHistoryActionType actionType)
    {
        if (request.FileContexts.Count == 0
            || actionType is not (LocalCoderHistoryActionType.CreatePlan
                or LocalCoderHistoryActionType.GeneratePatchPreview
                or LocalCoderHistoryActionType.VerifyProject))
        {
            return [];
        }

        return request.FileContexts
            .Select(file => new LocalCoderHistoryContextFile
            {
                RelativePath = file.RelativePath,
                CharacterCount = file.CharacterCount,
                EstimatedTokens = file.EstimatedTokens,
                ContentHash = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(file.Content)))
                    .ToLowerInvariant()
            })
            .ToArray();
    }

