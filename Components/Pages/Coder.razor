    private static string BuildHistoryContextSummary(LocalCoderHistoryEntry entry)
    {
        var selectedFiles = entry.SelectedFiles.Count == 0
            ? "none"
            : string.Join(", ", entry.SelectedFiles);

        var resultStatus = entry.ActionType switch
        {
            LocalCoderHistoryActionType.ApplyPatch => entry.ApplyResult is null
                ? "n/a"
                : $"{entry.ApplyResult.Applied}, verification {entry.ApplyResult.VerificationPassed}",
            LocalCoderHistoryActionType.RollbackPatch => entry.RollbackResult is null
                ? "n/a"
                : $"{entry.RollbackResult.RolledBack}, verification {entry.RollbackResult.VerificationPassed}",
            LocalCoderHistoryActionType.VerifyProject => entry.VerificationResults.Count == 0
                ? "n/a"
                : entry.Success.ToString(),
            _ => entry.Success.ToString()
        };

        return string.Join(Environment.NewLine, new[]
        {
            "Previous Local Coder history context:",
            $"- Previous action: {entry.ActionType}",
            $"- Previous task: {entry.Task}",
            $"- Previous selected files: {selectedFiles}",
            $"- Previous result message: {entry.Message}",
            $"- Apply/rollback/verify passed: {resultStatus}"
        });
    }

    private AgentModeProfile GetRequiredProfile(AgentMode mode)
    {
        var profile = agentModeProfiles.FirstOrDefault(item => item.Mode == mode);

        if (profile is null)
        {
            throw new InvalidOperationException($"Agent mode profile is not configured for {mode}.");
        }

        return profile;
    }

    #endregion
}
