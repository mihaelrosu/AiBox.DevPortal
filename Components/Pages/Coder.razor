@page "/coder"
@rendermode InteractiveServer
@using AiBox.DevPortal.Models
@using AiBox.DevPortal.Components.Common
@using AiBox.DevPortal.Services
@using Radzen.Blazor

<PageTitle>Local Coder</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn>
            <RadzenText Text="Local Coder" TextStyle="TextStyle.H4" />
            <RadzenText Text="Use a local Ollama model to plan code changes, generate patch previews, and run safe verification commands." TextStyle="TextStyle.Body2" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="3">
            <RadzenButton Text="Refresh"
                          Icon="refresh"
                          Click="@LoadAsync"
                          Disabled="@isLoading"
                          Style="width: 100%;" />
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenFormField Text="Project path">
                <RadzenDropDown TValue="string"
                                @bind-Value="request.ProjectPath"
                                Data="@workspaceRoots"
                                Change="@OnProjectPathChanged"
                                Style="width: 100%;"
                                Placeholder="Select project folder" />
            </RadzenFormField>

            <RadzenCard>
                <RadzenStack Gap="0.75rem">
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center"
                                 JustifyContent="JustifyContent.SpaceBetween"
                                 Gap="0.75rem"
                                 Wrap="FlexWrap.Wrap">
                        <div>
                            <RadzenText Text="File Context" TextStyle="TextStyle.H5" />
                            <RadzenText Text="@GetProjectFilesStatusText()" TextStyle="TextStyle.Body2" />
                        </div>

                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                            <RadzenButton Text="Read Selected Files"
                                          Icon="description"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Click="@ReadSelectedFilesAsync"
                                          Disabled="@(isLoading || string.IsNullOrWhiteSpace(request.ProjectPath) || !selectedFilePaths.Any())" />

                            <RadzenButton Text="Clear Selected"
                                          Icon="remove_circle_outline"
                                          ButtonStyle="ButtonStyle.Light"
                                          Click="@ClearSelectedFilesAsync"
                                          Disabled="@(isLoading || !selectedFilePaths.Any())" />

                            <RadzenButton Text="Clear Context"
                                          Icon="clear"
                                          ButtonStyle="ButtonStyle.Light"
                                          Click="@ClearContextAsync"
                                          Disabled="@(isLoading || fileContexts.Count == 0)" />
                        </RadzenStack>
                    </RadzenStack>

                    <RadzenText Text="@($"Loaded context files: {fileContexts.Count}")" TextStyle="TextStyle.Body2" />

                    <RadzenFormField Text="Find file">
                        <RadzenTextBox @bind-Value="fileSearchText"
                                       Style="width: 100%;"
                                       Placeholder="Search by relative path or file name, e.g. Coder.razor, service, Program.cs" />
                    </RadzenFormField>

                    @if (FilteredProjectFileItems.Count > 0)
                    {
                        <RadzenCard>
                            <RadzenStack Gap="0.35rem">
                                @foreach (var file in FilteredProjectFileItems)
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal"
                                                 AlignItems="AlignItems.Center"
                                                 JustifyContent="JustifyContent.SpaceBetween"
                                                 Gap="0.75rem"
                                                 Style="padding: 0.35rem 0.5rem; border: 1px solid var(--rz-base-300); border-radius: 0.35rem;">
                                        <RadzenText Text="@file.RelativePath"
                                                    TextStyle="TextStyle.Body2"
                                                    Style="word-break: break-word;" />

                                        <RadzenButton Text="Add"
                                                      Icon="add"
                                                      Size="ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Primary"
                                                      Click="@(() => AddFileByPath(file.RelativePath))"
                                                      Disabled="@IsFileSelected(file.RelativePath)" />
                                    </RadzenStack>
                                }
                            </RadzenStack>
                        </RadzenCard>
                    }

                    <RadzenStack Gap="0.5rem">
                        <RadzenText Text="Selected files" TextStyle="TextStyle.H6" />

                        @if (selectedFilePaths.Count == 0)
                        {
                            <RadzenText Text="No files selected yet. Search for a file and click Add."
                                        TextStyle="TextStyle.Body2" />
                        }
                        else
                        {
                            @foreach (var relativePath in selectedFilePaths.OrderBy(path => path, StringComparer.OrdinalIgnoreCase))
                            {
                                <RadzenStack Orientation="Orientation.Horizontal"
                                             AlignItems="AlignItems.Center"
                                             JustifyContent="JustifyContent.SpaceBetween"
                                             Style="padding: 0.35rem 0.5rem; border: 1px solid var(--rz-base-300); border-radius: 0.35rem;"
                                             Gap="0.75rem">
                                    <RadzenText Text="@relativePath"
                                                TextStyle="TextStyle.Body2"
                                                Style="word-break: break-word;" />

                                    <RadzenButton Text="Remove"
                                                  Icon="close"
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Click="@(() => RemoveSelectedFile(relativePath))"
                                                  Disabled="@isLoading" />
                                </RadzenStack>
                            }
                        }
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>

            <RadzenFormField Text="Model">
                <RadzenDropDown TValue="string"
                                @bind-Value="request.Model"
                                Data="@models"
                                Style="width: 100%;"
                                Placeholder="Select Ollama model" />
            </RadzenFormField>

            <RadzenFormField Text="Task">
                <RadzenTextArea @bind-Value="request.Task"
                                Rows="6"
                                Style="width: 100%;"
                                Placeholder="Example: review AiBox.DevPortal and suggest the next safe Local Coder improvement" />
            </RadzenFormField>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="Create Plan"
                              Icon="psychology"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@CreatePlanAsync"
                              Disabled="@(isLoading || isPlanning || string.IsNullOrWhiteSpace(request.Task))" />

                <RadzenButton Text="Generate Patch Preview"
                              Icon="difference"
                              ButtonStyle="ButtonStyle.Warning"
                              Click="@GeneratePatchPreviewAsync"
                              Disabled="@(isLoading || isGeneratingPatch || string.IsNullOrWhiteSpace(request.Task) || selectedFilePaths.Count == 0)" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true">
            @error
        </RadzenAlert>
    }

    @if (patchPreview is not null)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Gap="0.75rem"
                             Wrap="FlexWrap.Wrap">
                    <RadzenText Text="Patch Preview" TextStyle="TextStyle.H5" />

                    <CopyToClipboardButton Text="Copy Patch"
                                           Value="@patchPreview.PatchText"
                                           SuccessTitle="Patch copied"
                                           SuccessMessage="The patch preview was copied to the clipboard." />
                </RadzenStack>

                <RadzenText Text="Preview only. No files were modified." TextStyle="TextStyle.Caption" />
                <pre class="coder-output">@patchPreview.PatchText</pre>
            </RadzenStack>
        </RadzenCard>
    }

    @if (currentTask is not null)
    {
        <RadzenCard>
            <RadzenText Text="Plan" TextStyle="TextStyle.H5" />
            <pre class="coder-output">@currentTask.Plan</pre>
        </RadzenCard>
    }

    @if (fileContexts.Count > 0)
    {
        <RadzenCard>
            <RadzenText Text="Loaded File Context" TextStyle="TextStyle.H5" />

            @foreach (var fileContext in fileContexts)
            {
                <details style="margin-bottom: 0.75rem;">
                    <summary>@fileContext.RelativePath (@fileContext.CharacterCount chars)</summary>
                    <pre class="coder-output">@fileContext.Content</pre>
                </details>
            }
        </RadzenCard>
    }

    <RadzenCard>
        <RadzenText Text="Safe Commands" TextStyle="TextStyle.H5" />
        <RadzenText Text="Verify Project runs git status, dotnet build, and dotnet test." TextStyle="TextStyle.Caption" />

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenButton Text="git status"
                          Click="@(() => RunCommandAsync("git status"))"
                          Disabled="@isRunningCommand" />

            <RadzenButton Text="git diff"
                          Click="@(() => RunCommandAsync("git diff"))"
                          Disabled="@isRunningCommand" />

            <RadzenButton Text="dotnet build"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => RunCommandAsync("dotnet build"))"
                          Disabled="@isRunningCommand" />

            <RadzenButton Text="dotnet test"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@(() => RunCommandAsync("dotnet test"))"
                          Disabled="@isRunningCommand" />

            <RadzenButton Text="Verify Project"
                          Icon="verified"
                          ButtonStyle="ButtonStyle.Success"
                          Click="@VerifyProjectAsync"
                          Disabled="@(isRunningCommand || isVerifying || string.IsNullOrWhiteSpace(request.ProjectPath))" />
        </RadzenStack>
    </RadzenCard>

    @if (lastCommand is not null)
    {
        <RadzenCard>
            <RadzenText Text="@($"Command: {lastCommand.Command}")" TextStyle="TextStyle.H5" />
            <RadzenText Text="@($"Exit code: {lastCommand.ExitCode}")" TextStyle="TextStyle.Body2" />

            <h4>Output</h4>
            <pre class="coder-output">@lastCommand.Output</pre>

            @if (!string.IsNullOrWhiteSpace(lastCommand.Error))
            {
                <h4>Error</h4>
                <pre class="coder-error">@lastCommand.Error</pre>
            }
        </RadzenCard>
    }

    @if (verifyResults.Count > 0)
    {
        <RadzenCard>
            <RadzenText Text="Verification Result" TextStyle="TextStyle.H5" />

            @foreach (var item in verifyResults)
            {
                <RadzenCard Style="margin-top: 1rem;">
                    <RadzenText Text="@($"{item.Command} — exit {item.ExitCode}")" TextStyle="TextStyle.H6" />

                    @if (!string.IsNullOrWhiteSpace(item.Output))
                    {
                        <h4>Output</h4>
                        <pre class="coder-output">@item.Output</pre>
                    }

                    @if (!string.IsNullOrWhiteSpace(item.Error))
                    {
                        <h4>Error</h4>
                        <pre class="coder-error">@item.Error</pre>
                    }
                </RadzenCard>
            }
        </RadzenCard>
    }
</RadzenStack>

@code {
    [Inject] private ICoderConsoleService CoderConsoleService { get; set; } = default!;
    [Inject] private NotificationService NotificationService { get; set; } = default!;

    private readonly LocalCoderRequest request = new();

    private IReadOnlyList<string> workspaceRoots = [];
    private IReadOnlyList<string> models = [];
    private IReadOnlyList<ProjectFileItem> projectFiles = [];
    private IReadOnlyList<CommandRunResult> verifyResults = [];

    private List<LocalCoderFileContext> fileContexts = [];
    private List<string> selectedFilePaths = [];

    private AiBox.DevPortal.Models.LocalCoderTask? currentTask;
    private LocalCoderPatchPreview? patchPreview;
    private CommandRunResult? lastCommand;

    private bool isLoading;
    private bool isPlanning;
    private bool isGeneratingPatch;
    private bool isRunningCommand;
    private bool isVerifying;

    private string? error;
    private string fileSearchText = string.Empty;

    private IReadOnlyList<ProjectFileItem> FilteredProjectFileItems
    {
        get
        {
            if (projectFiles.Count == 0)
            {
                return [];
            }

            if (string.IsNullOrWhiteSpace(fileSearchText))
            {
                return projectFiles
                    .OrderBy(file => file.RelativePath, StringComparer.OrdinalIgnoreCase)
                    .Take(12)
                    .ToArray();
            }

            var search = fileSearchText.Trim();

            return projectFiles
                .Where(file => MatchesSearch(file, search))
                .OrderBy(file => GetSearchRank(file, search))
                .ThenBy(file => file.RelativePath, StringComparer.OrdinalIgnoreCase)
                .Take(12)
                .ToArray();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            workspaceRoots = await CoderConsoleService.GetWorkspaceRootsAsync();
            models = await CoderConsoleService.GetOllamaModelsAsync();

            if (string.IsNullOrWhiteSpace(request.ProjectPath))
            {
                request.ProjectPath = workspaceRoots.FirstOrDefault() ?? string.Empty;
            }

            if (string.IsNullOrWhiteSpace(request.Model) || !models.Contains(request.Model, StringComparer.OrdinalIgnoreCase))
            {
                request.Model = models.Contains("qwen2.5-coder:7b", StringComparer.OrdinalIgnoreCase)
                    ? "qwen2.5-coder:7b"
                    : models.FirstOrDefault() ?? request.Model;
            }

            if (!string.IsNullOrWhiteSpace(request.ProjectPath))
            {
                await ReloadProjectFilesAsync(showNotification: false, clearSelectedState: false);
            }
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnProjectPathChanged(object? value)
    {
        request.ProjectPath = value?.ToString() ?? string.Empty;
        ClearSelectedFiles();
        ClearLoadedContext();
        currentTask = null;
        patchPreview = null;
        lastCommand = null;
        verifyResults = [];

        await ReloadProjectFilesAsync(showNotification: true, clearSelectedState: false);
    }

    private async Task ReloadProjectFilesAsync(bool showNotification, bool clearSelectedState)
    {
        error = null;

        if (clearSelectedState)
        {
            ClearSelectedFiles();
            ClearLoadedContext();
        }

        if (string.IsNullOrWhiteSpace(request.ProjectPath))
        {
            projectFiles = [];
            return;
        }

        try
        {
            projectFiles = await CoderConsoleService.GetProjectFilesAsync(request.ProjectPath);

            if (showNotification)
            {
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Project files loaded",
                    $"{projectFiles.Count} files are available for context.");
            }
        }
        catch (Exception exception)
        {
            projectFiles = [];
            if (clearSelectedState)
            {
                ClearSelectedFiles();
                ClearLoadedContext();
            }

            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Load project files failed",
                exception.Message);
        }
    }

    private async Task ReadSelectedFilesAsync()
    {
        error = null;

        try
        {
            if (!selectedFilePaths.Any())
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "No files selected",
                    "Select files before reading file context.");

                return;
            }

            fileContexts = (await CoderConsoleService.ReadFileContextsAsync(
                    request.ProjectPath,
                    selectedFilePaths.ToArray()))
                .ToList();

            request.FileContexts = fileContexts.ToList();
            patchPreview = null;

            NotificationService.Notify(
                NotificationSeverity.Success,
                "Context loaded",
                $"{fileContexts.Count} file(s) loaded into context.");
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Read context failed",
                exception.Message);
        }
    }

    private void RemoveSelectedFile(string relativePath)
    {
        selectedFilePaths.RemoveAll(path =>
            path.Equals(relativePath, StringComparison.OrdinalIgnoreCase));

        fileContexts = fileContexts
            .Where(fileContext =>
                !fileContext.RelativePath.Equals(relativePath, StringComparison.OrdinalIgnoreCase))
            .ToList();

        request.FileContexts = fileContexts.ToList();
        patchPreview = null;
    }

    private Task ClearSelectedFilesAsync()
    {
        ClearSelectedFiles();
        ClearLoadedContext();

        NotificationService.Notify(
            NotificationSeverity.Info,
            "Selected files cleared",
            "The file selection list was cleared.");

        return Task.CompletedTask;
    }

    private Task ClearContextAsync()
    {
        ClearLoadedContext();

        NotificationService.Notify(
            NotificationSeverity.Info,
            "Context cleared",
            "Loaded file context was cleared.");

        return Task.CompletedTask;
    }

    private void ClearSelectedFiles()
    {
        selectedFilePaths = [];
        fileSearchText = string.Empty;
        patchPreview = null;
    }

    private void ClearLoadedContext()
    {
        fileContexts = [];
        request.FileContexts = [];
        patchPreview = null;
    }

    private async Task CreatePlanAsync()
    {
        isPlanning = true;
        error = null;
        currentTask = null;
        lastCommand = null;

        try
        {
            if (fileContexts.Count == 0)
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "No file context loaded",
                    "Select files and click Read Selected Files first.");
            }

            request.FileContexts = fileContexts.ToList();
            currentTask = await CoderConsoleService.CreatePlanAsync(request);

            NotificationService.Notify(
                NotificationSeverity.Success,
                "Plan created",
                $"Local coder generated a plan with {request.FileContexts.Count} file context(s).");
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Local coder failed",
                exception.Message);
        }
        finally
        {
            isPlanning = false;
        }
    }

    private async Task GeneratePatchPreviewAsync()
    {
        isGeneratingPatch = true;
        error = null;
        patchPreview = null;

        try
        {
            if (selectedFilePaths.Count == 0)
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "No files selected",
                    "Select files before generating a patch preview.");

                return;
            }

            if (fileContexts.Count == 0)
            {
                fileContexts = (await CoderConsoleService.ReadFileContextsAsync(
                        request.ProjectPath,
                        selectedFilePaths.ToArray()))
                    .ToList();

                request.FileContexts = fileContexts.ToList();

                NotificationService.Notify(
                    NotificationSeverity.Info,
                    "Context auto-loaded",
                    $"{fileContexts.Count} file(s) loaded before patch preview.");
            }

            request.FileContexts = fileContexts.ToList();
            patchPreview = await CoderConsoleService.GeneratePatchPreviewAsync(request);

            NotificationService.Notify(
                NotificationSeverity.Success,
                "Patch preview created",
                "Local coder generated a patch preview for the selected context.");
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Patch preview rejected",
                exception.Message);
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Patch preview failed",
                exception.Message);
        }
        finally
        {
            isGeneratingPatch = false;
        }
    }

    private async Task RunCommandAsync(string command)
    {
        isRunningCommand = true;
        error = null;

        try
        {
            lastCommand = await CoderConsoleService.RunCommandAsync(
                request.ProjectPath,
                command);

            var severity = lastCommand.ExitCode == 0
                ? NotificationSeverity.Success
                : NotificationSeverity.Warning;

            NotificationService.Notify(
                severity,
                "Command finished",
                $"{command}: exit {lastCommand.ExitCode}");
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Command failed",
                exception.Message);
        }
        finally
        {
            isRunningCommand = false;
        }
    }

    private async Task VerifyProjectAsync()
    {
        isVerifying = true;
        error = null;
        verifyResults = [];

        try
        {
            verifyResults = await CoderConsoleService.VerifyProjectAsync(request.ProjectPath);

            var failed = verifyResults.FirstOrDefault(x => x.ExitCode != 0);

            if (failed is null)
            {
                NotificationService.Notify(
                    NotificationSeverity.Success,
                    "Verification passed",
                    "git status, dotnet build, and dotnet test completed.");
            }
            else
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Verification failed",
                    $"{failed.Command}: exit {failed.ExitCode}");
            }
        }
        catch (Exception exception)
        {
            error = exception.Message;

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Verification failed",
                exception.Message);
        }
        finally
        {
            isVerifying = false;
        }
    }

    private Task AddFileByPath(string relativePath)
    {
        error = null;

        var match = projectFiles.FirstOrDefault(file =>
            file.RelativePath.Equals(relativePath, StringComparison.OrdinalIgnoreCase));

        if (match is null)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "File not found",
                $"{relativePath} is not in the loaded project file list.");

            return Task.CompletedTask;
        }

        if (!IsFileSelected(match.RelativePath))
        {
            selectedFilePaths.Add(match.RelativePath);
            patchPreview = null;

            NotificationService.Notify(
                NotificationSeverity.Success,
                "File added",
                match.RelativePath);
        }
        else
        {
            NotificationService.Notify(
                NotificationSeverity.Info,
                "File already selected",
                match.RelativePath);
        }
        return Task.CompletedTask;
    }

    private bool IsFileSelected(string relativePath)
    {
        return selectedFilePaths.Contains(relativePath, StringComparer.OrdinalIgnoreCase);
    }

    private static bool MatchesSearch(ProjectFileItem file, string search)
    {
        return file.RelativePath.Contains(search, StringComparison.OrdinalIgnoreCase) ||
               Path.GetFileName(file.RelativePath).Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static (int rank, int depth, string path) GetSearchRank(ProjectFileItem file, string search)
    {
        var relativePath = file.RelativePath;
        var fileName = Path.GetFileName(relativePath);
        var fileNameMatch = fileName.Contains(search, StringComparison.OrdinalIgnoreCase);
        var pathMatch = relativePath.Contains(search, StringComparison.OrdinalIgnoreCase);
        var rank = fileName.StartsWith(search, StringComparison.OrdinalIgnoreCase)
            ? 0
            : fileNameMatch
                ? 1
                : pathMatch
                    ? 2
                    : 3;

        return (rank, relativePath.Count(c => c == '/'), relativePath);
    }

    private string GetProjectFilesStatusText()
    {
        if (string.IsNullOrWhiteSpace(request.ProjectPath))
        {
            return "Select a project path to load available files.";
        }

        if (isLoading)
        {
            return "Loading project files...";
        }

        if (projectFiles.Count == 0)
        {
            return "No project files loaded.";
        }

        return $"{projectFiles.Count} file(s) available for selection.";
    }
}
