            ?? verificationProfiles.FirstOrDefault()
            ?? new LocalCoderVerificationProfile
            {
                Id = "quick",
                Name = "Quick",
                Description = "Fast verification with a single build.",
                Commands = ["dotnet build"]
            };
    }

    private string ResolveVerificationProfileId(string? profileId)
    {
        if (!string.IsNullOrWhiteSpace(profileId) &&
            verificationProfiles.Any(profile => profile.Id.Equals(profileId, StringComparison.OrdinalIgnoreCase)))
        {
            return profileId;
        }

        var quickProfile = verificationProfiles.FirstOrDefault(profile => profile.Id.Equals("quick", StringComparison.OrdinalIgnoreCase));
        return quickProfile?.Id ?? verificationProfiles.FirstOrDefault()?.Id ?? "quick";
    }

