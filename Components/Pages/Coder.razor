    private async Task RestoreHistoryContextAsync()
    {
        if (selectedHistoryEntry is null)
        {
            return;
        }

        if (selectedHistoryEntry.ContextFiles.Count == 0)
        {
            NotificationService.Notify(
                NotificationSeverity.Info,
                "No context snapshot",
                "This history entry has no saved context snapshot.");
            return;
        }

        if (isContextLocked)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Context locked", "Unlock context before restoring history.");
            return;
        }

        if (selectedFilePaths.Count > 0 || fileContexts.Count > 0)
        {
            var confirmed = await DialogService.Confirm(
                "Replace the current file context with the saved history context?",
                "Restore Context",
                new ConfirmOptions { OkButtonText = "Restore Context", CancelButtonText = "Cancel" });

            if (confirmed != true)
            {
                return;
            }
        }

        request.ProjectPath = selectedHistoryEntry.ProjectPath;
        contextRestoreResult = await LocalCoderContextService.RestoreAsync(
            request.ProjectPath,
            selectedHistoryEntry.ContextFiles);

        ClearLoadedContext();
        fileContexts = contextRestoreResult.RestoredContexts.ToList();
        request.FileContexts = fileContexts.ToList();
        selectedFilePaths = fileContexts.Select(file => file.RelativePath).ToList();
        selectedFiles = fileContexts
            .Select(file => new FileSearchItem
            {
                FileName = Path.GetFileName(file.RelativePath),
                FullPath = file.FullPath,
                RelativePath = file.RelativePath,
                Extension = Path.GetExtension(file.RelativePath),
                SizeBytes = new System.IO.FileInfo(file.FullPath).Length
            })
            .ToList();

        NotificationService.Notify(
            NotificationSeverity.Success,
            "Context restore complete",
            $"{fileContexts.Count} file(s) restored from history.");
    }

    private async Task UseHistoryEntryAsContextAsync()
    {
        if (selectedHistoryEntry is null)
        {
            return;
        }

        request.ProjectPath = selectedHistoryEntry.ProjectPath;
        if (!string.IsNullOrWhiteSpace(selectedHistoryEntry.Model))
        {
            request.Model = selectedHistoryEntry.Model;
        }

        selectedFilePaths = selectedHistoryEntry.SelectedFiles.ToList();
        selectedFiles = selectedFilePaths
            .Select(relativePath => new FileSearchItem
            {
                FileName = Path.GetFileName(relativePath),
                FullPath = Path.Combine(request.ProjectPath, relativePath),
                RelativePath = relativePath,
                Extension = Path.GetExtension(relativePath)
            })
            .ToList();
        ClearLoadedContext();

        await EnsureFileContextLoadedAsync();

        var summary = BuildHistoryContextSummary(selectedHistoryEntry);
        request.Task = string.IsNullOrWhiteSpace(request.Task)
            ? summary
            : $"{request.Task.TrimEnd()}{Environment.NewLine}{Environment.NewLine}{summary}";

        NotificationService.Notify(
            NotificationSeverity.Success,
            "History context loaded",
            "The history entry was loaded into the current task context.");
    }

