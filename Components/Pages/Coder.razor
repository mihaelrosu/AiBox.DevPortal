    #region Project actions

    private async Task OnSelectedFilesChanged(IReadOnlyList<FileSearchItem> files)
    {
        if (isContextLocked)
        {
            return;
        }

        promptContextStatusMessage = null;
        selectedFiles = files.ToList();
        selectedFilePaths = selectedFiles
            .Select(file => file.RelativePath)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (request.AllowedCreateFolders.Count == 0)
        {
            request.AllowedCreateFolders = selectedFiles
                .Select(file => Path.GetDirectoryName(file.RelativePath)?.Replace('\\', '/') ?? string.Empty)
                .Where(folder => !string.IsNullOrWhiteSpace(folder))
                .Select(folder => folder.EndsWith('/') ? folder : $"{folder}/")
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(folder => folder, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        error = null;
        await LoadSelectedFileContextsAsync();
    }

    private Task LoadPresetAsync(IReadOnlyList<FileSearchItem> files)
    {
        if (isContextLocked)
        {
            return Task.CompletedTask;
        }

        var mergedFiles = selectedFiles
            .Concat(files)
            .DistinctBy(file => file.RelativePath, StringComparer.OrdinalIgnoreCase)
            .ToArray();

        return OnSelectedFilesChanged(mergedFiles);
    }

    private async Task<bool> LoadSelectedFileContextsAsync()
    {
        ClearLoadedContext();
        var loadVersion = contextLoadVersion;

        if (selectedFilePaths.Count == 0 || string.IsNullOrWhiteSpace(request.ProjectPath))
        {
            return false;
        }

        isLoadingContext = true;

        try
        {
            var loadedContexts = (await CoderConsoleService.ReadFileContextsAsync(
                    request.ProjectPath,
                    selectedFilePaths.ToArray()))
                .ToList();

            if (loadVersion == contextLoadVersion)
            {
                var unconfirmedGeneratedFiles = loadedContexts
                    .Where(context => context.IsGeneratedFile
                                      && !confirmedGeneratedFilePaths.Contains(context.RelativePath))
                    .ToArray();

                if (unconfirmedGeneratedFiles.Length > 0)
                {
                    var confirmed = await DialogService.Confirm(
                        $"Include generated or ignored files in model context?{Environment.NewLine}{string.Join(Environment.NewLine, unconfirmedGeneratedFiles.Select(context => $"- {context.RelativePath}"))}",
                        "Confirm Generated File Context",
                        new ConfirmOptions { OkButtonText = "Include Files", CancelButtonText = "Exclude Files" });

                    if (confirmed == true)
                    {
                        foreach (var context in unconfirmedGeneratedFiles)
                        {
                            confirmedGeneratedFilePaths.Add(context.RelativePath);
                        }
                    }
                    else
                    {
                        var excludedPaths = unconfirmedGeneratedFiles
                            .Select(context => context.RelativePath)
                            .ToHashSet(StringComparer.OrdinalIgnoreCase);
                        loadedContexts.RemoveAll(context => excludedPaths.Contains(context.RelativePath));
                        selectedFiles = selectedFiles
                            .Where(file => !excludedPaths.Contains(file.RelativePath))
                            .ToList();
                        selectedFilePaths = selectedFilePaths
                            .Where(path => !excludedPaths.Contains(path))
                            .ToList();
                    }
                }

                if (loadVersion != contextLoadVersion)
                {
                    return false;
                }

                fileContexts = loadedContexts;
                request.FileContexts = fileContexts.ToList();
                if (request.AllowedCreateFolders.Count == 0)
                {
                    request.AllowedCreateFolders = selectedFiles
                        .Select(file => Path.GetDirectoryName(file.RelativePath)?.Replace('\\', '/') ?? string.Empty)
                        .Where(folder => !string.IsNullOrWhiteSpace(folder))
                        .Select(folder => folder.EndsWith('/') ? folder : $"{folder}/")
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .OrderBy(folder => folder, StringComparer.OrdinalIgnoreCase)
                        .ToList();
                }
            }

            return true;
        }
        catch (Exception exception)
        {
            if (loadVersion == contextLoadVersion)
            {
                error = exception.Message;
                ClearSelectedFiles();
                NotificationService.Notify(NotificationSeverity.Error, "File context failed", exception.Message);
            }

            return false;
        }
        finally
        {
            if (loadVersion == contextLoadVersion)
            {
                isLoadingContext = false;
            }
        }
    }

    private async Task<bool> EnsureFileContextLoadedAsync()
    {
        if (fileContexts.Count == selectedFilePaths.Count && fileContexts.Count > 0)
        {
            request.FileContexts = fileContexts.ToList();
            return true;
        }

        if (selectedFilePaths.Count == 0)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "No files selected",
                "Select files before creating a plan or patch preview.");

            return false;
        }

        if (!await LoadSelectedFileContextsAsync())
        {
            return false;
        }

        NotificationService.Notify(
            NotificationSeverity.Info,
            "Context auto-loaded",
            $"{fileContexts.Count} file(s) loaded into context.");

        return true;
    }

