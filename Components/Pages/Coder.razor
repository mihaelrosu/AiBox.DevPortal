@page "/coder"
@rendermode InteractiveServer
@using System.Security.Cryptography
@using System.Text
<PageTitle>Local Coder</PageTitle>
<RadzenStack Gap="1rem">
<RadzenText Text="Local Coder" TextStyle="TextStyle.H4" />
<RadzenTabs Style="width: 100%;" @bind-SelectedIndex="@selectedTabIndex">
    <Tabs>
        <RadzenTabsItem Text="Work" Icon="edit_note">
            <RadzenStack Gap="1rem">
                <RadzenCard>
                    <RadzenStack Gap="0.25rem">
                        <RadzenText Text="Plan and prepare changes" TextStyle="TextStyle.H6" />
                        <RadzenText Text="Select a project and files, describe the task, then create a plan or generate a patch preview."
                                    TextStyle="TextStyle.Body2" />
                    </RadzenStack>
                </RadzenCard>

                <CoderProjectSelector ProjectPath="@request.ProjectPath"
                                      ProjectPathChanged="@OnProjectPathChanged"
                                      WorkspaceRoots="@workspaceRoots"
                                      IsLoading="@isLoading"
                                      OnRefresh="@LoadAsync">
                    <CoderPromptPanel Models="@models"
                                      Model="@request.Model"
                                      ModelChanged="@(value => request.Model = value)"
                                      Task="@request.Task"
                                      TaskChanged="@(value => request.Task = value)"
                                      IsLoading="@isLoading"
                                      IsPlanning="@isPlanning"
                                      IsGeneratingPatch="@isGeneratingPatch"
                                      CanVerifyProject="@(!isRunningCommand && !isVerifying && !string.IsNullOrWhiteSpace(request.ProjectPath))"
                                      CanReviewDiff="@CanReviewSelectedPatch()"
                                      OnCreatePlan="@CreatePlanAsync"
                                      OnGeneratePatchPreview="@GeneratePatchPreviewAsync"
                                      OnVerifyProject="@VerifyProjectAsync"
                                      OnReviewDiff="@ReviewSelectedPatchAsync">
                        <ContextContent>
                            <CoderFileContextPanel ProjectPath="@request.ProjectPath"
                                                   StatusText="@GetProjectFilesStatusText()"
                                                   SelectedFiles="@selectedFiles"
                                                   FileContexts="@fileContexts"
                                                   IsLoading="@(isLoading || isLoadingContext)"
                                                   IsLocked="@isContextLocked"
                                                   AllowedPatchScope="@request.AllowedPatchScope"
                                                   AllowedPatchScopeChanged="@(value => request.AllowedPatchScope = value)"
                                                   AllowedPatchFolders="@request.AllowedPatchFolders"
                                                   AllowedPatchFoldersChanged="@(value => request.AllowedPatchFolders = value.ToList())"
                                                   AllowedCreateFolders="@request.AllowedCreateFolders"
                                                   AllowedCreateFoldersChanged="@(value => request.AllowedCreateFolders = value.ToList())"
                                                   SelectedFilesChanged="@OnSelectedFilesChanged"
                                                   OnLoadPreset="@LoadPresetAsync"
                                                   OnClearAll="@ClearSelectedFilesAsync"
                                                   OnClearContext="@ClearContextAsync"
                                                   OnLockContext="@LockContextAsync"
                                                   OnUnlockContext="@UnlockContextAsync" />
                        </ContextContent>
                    </CoderPromptPanel>

                    @if (!string.IsNullOrWhiteSpace(promptContextStatusMessage))
                    {
                        <RadzenCard Style="margin-top: 0.75rem;">
                            <RadzenText Text="@promptContextStatusMessage" TextStyle="TextStyle.Body2" />
                        </RadzenCard>
                    }
                </CoderProjectSelector>

                <RadzenStack Gap="0.5rem">
                    <RadzenButton Text="Decompose Task" Icon="call_split" ButtonStyle="ButtonStyle.Light"
                                  Click="@DecomposeTask"
                                  Disabled="@string.IsNullOrWhiteSpace(request.Task)" />
                    <TaskPlanPreviewPanel Plan="@taskPlanPreview"
                                          IsGeneratingPatch="@isGeneratingPatch"
                                          IsVerifyingSlice="@isVerifyingSlice"
                                          IsRollingBack="@isRollingBackSlice"
                                          IsApplyingSlice="@isApplyingSlice"
                                          IsApplyingPlan="@isApplyingPlan"
                                          IsApprovalBusy="@isApprovalBusy"
                                          PlanApplyResult="@planApplyResult"
                                          HighRiskApplyApprovals="@highRiskApplyApprovals"
                                          SliceApprovals="@sliceApprovals"
                                          SliceRiskAnalyses="@sliceRiskAnalyses"
                                          SliceVerificationLoopResults="@sliceVerificationLoopResults"
                                          SliceStatusMessages="@sliceStatusMessages"
                                          OnApplyRequested="@ApplySliceAsync"
                                          OnApplyPlanRequested="@ApplyPlanAsync"
                                          OnApproveRequested="@ApproveSliceAsync"
                                          OnHighRiskApplyApprovalRequested="@ToggleHighRiskApplyApprovalAsync"
                                          OnGeneratePatchRequested="@GenerateSlicePatchPreviewAsync"
                                          OnRejectRequested="@RejectSliceAsync"
                                          OnRollbackRequested="@RollbackSliceAsync" />

                    @if (GetCurrentSliceBuildVerificationResults().Count > 0)
                    {
                        <RadzenCard>
                            <RadzenStack Gap="0.75rem">
                                <RadzenText Text="Apply Build Verification" TextStyle="TextStyle.H5" />

                                @foreach (var entry in GetCurrentSliceBuildVerificationResults())
                                {
                                    <RadzenCard Style="margin: 0;">
                                        <RadzenStack Gap="0.35rem">
                                            <RadzenText Text="@GetSliceTitle(entry.Key)" TextStyle="TextStyle.Body1" />

                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                                <RadzenBadge Text="@GetBuildStatusText(entry.Value.Success)"
                                                             BadgeStyle="@GetBuildStatusStyle(entry.Value.Success)" />
                                                <RadzenText Text="@($"Exit code: {entry.Value.ExitCode}")" TextStyle="TextStyle.Body2" />
                                                <RadzenText Text="@($"Verified at UTC: {entry.Value.VerifiedAtUtc:O}")" TextStyle="TextStyle.Caption" />
                                            </RadzenStack>

                                            <RadzenText Text="Build output" TextStyle="TextStyle.Caption" />
                                            <pre class="coder-output">@GetBuildOutputPreview(entry.Value.Output)</pre>
                                        </RadzenStack>
                                    </RadzenCard>
                                }
                            </RadzenStack>
                        </RadzenCard>
                    }

                    <TaskSliceApplyHistoryPanel Items="@applyHistoryItems" />
                    <TaskSliceApplyAuditPanel Items="@applyAuditEntries"
                                              IsBusy="@isRollingBackSlice"
                                              OnRollbackRequested="@RollbackApplyAuditAsync" />
                </RadzenStack>
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Knowledge" Icon="menu_book">
            <RadzenStack Gap="1rem">
                <RadzenCard>
                    <RadzenStack Gap="0.25rem">
                        <RadzenText Text="Project knowledge index" TextStyle="TextStyle.H6" />
                        <RadzenText Text="Rebuild and inspect the current project knowledge index for the selected project."
                                    TextStyle="TextStyle.Body2" />
                    </RadzenStack>
                </RadzenCard>

                <CoderKnowledgePanel ProjectPath="@request.ProjectPath"
                                     Index="@projectKnowledgeIndex"
                                     SelectedFilePaths="@selectedFilePaths"
                                     CurrentTaskText="@request.Task"
                                     StatusMessage="@knowledgeIndexStatusMessage"
                                     ErrorMessage="@knowledgeIndexErrorMessage"
                                     IsRebuilding="@isRebuildingKnowledgeIndex"
                                     OnRebuildIndex="@RebuildProjectKnowledgeIndexAsync"
                                     OnAddSuggestedFiles="@AddSuggestedFilesAsync" />

                <ProjectHistoryPanel />
                <TaskSliceHistoryPanel History="@sliceExecutionHistory" />
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Scheduled Runs" Icon="schedule">
            <CoderScheduledRunsPanel />
        </RadzenTabsItem>

        <RadzenTabsItem Text="Dashboard" Icon="dashboard">
            <RadzenStack Gap="1rem">
                <RadzenCard>
                    <RadzenStack Gap="0.25rem">
                        <RadzenText Text="Agent activity overview" TextStyle="TextStyle.H6" />
                        <RadzenText Text="Review agent runs, pause and resume checkpoints, apply activity, routing recommendations, risk distribution, and rollback records in one place."
                                    TextStyle="TextStyle.Body2" />
                    </RadzenStack>
                </RadzenCard>

                <AgentDashboardPanel />
                <AgentModelRecommendationPanel />
                <AgentProfilesPanel />
                <AgentModelBenchmarkPanel />
                <AgentModelComparisonPanel />
                <AgentOrchestrationPanel />
                <HumanApprovalQueuePanel />
                <AgentOrchestrationSafetyPanel />
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Plan" Icon="assignment">
            <RadzenStack Gap="1rem">
                <RadzenCard>
                    <RadzenStack Gap="0.25rem">
                        <RadzenText Text="Plan tasks and output" TextStyle="TextStyle.H6" />
                        <RadzenText Text="Review the generated plan, then execute one task at a time from here."
                                    TextStyle="TextStyle.Body2" />
                    </RadzenStack>
                </RadzenCard>

                @if (currentTask is null)
                {
                    <RadzenCard>
                        <RadzenText Text="Create a plan from the Work tab to see tasks here." TextStyle="TextStyle.Body1" />
                    </RadzenCard>
                }
                else
                {
                    <RadzenCard>
                        <RadzenStack Gap="0.75rem">
                            <RadzenText Text="Plan" TextStyle="TextStyle.H5" />
                            <pre class="coder-output">@currentTask.Plan</pre>
                        </RadzenStack>
                    </RadzenCard>

                    <RadzenCard>
                        <RadzenStack Gap="0.75rem">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                         JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                <RadzenText Text="Plan Tasks" TextStyle="TextStyle.H5" />
                                <RadzenBadge Text="@($"{PendingPlanTaskCount()} pending")"
                                             BadgeStyle="BadgeStyle.Info" />
                            </RadzenStack>
                            @foreach (var task in planTasks)
                            {
                                <RadzenCard Style="@PlanTaskCardStyle(task)">
                                    <RadzenStack Gap="0.5rem">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                                     JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                            <RadzenText Text="@PlanTaskTitle(task)" TextStyle="TextStyle.Body1" />
                                            <RadzenBadge Text="@task.Status.ToString()" BadgeStyle="@PlanTaskStatusBadgeStyle(task.Status)" />
                                        </RadzenStack>
                                        @if (!string.IsNullOrWhiteSpace(task.Description))
                                        {
                                            <RadzenText Text="@task.Description" TextStyle="TextStyle.Body2" />
                                        }
                                        @if (!string.IsNullOrWhiteSpace(task.StatusMessage))
                                        {
                                            <RadzenText Text="@task.StatusMessage" TextStyle="TextStyle.Caption" />
                                        }
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                            <RadzenButton Text="Select" Icon="check" ButtonStyle="ButtonStyle.Light"
                                                          Click="@(() => OnSelectedPlanTaskChangedAsync(task.Id))"
                                                          Disabled="@isLoading" />
                                        </RadzenStack>
                                    </RadzenStack>
                                </RadzenCard>
                            }

                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                <RadzenButton Text="Execute Selected Task" Icon="play_arrow" ButtonStyle="ButtonStyle.Primary"
                                              Click="@ExecuteSelectedTaskAsync"
                                              Disabled="@(!CanExecuteSelectedPlanTask())" />
                                <RadzenButton Text="Execute Next Task" Icon="skip_next" ButtonStyle="ButtonStyle.Secondary"
                                              Click="@ExecuteNextTaskAsync"
                                              Disabled="@(!CanExecuteNextPlanTask())" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                }
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Agent Profiles" Icon="badge">
            <RadzenStack Gap="1rem">
                <RadzenCard>
                    <RadzenStack Gap="0.25rem">
                        <RadzenText Text="Action routing profiles" TextStyle="TextStyle.H6" />
                        <RadzenText Text="Review which agent mode and model are assigned to each Local Coder action."
                                    TextStyle="TextStyle.Body2" />
                    </RadzenStack>
                </RadzenCard>
                <AgentProfilesPanel />
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Patch Preview" Icon="difference">
            <RadzenStack Gap="1rem">
                <RadzenCard>
                    <RadzenStack Gap="0.25rem">
                        <RadzenText Text="Review and approve changes" TextStyle="TextStyle.H6" />
                        <RadzenText Text="Inspect generated diffs and approval results before applying or rolling back a patch."
                                    TextStyle="TextStyle.Body2" />
                    </RadzenStack>
                </RadzenCard>
                <CoderDiffViewer Error="@error"
                                 ValidationErrors="@LastPatchValidationErrors"
                                 OperationGrammarErrors="@LastPatchOperationGrammarErrors"
                                 ReplaceDiagnostics="@LastPatchReplaceDiagnostics"
                                 SuggestedTargetDiagnostics="@LastPatchSuggestedTargetDiagnostics"
                                 SliceDebugDetails="@LastSlicePatchDebugDetails"
                                 SelectedSuggestedTarget="@selectedSuggestedTarget"
                                 ValidationGuidance="@LastPatchValidationGuidance"
                                 RepairSummary="@(patchPreview?.RepairSummary ?? LastPatchRepairSummary)"
                                 PromptAudit="@(patchPreview?.PromptAudit ?? LastPatchPromptAudit)"
                                 PromptTargetResolution="@(patchPreview?.PromptTargetResolution ?? LastPatchPromptTargetResolution)"
                                 PatchPreviewMetrics="@GetPatchPreviewMetrics()"
                                 RawResponse="@LastPatchRawResponse"
                                 NormalizedResponse="@LastPatchNormalizedResponse"
                                 NormalizedDiff="@LastPatchNormalizedDiff"
                                 PatchPreview="@patchPreview"
                                 ApplyResult="@applyResult"
                                 RollbackResult="@rollbackResult"
                                 CanApplyPatch="@CanApplyPatchPreview()"
                                 CanRollbackPatch="@CanRollbackPatch()"
                                 IsRollingBack="@isRollingBack"
                                 OnApplyPatch="@ApplyPatchAsync"
                                 OnRollbackPatch="@RollbackPatchAsync"
                                 OnUseSuggestedTarget="@SelectSuggestedTargetAsync"
                                 OnClearSuggestedTarget="@ClearSuggestedTargetAsync"
                                 OnRegenerateWithSuggestedTarget="@RegeneratePatchPreviewWithSuggestedTargetAsync"
                                 OnFixPatchPreview="@FixPatchPreviewAsync" />
                <CoderPatchQueuePanel PatchPackages="@patchPackages"
                                      SelectedPatchPackage="@selectedPatchPackage"
                                      CanReview="@CanReviewSelectedPatch()"
                                      CanApprove="@CanApproveSelectedPatch()"
                                      CanApply="@CanApplySelectedPatch()"
                                      CanVerify="@CanVerifySelectedPatch()"
                                      CanRollback="@CanRollbackSelectedPatch()"
                                      OnPatchSelected="@OnPatchPackageSelected"
                                      OnReview="@ReviewSelectedPatchAsync"
                                      OnApprove="@ApproveSelectedPatchAsync"
                                      OnApply="@ApplySelectedPatchAsync"
                                      OnVerify="@VerifySelectedPatchAsync"
                                      OnRollback="@RollbackSelectedPatchAsync" />
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Verify & Output" Icon="terminal">
            <RadzenStack Gap="1rem">
                <RadzenCard>
                    <RadzenStack Gap="0.25rem">
                        <RadzenText Text="Run and inspect project operations" TextStyle="TextStyle.H6" />
                        <RadzenText Text="Run safe commands, verify the project, and review command, build, test, and deployment output."
                                    TextStyle="TextStyle.Body2" />
                    </RadzenStack>
                </RadzenCard>
                <CoderExecutionPanel IsRunningCommand="@isRunningCommand"
                                     CanVerifyProject="@(!isRunningCommand && !isVerifying && !string.IsNullOrWhiteSpace(request.ProjectPath))"
                                     VerificationProfiles="@verificationProfiles"
                                     SelectedVerificationProfileId="@selectedVerificationProfileId"
                                     SelectedVerificationProfileIdChanged="@OnSelectedVerificationProfileChanged"
                                     CanCommitChanges="@CanCommitChanges()"
                                     CanBuildDeploy="@CanBuildDeploy()"
                                     CommitMessage="@commitMessage"
                                     CommitMessageChanged="@(value => commitMessage = value)"
                                     CommitResults="@commitResults"
                                     BuildDeployResults="@buildDeployResults"
                                     VerifyResults="@verifyResults"
                                     LastCommand="@lastCommand"
                                     OnRunCommand="@RunCommandAsync"
                                     OnVerifyProject="@VerifyProjectAsync"
                                     OnCommitChanges="@CommitChangesAsync"
                                     OnBuildDeploy="@BuildDeployAsync" />
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="History" Icon="history">
            <RadzenStack Gap="1rem">
                <RadzenCard>
                    <RadzenStack Gap="0.25rem">
                        <RadzenText Text="Review previous activity" TextStyle="TextStyle.H6" />
                        <RadzenText Text="Inspect agent runs and Local Coder tasks, or reuse a previous task as context."
                                    TextStyle="TextStyle.Body2" />
                    </RadzenStack>
                </RadzenCard>
                <CoderHistoryPanel ShowAgentRunHistory="true"
                                   AgentRunHistory="@agentRunHistory"
                                   SelectedAgentRun="@selectedAgentRun"
                                   OnAgentRunSelected="@OnAgentRunSelected"
                                   ShowTaskHistory="true"
                                   HistoryEntries="@historyEntries"
                                   SelectedHistoryEntry="@selectedHistoryEntry"
                                   IsLoadingHistory="@isLoadingHistory"
                                   IsClearingHistory="@isClearingHistory"
                                   OnClearHistory="@ClearHistoryAsync"
                                   OnViewHistoryEntry="@ViewHistoryEntryAsync"
                                   OnUseHistoryEntryAsContext="@UseHistoryEntryAsContextAsync"
                                   OnRestoreContext="@RestoreHistoryContextAsync"
                                   ContextRestoreResult="@contextRestoreResult" />
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Execution History" Icon="schedule">
            <RadzenStack Gap="1rem">
                <RadzenCard>
                    <RadzenStack Gap="0.25rem">
                        <RadzenText Text="Scheduled execution history" TextStyle="TextStyle.H6" />
                        <RadzenText Text="Review the latest scheduled agent executions and refresh the list as needed."
                                    TextStyle="TextStyle.Body2" />
                    </RadzenStack>
                </RadzenCard>

                <CoderExecutionHistoryPanel />
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Scheduled Runs" Icon="event_repeat">
            <RadzenStack Gap="1rem">
                <RadzenCard>
                    <RadzenStack Gap="0.25rem">
                        <RadzenText Text="Manage scheduled runs" TextStyle="TextStyle.H6" />
                        <RadzenText Text="Inspect the configured schedules, review their latest status, and toggle them on or off."
                                    TextStyle="TextStyle.Body2" />
                    </RadzenStack>
                </RadzenCard>

                <CoderScheduledRunsPanel />
            </RadzenStack>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>
</RadzenStack>

@code {
    #region Injected services

    [Inject] private ICoderConsoleService CoderConsoleService { get; set; } = default!;
    [Inject] private IAgentModeRunner AgentModeRunner { get; set; } = default!;
    [Inject] private IAgentModeProfileService AgentModeProfiles { get; set; } = default!;
    [Inject] private IAgentRunHistoryService AgentRunHistoryService { get; set; } = default!;
    [Inject] private IPatchPackageService PatchPackageService { get; set; } = default!;
    [Inject] private IPatchApplyService PatchApplyService { get; set; } = default!;
    [Inject] private IPatchRollbackService PatchRollbackService { get; set; } = default!;
    [Inject] private TaskSliceApprovalService TaskSliceApprovalService { get; set; } = default!;
    [Inject] private TaskSliceApplyService TaskSliceApplyService { get; set; } = default!;
    [Inject] private TaskPlanApplyService TaskPlanApplyService { get; set; } = default!;
    [Inject] private TaskSliceRiskAnalysisService TaskSliceRiskAnalysisService { get; set; } = default!;
    [Inject] private TaskSliceApplyHistoryService TaskSliceApplyHistoryService { get; set; } = default!;
    [Inject] private TaskSliceApplyAuditService TaskSliceApplyAuditService { get; set; } = default!;
    [Inject] private ILocalCoderVerificationProfileService LocalCoderVerificationProfileService { get; set; } = default!;
    [Inject] private IProjectKnowledgeIndexService ProjectKnowledgeIndexService { get; set; } = default!;
    [Inject] private PlannerContextSelectionService PlannerContextSelectionService { get; set; } = default!;
    [Inject] private TaskSlicePatchPreviewPreparationService TaskSlicePatchPreviewPreparationService { get; set; } = default!;
    [Inject] private TaskDecompositionService TaskDecompositionService { get; set; } = default!;
    [Inject] private TaskSliceExecutionService TaskSliceExecutionService { get; set; } = default!;
    [Inject] private TaskSliceRollbackService TaskSliceRollbackService { get; set; } = default!;
    [Inject] private TaskSliceVerificationLoopService TaskSliceVerificationLoopService { get; set; } = default!;
    [Inject] private AiBox.DevPortal.Services.ILocalCoderHistoryService LocalCoderHistoryService { get; set; } = default!;
    [Inject] private ILocalCoderContextService LocalCoderContextService { get; set; } = default!;
    [Inject] private Radzen.DialogService DialogService { get; set; } = default!;
    [Inject] private Radzen.NotificationService NotificationService { get; set; } = default!;

    #endregion

    #region Page state

    private readonly LocalCoderRequest request = new();

    private IReadOnlyList<string> workspaceRoots = [];
    private IReadOnlyList<string> models = [];
    private IReadOnlyList<CommandRunResult> verifyResults = [];
    private IReadOnlyList<CommandRunResult> commitResults = [];
    private IReadOnlyList<CommandRunResult> buildDeployResults = [];
    private IReadOnlyList<AgentModeProfile> agentModeProfiles = [];
    private IReadOnlyList<LocalCoderVerificationProfile> verificationProfiles = [];
    private IReadOnlyList<AgentRunRecord> agentRunHistory = [];
    private IReadOnlyList<PatchPackage> patchPackages = [];
    private IReadOnlyList<LocalCoderHistoryEntry> historyEntries = [];
    private IReadOnlyList<TaskSliceExecutionResult> sliceExecutionHistory = [];
    private IReadOnlyList<TaskSliceApplyHistoryItem> applyHistoryItems = [];
    private IReadOnlyList<TaskSliceApplyAuditEntry> applyAuditEntries = [];
    private IReadOnlyDictionary<string, TaskSliceApproval> sliceApprovals = new Dictionary<string, TaskSliceApproval>(StringComparer.OrdinalIgnoreCase);
    private ProjectKnowledgeIndex? projectKnowledgeIndex;
    private List<LocalCoderFileContext> fileContexts = [];
    private List<string> selectedFilePaths = [];
    private List<FileSearchItem> selectedFiles = [];
    private readonly HashSet<string> confirmedGeneratedFilePaths = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> highRiskApplyApprovals = new(StringComparer.OrdinalIgnoreCase);
    private int contextLoadVersion;
    private readonly List<LocalCoderPlanTask> planTasks = [];
    private TaskPlan? taskPlanPreview;
    private readonly Dictionary<string, string> sliceStatusMessages = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, TaskSliceBuildVerificationResult> sliceBuildVerificationResults = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, TaskSliceVerificationLoopResult> sliceVerificationLoopResults = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyDictionary<string, TaskSliceRiskAnalysis> sliceRiskAnalyses = new Dictionary<string, TaskSliceRiskAnalysis>(StringComparer.OrdinalIgnoreCase);

    private AiBox.DevPortal.Models.LocalCoderTask? currentTask;
    private LocalCoderPatchPreview? patchPreview;
    private PatchIntent? patchIntent;
    private PatchIntentValidation? patchIntentValidation;
    private LocalCoderPatchApplyResult? applyResult;
    private LocalCoderPatchRollbackResult? rollbackResult;
    private bool isApplyingSlice;
    private bool isApplyingPlan;
    private bool isApprovalBusy;
    private TaskPlanApplyResult? planApplyResult;
    private CommandRunResult? lastCommand;
    private LocalCoderHistoryEntry? selectedHistoryEntry;
    private LocalCoderContextRestoreResult? contextRestoreResult;
    private AgentRunRecord? selectedAgentRun;
    private PatchPackage? selectedPatchPackage;
    private string commitMessage = string.Empty;
    private string? selectedPlanTaskId;
    private string? activePlanTaskId;
    private string selectedVerificationProfileId = "quick";
    private string? knowledgeIndexStatusMessage;
    private string? knowledgeIndexErrorMessage;
    private string? promptContextStatusMessage;
    private string LastPatchRawResponse { get; set; } = string.Empty;
    private string LastPatchTaskText { get; set; } = string.Empty;
    private string LastPatchNormalizedResponse { get; set; } = string.Empty;
    private string LastPatchNormalizedDiff { get; set; } = string.Empty;
    private IReadOnlyList<string> LastPatchValidationErrors { get; set; } = [];
    private IReadOnlyList<string> LastPatchOperationGrammarErrors { get; set; } = [];
    private IReadOnlyList<PatchReplaceDiagnostic> LastPatchReplaceDiagnostics { get; set; } = [];
    private IReadOnlyList<PatchSuggestedTargetDiagnostic> LastPatchSuggestedTargetDiagnostics { get; set; } = [];
    private IReadOnlyList<PatchValidationGuidance> LastPatchValidationGuidance { get; set; } = [];
    private IReadOnlyList<string> LastSlicePatchDebugDetails { get; set; } = [];
    private PatchPreviewRepairSummary? LastPatchRepairSummary { get; set; }

    private PatchPromptAudit? LastPatchPromptAudit { get; set; }

    private PatchPromptTargetResolution? LastPatchPromptTargetResolution { get; set; }
    private PatchSuggestedTargetSelection? selectedSuggestedTarget;
    private LocalCoderPlanTask? lastPatchPlanTask;
    private int selectedTabIndex;
    private const string SlicePreviewMissingTargetsMessage =
        "This slice has no valid target files, related files, selected context files, or create targets. Add slice targets before generating a patch preview.";

    private bool isLoading;
    private bool isLoadingContext;
    private bool isContextLocked;
    private bool isPlanning;
    private bool isGeneratingPatch;
    private bool isVerifyingSlice;
    private bool isApplyingPatch;
    private bool isRollingBack;
    private bool isRollingBackSlice;
    private bool isRunningCommand;
    private bool isVerifying;
    private bool isCommitRunning;
    private bool isBuildDeployRunning;
    private bool isRebuildingKnowledgeIndex;
    private bool isLoadingHistory;
    private bool isClearingHistory;

    private string? error;

    #endregion

    #region Lifecycle methods

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            workspaceRoots = await CoderConsoleService.GetWorkspaceRootsAsync();
            models = await CoderConsoleService.GetOllamaModelsAsync();

            if (string.IsNullOrWhiteSpace(request.ProjectPath))
            {
                request.ProjectPath = workspaceRoots.FirstOrDefault(IsDevPortalProjectRoot)
                    ?? workspaceRoots.FirstOrDefault()
                    ?? string.Empty;
            }

            if (string.IsNullOrWhiteSpace(request.Model) || !models.Contains(request.Model, StringComparer.OrdinalIgnoreCase))
            {
                request.Model = models.Contains("qwen2.5-coder:7b", StringComparer.OrdinalIgnoreCase)
                    ? "qwen2.5-coder:7b"
                    : models.FirstOrDefault() ?? request.Model;
            }

            agentModeProfiles = await AgentModeProfiles.GetAllAsync();
            verificationProfiles = await LocalCoderVerificationProfileService.GetAllAsync();
            selectedVerificationProfileId = ResolveVerificationProfileId(selectedVerificationProfileId);
            await LoadProjectKnowledgeIndexAsync();
            await LoadAgentRunHistoryAsync();
            await LoadPatchQueueAsync();
            await LoadHistoryAsync();
            await LoadApprovalStatesAsync();
            await LoadApplyHistoryAsync();
            await LoadApplyAuditAsync();
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
    private async Task ApplySliceAsync(TaskPlanSlice slice)
    {
        isApplyingSlice = true;
        try
        {
            var result = await TaskSliceApplyService.ApplyAsync(
                request.ProjectPath,
                slice,
                highRiskApproved: IsHighRiskApplyApproved(slice));

            var statusMessage = string.IsNullOrWhiteSpace(result.RollbackMessage)
                ? result.Message
                : $"{result.Message}{Environment.NewLine}{result.RollbackMessage}";

            if (!string.IsNullOrWhiteSpace(result.RiskGateMessage) &&
                !string.Equals(result.RiskGateMessage, result.Message, StringComparison.Ordinal))
            {
                statusMessage = $"{statusMessage}{Environment.NewLine}{result.RiskGateMessage}";
            }

            sliceStatusMessages[slice.Id] = statusMessage;
            if (result.BuildVerificationResult is not null)
            {
                sliceBuildVerificationResults[slice.Id] = result.BuildVerificationResult;
            }
            else
            {
                sliceBuildVerificationResults.Remove(slice.Id);
            }

            if (result.RolledBack)
            {
                slice.Status = TaskSliceStatus.RolledBack;
                slice.AppliedAt = null;
            }
            else if (result.BuildVerificationResult?.Success == true)
            {
                slice.Status = TaskSliceStatus.Applied;
                slice.AppliedAt = DateTime.UtcNow;
            }
            else
            {
                slice.Status = TaskSliceStatus.Failed;
                slice.AppliedAt = null;
            }

            NotificationService.Notify(
                result.Success ? NotificationSeverity.Success : result.RolledBack ? NotificationSeverity.Warning : NotificationSeverity.Error,
                result.Success ? "Slice applied" : result.RolledBack ? "Rollback completed" : "Apply failed",
                result.Message);

            await LoadApplyHistoryAsync();
            await LoadApplyAuditAsync();
            await LoadApprovalStatesAsync();
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            isApplyingSlice = false;
        }
    }

    private async Task RollbackApplyAuditAsync(TaskSliceApplyAuditEntry auditEntry)
    {
        if (taskPlanPreview is null)
        {
            return;
        }

        var slice = taskPlanPreview.Slices.FirstOrDefault(item => string.Equals(item.Id, auditEntry.SliceId, StringComparison.OrdinalIgnoreCase));
        if (slice is null)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Rollback unavailable", "The slice is no longer available in the current plan preview.");
            return;
        }

        isRollingBackSlice = true;
        try
        {
            var rollbackResult = await TaskSliceRollbackService.RollbackSliceAsync(slice);
            var rollbackMessage = rollbackResult.Summary;

            await TaskSliceApplyAuditService.AddAsync(new TaskSliceApplyAuditEntry
            {
                TimestampUtc = DateTime.UtcNow,
                PlanId = auditEntry.PlanId,
                SliceId = auditEntry.SliceId,
                SliceTitle = auditEntry.SliceTitle,
                RiskLevel = auditEntry.RiskLevel,
                RiskScore = auditEntry.RiskScore,
                ApprovedHighRiskApply = auditEntry.ApprovedHighRiskApply,
                Success = rollbackResult.Success,
                Blocked = false,
                Message = $"Rollback: {rollbackMessage}",
                ChangedFiles = [.. auditEntry.ChangedFiles]
            });

            sliceStatusMessages[slice.Id] = rollbackMessage;
            await LoadApplyAuditAsync();
            await LoadApplyHistoryAsync();
            await InvokeAsync(StateHasChanged);

            NotificationService.Notify(
                rollbackResult.Success ? NotificationSeverity.Success : NotificationSeverity.Warning,
                rollbackResult.Success ? "Rollback completed" : "Rollback failed",
                rollbackMessage);
        }
        catch (Exception exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Rollback failed", exception.Message);
        }
        finally
        {
            isRollingBackSlice = false;
        }
    }

