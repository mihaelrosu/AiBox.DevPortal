@page "/ollama"
@rendermode InteractiveServer

<PageTitle>Ollama</PageTitle>

<div class="page-header">
    <div>
        <h1>Ollama</h1>
        <p>@health?.Url</p>
    </div>
    <RadzenButton Text="Check" Icon="health_and_safety" ButtonStyle="ButtonStyle.Light" Click="LoadHealthAsync" Disabled="@isLoading" />
</div>

<RadzenCard>
    @if (health is null)
    {
        <p>Checking service status...</p>
    }
    else
    {
        <RadzenBadge Text="@health.Status" BadgeStyle="@(health.IsAvailable ? BadgeStyle.Success : BadgeStyle.Danger)" />
    }
</RadzenCard>

@code {
    [Inject]
    private IOllamaService OllamaService { get; set; } = default!;

    private ServiceHealth? health;
    private bool isLoading;

    protected override Task OnInitializedAsync()
    {
        return LoadHealthAsync();
    }

    private async Task LoadHealthAsync()
    {
        isLoading = true;
        health = await OllamaService.GetHealthAsync();
        isLoading = false;
    }
}
