Style=\u0022AlertStyle.Warning\u0022 ShowIcon=\u0022true\u0022\u003EPatch previews must be approved before they can be applied.\u003C/RadzenAlert\u003E\n            \u003C/RadzenColumn\u003E\n                    \u003CRadzenText Text=\u0022Each action below routes through a fixed profile before it runs.\u0022\n                                TextStyle=\u0022TextStyle.Body2\u0022 /\u003E\n\n                    @if (agentModeProfiles.Count == 0)\n                    {\n                        \u003CRadzenText Text=\u0022Loading profiles...\u0022 TextStyle=\u0022TextStyle.Body2\u0022 /\u003E\n                    }\n                    else\n                    {\n                        @foreach (var profileRow in GetProfileRows())\n                        {\n                            \u003CRadzenCard Style=\u0022margin: 0;\u0022\u003E\n                                \u003CRadzenStack Gap=\u00220.25rem\u0022\u003E\n                                    \u003CRadzenText Text=\u0022@profileRow.ActionLabel\u0022 TextStyle=\u0022TextStyle.Body1\u0022 /\u003E\n                                    \u003CRadzenText Text=\u0022@($\u0022{profileRow.Profile.Name} | Model: {profileRow.Profile.Model}\u0022)\u0022\n                                                TextStyle=\u0022TextStyle.Body2\u0022 /\u003E\n                                    \u003CRadzenText Text=\u0022@profileRow.Profile.RulesSummary\u0022 TextStyle=\u0022TextStyle.Caption\u0022 /\u003E\n                                \u003C/RadzenStack\u003E\n                            \u003C/RadzenCard\u003E\n                        }\n                    }\n                \u003C/RadzenStack\u003E\n            \u003C/RadzenCard\u003E\n\n            \u003CRadzenCard\u003E\n                \u003CRadzenStack Gap=\u00220.75rem\u0022\u003E\n                    \u003CRadzenText Text=\u0022Agent Run History\u0022 TextStyle=\u0022TextStyle.H5\u0022 /\u003E\n                    \u003CRadzenText Text=\u0022Newest runs appear first. Select a row to inspect the prompt and result text.\u0022\n                                TextStyle=\u0022TextStyle.Body2\u0022 /\u003E\n\n                    \u003CRadzenDataGrid Data=\u0022@agentRunHistory\u0022 TItem=\u0022AgentRunRecord\u0022 AllowPaging=\u0022true\u0022 PageSize=\u002210\u0022\n                                    AllowSorting=\u0022false\u0022 EmptyText=\u0022No agent runs recorded yet.\u0022\n                                    RowSelect=\u0022@OnAgentRunSelected\u0022\u003E\n                        \u003CColumns\u003E\n                            \u003CRadzenDataGridColumn TItem=\u0022AgentRunRecord\u0022 Title=\u0022Timestamp\u0022\u003E\n                                \u003CTemplate Context=\u0022run\u0022\u003E\n                                    @run.Timestamp.ToString(\u0022yyyy-MM-dd HH:mm:ss\u0022)\n                                \u003C/Template\u003E\n                            \u003C/RadzenDataGridColumn\u003E\n                            \u003CRadzenDataGridColumn TItem=\u0022AgentRunRecord\u0022 Property=\u0022ActionKey\u0022 Title=\u0022Action\u0022 /\u003E\n                            \u003CRadzenDataGridColumn TItem=\u0022AgentRunRecord\u0022 Property=\u0022ProfileMode\u0022 Title=\u0022Profile\u0022 /\u003E\n                            \u003CRadzenDataGridColumn TItem=\u0022AgentRunRecord\u0022 Property=\u0022Model\u0022 Title=\u0022Model\u0022 /\u003E\n                            \u003CRadzenDataGridColumn TItem=\u0022AgentRunRecord\u0022 Title=\u0022Success\u0022\u003E\n                                \u003CTemplate Context=\u0022run\u0022\u003E\n                                    \u003CRadzenBadge Text=\u0022@(run.Success ? \u0022Success\u0022 : \u0022Failed\u0022)\u0022\n                                                 BadgeStyle=\u0022@(run.Success ? BadgeStyle.Success : BadgeStyle.Warning)\u0022 /\u003E\n                                \u003C/Template\u003E\n                            \u003C/RadzenDataGridColumn\u003E\n                            \u003CRadzenDataGridColumn TItem=\u0022AgentRunRecord\u0022 Property=\u0022ErrorMessage\u0022 Title=\u0022Error\u0022 /\u003E\n                        \u003C/Columns\u003E\n                    \u003C/RadzenDataGrid\u003E\n\n                    @if (selectedAgentRun is not null)\n                    {\n                        \u003CRadzenCard\u003E\n                            \u003CRadzenStack Gap=\u00220.5rem\u0022\u003E\n                                \u003CRadzenText Text=\u0022Selected Run\u0022 TextStyle=\u0022TextStyle.H6\u0022 /\u003E\n                                \u003CRadzenText Text=\u0022@($\u0022Action: {selectedAgentRun.ActionKey}\u0022)\u0022 TextStyle=\u0022TextStyle.Body1\u0022 /\u003E\n                                \u003CRadzenText Text=\u0022@($\u0022Profile mode: {selectedAgentRun.ProfileMode}\u0022)\u0022 TextStyle=\u0022TextStyle.Body1\u0022 /\u003E\n                                \u003CRadzenText Text=\u0022@($\u0022Model: {selectedAgentRun.Model}\u0022)\u0022 TextStyle=\u0022TextStyle.Body1\u0022 /\u003E\n                                \u003CRadzenText Text=\u0022@($\u0022Timestamp: {selectedAgentRun.Timestamp:O}\u0022)\u0022 TextStyle=\u0022TextStyle.Body1\u0022 /\u003E\n                                \u003CRadzenText Text=\u0022@($\u0022Success: {selectedAgentRun.Success}\u0022)\u0022 TextStyle=\u0022TextStyle.Body1\u0022 /\u003E\n                                \u003CRadzenText Text=\u0022@($\u0022Error: {selectedAgentRun.ErrorMessage}\u0022)\u0022 TextStyle=\u0022TextStyle.Body1\u0022 /\u003E\n\n                                \u003CRadzenText Text=\u0022User Request\u0022 TextStyle=\u0022TextStyle.H6\u0022 /\u003E\n                                \u003Cpre class=\u0022coder-output\u0022\u003E@selectedAgentRun.UserRequest\u003C/pre\u003E\n\n                                \u003CRadzenText Text=\u0022Prompt Sent\u0022 TextStyle=\u0022TextStyle.H6\u0022 /\u003E\n                                \u003Cpre class=\u0022coder-output\u0022\u003E@selectedAgentRun.PromptSent\u003C/pre\u003E\n\n                                \u003CRadzenText Text=\u0022Result Text\u0022 TextStyle=\u0022TextStyle.H6\u0022 /\u003E\n                                \u003Cpre class=\u0022coder-output\u0022\u003E@selectedAgentRun.ResultText\u003C/pre\u003E\n                            \u003C/RadzenStack\u003E\n                        \u003C/RadzenCard\u003E\n                    }\n                \u003C/RadzenStack\u003E\n            \u003C/RadzenCard\u003E\n\n            \u003CRadzenCard\u003E\n                \u003CRadzenStack Gap=\u00220.75rem\u0022\u003E\n                    \u003CRadzenStack Orientation=\u0022Orientation.Horizontal\u0022 AlignItems=\u0022AlignItems.Center\u0022\n                                 JustifyContent=\u0022JustifyContent.SpaceBetween\u0022 Gap=\u00220.75rem\u0022 Wrap=\u0022FlexWrap.Wrap\u0022\u003E\n                        \u003Cdiv\u003E\n                            \u003CRadzenText Text=\u0022File Context\u0022 TextStyle=\u0022TextStyle.H5\u0022 /\u003E\n                            \u003CRadzenText Text=\u0022@GetProjectFilesStatusText()\u0022 TextStyle=\u0022TextStyle.Body2\u0022 /\u003E\n                        \u003C/div\u003E\n\n                        \u003CRadzenStack Orientation=\u0022Orientation.Horizontal\u0022 Gap=\u00220.5rem\u0022 Wrap=\u0022FlexWrap.Wrap\u0022\u003E\n                            \u003CRadzenButton Text=\u0022Preview Context\u0022 Icon=\u0022description\u0022 ButtonStyle=\u0022ButtonStyle.Primary\u0022\n                                          Click=\u0022@PreviewContextAsync\u0022\n                                          Disabled=\u0022@(isLoading || string.IsNullOrWhiteSpace(request.ProjectPath) || !selectedFilePaths.Any())\u0022 /\u003E\n\n                            \u003CRadzenButton Text=\u0022Clear Selected\u0022 Icon=\u0022remove_circle_outline\u0022\n                                          ButtonStyle=\u0022ButtonStyle.Light\u0022 Click=\u0022@ClearSelectedFilesAsync\u0022\n                                          Disabled=\u0022@(isLoading || !selectedFilePaths.Any())\u0022 /\u003E\n\n                            \u003CRadzenButton Text=\u0022Clear Context\u0022 Icon=\u0022clear\u0022 ButtonStyle=\u0022ButtonStyle.Light\u0022\n                                          Click=\u0022@ClearContextAsync\u0022 Disabled=\u0022@(isLoading || fileContexts.Count == 0)\u0022 /\u003E\n                        \u003C/RadzenStack\u003E\n                    \u003C/RadzenStack\u003E\n\n                    \u003CRadzenText Text=\u0022@($\u0022Loaded context files: {fileContexts.Count}\u0022)\u0022 TextStyle=\u0022TextStyle.Body2\u0022 /\u003E\n\n                    \u003CFileAutoComplete RootDirectory=\u0022@request.ProjectPath\u0022\n                                      Placeholder=\u0022Search by relative path or file name, e.g. Coder.razor, service, Program.cs\u0022\n                                      ShowSelectedInfo=\u0022true\u0022 SelectedFiles=\u0022@selectedFiles\u0022\n                                      SelectedFilesChanged=\u0022@OnSelectedFilesChanged\u0022 FileSelected=\u0022@OnFileSelected\u0022 /\u003E\n                \u003C/RadzenStack\u003E\n            \u003C/RadzenCard\u003E\n\n            \u003CRadzenFormField Text=\u0022Model\u0022\u003E\n                \u003CRadzenDropDown TValue=\u0022string\u0022 @bind-Value=\u0022request.Model\u0022 Data=\u0022@models\u0022 Style=\u0022width: 100%;\u0022\n                                Placeholder=\u0022Select Ollama model\u0022 /\u003E\n            \u003C/RadzenFormField\u003E\n\n            \u003CRadzenFormField Text=\u0022Task\u0022\u003E\n                \u003CRadzenTextArea @bind-Value=\u0022request.Task\u0022 Rows=\u00226\u0022 Style=\u0022width: 100%;\u0022\n                                Placeholder=\u0022Example: review AiBox.DevPortal and suggest the next safe Local Coder improvement\u0022 /\u003E\n            \u003C/RadzenFormField\u003E\n\n            \u003CRadzenStack Orientation=\u0022Orientation.Horizontal\u0022 Gap=\u00220.5rem\u0022 Wrap=\u0022FlexWrap.Wrap\u0022\u003E\n                \u003CRadzenButton Text=\u0022Create Plan\u0022 Icon=\u0022psychology\u0022 ButtonStyle=\u0022ButtonStyle.Primary\u0022\n                              Click=\u0022@CreatePlanAsync\u0022\n                              Disabled=\u0022@(isLoading || isPlanning || string.IsNullOrWhiteSpace(request.Task))\u0022 /\u003E\n\n                \u003CRadzenButton Text=\u0022Generate Patch Preview\u0022 Icon=\u0022difference\u0022 ButtonStyle=\u0022ButtonStyle.Warning\u0022\n                              Click=\u0022@GeneratePatchPreviewAsync\u0022\n                              Disabled=\u0022@(isLoading || isGeneratingPatch || string.IsNullOrWhiteSpace(request.Task))\u0022 /\u003E\n            \u003C/RadzenStack\u003E\n\n            \u003CRadzenText Text=\u0022Preview only. No files are modified automatically.\u0022 TextStyle=\u0022TextStyle.Caption\u0022 /\u003E\n        \u003C/RadzenStack\u003E\n    \u003C/RadzenCard\u003E\n\n    @if (!string.IsNullOrWhiteSpace(error))\n    {\n        \u003CRadzenAlert AlertStyle=\u0022AlertStyle.Danger\u0022 ShowIcon=\u0022true\u0022\u003E\n            @error\n        \u003C/RadzenAlert\u003E\n    }\n\n    @if (patchPreview is not null)\n    {\n        \u003CRadzenCard\u003E\n            \u003CRadzenStack Gap=\u00220.75rem\u0022\u003E\n                \u003CRadzenStack Orientation=\u0022Orientation.Horizontal\u0022 AlignItems=\u0022AlignItems.Center\u0022\n                             JustifyContent=\u0022JustifyContent.SpaceBetween\u0022 Gap=\u00220.75rem\u0022 Wrap=\u0022FlexWrap.Wrap\u0022\u003E\n                    \u003CRadzenText Text=\u0022Patch Preview\u0022 TextStyle=\u0022TextStyle.H5\u0022 /\u003E\n\n                    \u003CRadzenStack Orientation=\u0022Orientation.Horizontal\u0022 Gap=\u00220.5rem\u0022 Wrap=\u0022FlexWrap.Wrap\u0022\u003E\n                        \u003CCopyToClipboardButton Text=\u0022Copy Patch\u0022 Value=\u0022@patchPreview.PatchText\u0022 SuccessTitle=\u0022Patch copied\u0022\n                                               SuccessMessage=\u0022The patch preview was copied to the clipboard.\u0022 /\u003E\n\n                        \u003CRadzenButton Text=\u0022Apply Patch\u0022 Icon=\u0022publish\u0022 ButtonStyle=\u0022ButtonStyle.Danger\u0022\n                                      Click=\u0022@ApplyPatchAsync\u0022 Disabled=\u0022@(!CanApplyPatchPreview())\u0022 /\u003E\n\n                    \u003C/RadzenStack\u003E\n\n                    \u003CRadzenText Text=\u0022Preview only. No files are modified automatically.\u0022 TextStyle=\u0022TextStyle.Caption\u0022 /\u003E\n                    \u003Cpre class=\u0022coder-output\u0022\u003E@patchPreview.PatchText\u003C/pre\u003E\n\n                    @if (applyResult is not null)\n                    {\n                        \u003CRadzenText Text=\u0022Apply Patch Message\u0022 TextStyle=\u0022TextStyle.H6\u0022 /\u003E\n                        \u003Cpre class=\u0022coder-output\u0022\u003E@applyResult.Message\u003C/pre\u003E\n                    }\n                \u003C/RadzenStack\u003E\n            \u003C/RadzenStack\u003E\n        \u003C/RadzenCard\u003E\n    }\n\n    @if (applyResult is not null)\n    {\n        \u003CRadzenCard\u003E\n            \u003CRadzenStack Gap=\u00220.75rem\u0022\u003E\n                \u003CRadzenText Text=\u0022Patch Apply Result\u0022 TextStyle=\u0022TextStyle.H5\u0022 /\u003E\n\n                \u003CRadzenAlert\n                    AlertStyle=\u0022@(applyResult.Applied \u0026\u0026 applyResult.VerificationPassed ? AlertStyle.Success : AlertStyle.Warning)\u0022\n                    ShowIcon=\u0022true\u0022\u003E\n     "
    }
  ]
}