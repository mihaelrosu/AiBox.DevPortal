      "oldContent": "@page \u0022/coder\u0022\n@rendermode InteractiveServer\n@using AiBox.DevPortal.Models\n@using AiBox.DevPortal.Components.Common\n@using AiBox.DevPortal.Services\n@using Radzen.Blazor\n@using AiBox.DevPortal.Components\n\n\u003CPageTitle\u003ELocal Coder\u003C/PageTitle\u003E\n\n\u003CRadzenStack Gap=\u00221rem\u0022\u003E\n    \u003CRadzenRow AlignItems=\u0022AlignItems.Center\u0022\u003E\n        \u003CRadzenColumn\u003E\n            \u003CRadzenText Text=\u0022Local Coder\u0022 TextStyle=\u0022TextStyle.H4\u0022 /\u003E\n            \u003CRadzenText\n            Text=\u0022Use a local Ollama model to plan code changes, generate patch previews, apply patches, rollback patches, and run safe verification commands.\u0022\n            TextStyle=\u0022TextStyle.Body2\u0022 /\u003E\n        \u003C/RadzenColumn\u003E\n        \u003CRadzenColumn Size=\u002212\u0022 SizeMD=\u00223\u0022\u003E\n            \u003CRadzenButton Text=\u0022Refresh\u0022 Icon=\u0022refresh\u0022 Click=\u0022@LoadAsync\u0022 Disabled=\u0022@isLoading\u0022 Style=\u0022width: 100%;\u0022 /\u003E\n        \u003C/RadzenColumn\u003E\n    \u003C/RadzenRow\u003E\n    \u003CRadzenCard\u003E\n        \u003CRadzenStack Gap=\u00221rem\u0022\u003E\n            \u003CRadzenFormField Text=\u0022Project path\u0022\u003E\n                \u003CRadzenDropDown TValue=\u0022string\u0022 @bind-Value=\u0022request.ProjectPath\u0022 Data=\u0022@workspaceRoots\u0022\n                                Change=\u0022@OnProjectPathChanged\u0022 Style=\u0022width: 100%;\u0022 Placeholder=\u0022Select project folder\u0022 /\u003E\n            \u003C/RadzenFormField\u003E\n\n            \u003CRadzenCard\u003E\n                \u003CRadzenStack Gap=\u00220.75rem\u0022\u003E\n                    \u003CRadzenText Text=\u0022Agent Mode Profiles\u0022 TextStyle=\u0022TextStyle.H5\u0022 /\u003E\n                    \u003CRadzenText Text=\u0022Each action below routes through a fixed profile before it runs.\u0022